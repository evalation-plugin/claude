#!/usr/bin/env node
"use strict";

const { lstatSync, readFileSync, realpathSync } = require("node:fs");
const { basename, dirname, isAbsolute, join, sep } = require("node:path");
const { pluginHome } = require("../lib/home.js");

let call;
try {
  call = JSON.parse(readFileSync(0, "utf8"));
} catch {
  process.exit(0);
}
if (!["Read", "Write"].includes(call.tool_name)) process.exit(0);
const path = String(call.tool_input?.file_path ?? "");
if (!isAbsolute(path) || path.split(/[\\/]/).includes("..")) process.exit(0);
let inside = false;
try {
  const drafts = realpathSync(join(pluginHome(), "drafts"));
  const exists = (() => {
    try {
      return Boolean(lstatSync(path));
    } catch {
      return false;
    }
  })();
  const at = exists ? realpathSync(path) : join(realpathSync(dirname(path)), basename(path));
  inside = at.startsWith(drafts + sep);
} catch {
  process.exit(0);
}
if (!inside) process.exit(0);
process.stdout.write(`${JSON.stringify({ hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: "allow",
  permissionDecisionReason: "a file in Evalation's own drafts folder" } })}\n`);
