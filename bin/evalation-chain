#!/usr/bin/env node
"use strict";

const { readFileSync, readdirSync } = require("node:fs");
const { basename } = require("node:path");

const SCRIPTS = new Set(readdirSync(__dirname).filter((one) => one.startsWith("evalation-")));

function segments(command) {
  const out = [[]];
  let word = null;
  let heredocs = [];
  const end = () => {
    if (word !== null) out.at(-1).push(word);
    word = null;
  };
  const split = () => {
    end();
    if (out.at(-1).length > 0) out.push([]);
  };
  for (let at = 0; at < command.length; at += 1) {
    const one = command[at];
    const next = command[at + 1];
    if (one === "\\") {
      word = (word ?? "") + (next ?? "");
      at += 1;
    } else if (one === "'") {
      const close = command.indexOf("'", at + 1);
      const stop = close < 0 ? command.length : close;
      word = (word ?? "") + command.slice(at + 1, stop);
      at = stop;
    } else if (one === "\"") {
      let text = "";
      for (at += 1; at < command.length && command[at] !== "\""; at += 1) {
        if (command[at] === "\\" && at + 1 < command.length) at += 1;
        text += command[at];
      }
      word = (word ?? "") + text;
    } else if (one === "<" && next === "<" && command[at + 2] !== "<") {
      end();
      const found = /^<<-?\s*(?:'([^']*)'|"([^"]*)"|\\?([^\s;&|<>()]+))/.exec(command.slice(at));
      if (found) {
        heredocs.push({ tag: found[1] ?? found[2] ?? found[3], tabs: found[0].startsWith("<<-") });
        at += found[0].length - 1;
      } else at += 1;
    } else if (one === "\n") {
      split();
      for (const { tag, tabs } of heredocs) {
        while (at < command.length) {
          const stop = command.indexOf("\n", at + 1);
          const line = command.slice(at + 1, stop < 0 ? command.length : stop);
          at = stop < 0 ? command.length : stop;
          if ((tabs ? line.replace(/^\t+/, "") : line) === tag) break;
        }
      }
      heredocs = [];
    } else if (one === ";" || one === "|") {
      split();
      if (next === one || (one === "|" && next === "&")) at += 1;
    } else if (one === "&") {
      if (next === "&") {
        split();
        at += 1;
      } else if (next === ">" || /[<>]$/.test(word ?? "")) {
        word = (word ?? "") + one;
      } else split();
    } else if (one === " " || one === "\t") {
      end();
    } else {
      word = (word ?? "") + one;
    }
  }
  end();
  return out.filter((one) => one.length > 0);
}

function script(words) {
  const at = words.findIndex((one) => !/^[A-Za-z_][A-Za-z0-9_]*=/.test(one) && !["(", "{", "!"].includes(one));
  const named = basename(words[at] ?? "") === "node" ? words[at + 1] : words[at];
  const name = basename(named ?? "");
  return SCRIPTS.has(name) ? name : null;
}

let call;
try {
  call = JSON.parse(readFileSync(0, "utf8"));
} catch {
  process.exit(0);
}
if (call.tool_name !== "Bash") process.exit(0);
const found = segments(String(call.tool_input?.command ?? "")).map(script).filter(Boolean);
if (found.length < 2) process.exit(0);
process.stderr.write(`This command joins ${found.join(", ")} in one call. Run each in its own call, with nothing joined to it.\n`);
process.exit(2);
