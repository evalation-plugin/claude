#!/usr/bin/env node
"use strict";

const { existsSync } = require("node:fs");
const { homedir } = require("node:os");
const { join } = require("node:path");
const { runScript } = require("../lib/script.js");
const { pluginHome } = require("../lib/home.js");
const { openBy, placesOf, pluginConversations, removal, reportsIn } = require("../lib/remove.js");
const store = require("./evalation-store");

const HOME = pluginHome();
const CLAUDE = process.env.CLAUDE_CONFIG_DIR || join(homedir(), ".claude");
const HERE = process.env.CLAUDE_CODE_SESSION_ID;

function fail(reason) {
  process.stderr.write(`${reason}\n`);
  process.exit(1);
}

const [verb, ...flags] = process.argv.slice(2);
if (verb === "folders") {
  const others = pluginConversations(CLAUDE, { here: HERE }).filter((one) => one.id !== HERE);
  process.stdout.write(`${JSON.stringify({
    home_exists: existsSync(HOME),
    reports: reportsIn(HOME),
    conversations: others.length,
    places: placesOf(others),
    open: others.filter((one) => one.live).length,
    open_by: openBy(CLAUDE, HERE),
  }, null, 2)}\n`);
} else if (verb === "run") {
  try {
    const done = removal({
      home: HOME,
      claude: CLAUDE,
      here: HERE,
      clearHistory: flags.includes("--clear-history"),
      revoke: () => {
        try {
          runScript("evalation-ask", ["/revoke", "{}"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
        } catch (thrown) {
          throw new Error(String(thrown.stderr || thrown.message).trim().split("\n")[0]);
        }
      },
      forget: (service, account) => store.forget(service, account),
      held: (service, account) => store.chosen().held(service, account),
    });
    process.stdout.write(`${JSON.stringify(done, null, 2)}\n`);
  } catch (thrown) {
    fail(`${thrown.reason === "unreachable" ? "unreachable" : "refused"}: nothing was removed (${thrown.message})`);
  }
} else {
  fail("usage: evalation-remove folders | run [--clear-history]");
}
