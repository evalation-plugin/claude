#!/usr/bin/env node
//   evalation-remove folders                 the folders this machine read, whose Claude Code history can be cleared
//   evalation-remove run [--clear-history]   revokes this installation, forgets its keys and deletes the evalation home
"use strict";

const { existsSync } = require("node:fs");
const { homedir } = require("node:os");
const { join } = require("node:path");
const { runScript } = require("../lib/script.js");
const { foldersRead, removal } = require("../lib/remove.js");
const store = require("./evalation-store");

const HOME = process.env.EVALATION_HOME || join(homedir(), ".evalation");
const CLAUDE = process.env.CLAUDE_CONFIG_DIR || join(homedir(), ".claude");

function fail(reason) {
  process.stderr.write(`${reason}\n`);
  process.exit(1);
}

const [verb, flag] = process.argv.slice(2);
if (verb === "folders") {
  const folders = foldersRead(HOME, process.cwd());
  process.stdout.write(`${JSON.stringify({
    home: HOME,
    home_exists: existsSync(HOME),
    folders,
    history: folders.filter((one) => existsSync(join(CLAUDE, "projects", one.replace(/[^A-Za-z0-9]/g, "-")))),
  }, null, 2)}\n`);
} else if (verb === "run") {
  try {
    const done = removal({
      home: HOME,
      claude: CLAUDE,
      cwd: process.cwd(),
      clearHistory: flag === "--clear-history",
      revoke: () => {
        try {
          runScript("evalation-ask", ["/revoke", "{}"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
        } catch (thrown) {
          throw new Error(String(thrown.stderr || thrown.message).trim().split("\n")[0]);
        }
      },
      forget: (service, account) => store.forget(service, account),
    });
    process.stdout.write(`${JSON.stringify(done, null, 2)}\n`);
  } catch (thrown) {
    fail(`not-removed: ${thrown.message}`);
  }
} else {
  fail("usage: evalation-remove folders | run [--clear-history]");
}
