#!/usr/bin/env node
"use strict";

const { runScript } = require("../lib/script.js");

function ask(path) {
  return JSON.parse(runScript("evalation-ask", [path, "{}"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }));
}

function main() {
  let pinned;
  try {
    pinned = ask("/pin");
  } catch (thrown) {
    const reason = String(thrown.stderr || thrown.message).trim();
    if (/no-settings:|no-installation:|no-key:|unreadable-key-reference:/.test(reason)) {
      process.stdout.write(`state: not-set-up\nseat: not set up on this machine yet\ndetail: ${reason}\n`);
    } else if (/unreachable:/.test(reason)) {
      process.stdout.write(`state: unreachable\nseat: unknown, because the server could not be reached\ndetail: ${reason}\n`);
    } else {
      process.stdout.write(`state: not-live\nseat: not live\nreason: ${reason}\n`);
    }
    return;
  }
  process.stdout.write(`state: live\nseat: live\nreleased revision: ${pinned.revision}\n`);
  try {
    process.stdout.write(`pack credits left: ${ask("/runs").remaining}\n`);
  } catch {
    return;
  }
}

main();
