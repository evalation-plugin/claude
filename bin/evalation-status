#!/usr/bin/env bash
# evalation-status - whether this installation's seat is live, asked rather than assumed.
#
# There is no local answer to this. The seat is proven by the server verifying a signature it holds
# the public half of, so the only honest way to report it is to sign an ask and see what comes back.
# Reading a cached answer would report a seat that lapsed an hour ago as live.
#
# It asks what this installation would pin, because that is the cheapest call that proves all three
# things at once: the key is right, the seat is live, and the server is reachable.
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"

if ANSWER="$("$DIR/evalation-ask" /pin '{}' 2>/tmp/evalation-status-said)"; then
  printf 'seat: live\n'
  printf 'released revision: %s\n' "$(printf '%s' "$ANSWER" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["revision"])')"
  exit 0
fi

printf 'seat: not live\n'
printf 'reason: %s\n' "$(cat /tmp/evalation-status-said)"
exit 1
