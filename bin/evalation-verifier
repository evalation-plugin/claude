#!/usr/bin/env node
// evalation-verifier - the command a second reading of the findings runs on, and where it is kept.
//
// The second reading is optional and runs on the customer's own model, so it is their spend to
// authorise. The run asks before it spends, and this is what the answer is kept in: the settings
// file beside the installation's keys, never the repository being read. `show` prints what is
// named, `set` names a command, `clear` removes it. The command is the whole configuration, so a
// customer can put a small hosted model, one running locally, or something of their own behind it.
"use strict";

const { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } = require("node:fs");
const { homedir } = require("node:os");
const { dirname, join } = require("node:path");

const SETTINGS = process.env.EVALATION_LOCAL || join(homedir(), ".evalation", "evalation.local");
/** What is offered where nothing is named: the harness in front of the person, on its smaller model. */
const DEFAULT = "claude -p --model claude-sonnet-5";

function fail(reason) {
  process.stderr.write(reason + "\n");
  process.exit(1);
}

function read() {
  if (!existsSync(SETTINGS)) return {};
  try {
    return JSON.parse(readFileSync(SETTINGS, "utf8"));
  } catch (thrown) {
    fail(`settings-unreadable: ${SETTINGS} is not JSON (${thrown.message})`);
  }
}

/** Written whole and renamed into place, so a crash mid-write leaves the settings as they were. */
function write(settings) {
  mkdirSync(dirname(SETTINGS), { recursive: true });
  const draft = `${SETTINGS}.writing`;
  writeFileSync(draft, JSON.stringify(settings, null, 2) + "\n");
  renameSync(draft, SETTINGS);
}

function show() {
  const settings = read();
  process.stdout.write(
    JSON.stringify({ verifier: settings.verifier ?? null, default: DEFAULT, at: SETTINGS }, null, 2) + "\n",
  );
}

const [verb, ...rest] = process.argv.slice(2);
switch (verb ?? "show") {
  case "show":
    show();
    break;
  case "set": {
    const command = rest.join(" ").trim();
    if (command.length === 0) fail("usage: evalation-verifier set <command>");
    write({ ...read(), verifier: command });
    show();
    break;
  }
  case "clear": {
    const { verifier: _gone, ...kept } = read();
    write(kept);
    show();
    break;
  }
  default:
    fail("usage: evalation-verifier [show|set <command>|clear]");
}
