#!/usr/bin/env node
// evalation-run - starts a findings run, and is the only thing that can.
//
// It does three things and then stops, because the reading itself is not this script's job. It
// establishes that this run may not write, asks the server for the methodology and the entries, and
// opens both. What comes back is handed to whatever is doing the reading.
//
// The order is the whole of it. The write bound is answered first, before a byte of the tree is read
// and before the server is asked for anything, because a run that turned out to hold write after it
// had read a repository has already had the access it must not have. Then the server, which is where
// the run is counted: serving is the count and the gate, so nothing here decides whether a run
// happened and nothing here could decline to say so.
//
// It writes nothing. The findings file is written by evalation-findings once there are findings to
// put in it, and the tree being read is never touched at all.
"use strict";

const { randomBytes } = require("node:crypto");
const { execFileSync } = require("node:child_process");
const { existsSync, statSync } = require("node:fs");
const { join } = require("node:path");

const here = __dirname;

function fail(reason) {
  process.stderr.write(reason + "\n");
  process.exit(1);
}

function ask(path, body) {
  try {
    return JSON.parse(
      execFileSync(join(here, "evalation-ask"), [path, JSON.stringify(body)], {
        encoding: "utf8",
        stdio: ["ignore", "pipe", "pipe"],
      }),
    );
  } catch (thrown) {
    fail(`the server refused: ${(thrown.stderr || thrown.message).toString().trim()}`);
  }
}

/**
 * The entries the pack itself settled, answered without a file being opened.
 *
 * An entry marked as the organisation's is one no repository could ever evidence: a screening duty, a
 * physical control, a contract with a supplier. That is a fact about the clause rather than about any
 * tree, so it is decided once when the pack is authored and reading a repository to rediscover it
 * would spend the reading to learn nothing. Whole frameworks are mostly this.
 *
 * They are answered rather than dropped, because an entry with nothing against it is a gap in the
 * assessment rather than a clause that passed, and each carries `from: authored` so a person reading
 * the report can tell this apart from somebody having looked.
 */
function settled(packs) {
  const held = [];
  for (const pack of packs) {
    for (const entry of pack.body?.entries ?? []) {
      if (entry.bears_on !== "organisation") continue;
      held.push({
        pack: pack.pack,
        entry: entry.identifier,
        status: "org-level",
        from: "authored",
        because:
          `${entry.title}: no repository can evidence this, so it was answered from the pack rather ` +
          "than by reading the tree",
        justification: entry.justification,
      });
    }
  }
  return held;
}

/** What is left for the reading, which is what the run actually costs. */
function reading(packs) {
  return packs.map((pack) => ({
    pack: pack.pack,
    entries: (pack.body?.entries ?? []).filter((one) => one.bears_on !== "organisation"),
  }));
}

function main() {
  const where = process.argv[2] || process.cwd();
  const wanted = process.argv.slice(3).filter((one) => one.trim() !== "");

  if (!existsSync(where)) fail(`no-such-target: ${where}`);

  // The target is a directory and nothing else, per section 1: the run reads the local clone, issues
  // no call to the host it came from and holds no credential for it, so there is nothing to prove
  // read-only against and nothing the run could write to. What it reads crosses evalation-read's
  // fence, which is the perimeter.
  try {
    if (!statSync(where).isDirectory()) fail(`no-such-target: ${where} is not a directory`);
  } catch (thrown) {
    if (String(thrown.message).startsWith("no-such-target")) throw thrown;
    fail(`no-such-target: ${where} cannot be read`);
  }

  // What to assess against: named on the command line where somebody named some, and the recorded
  // selection otherwise. Per run rather than per installation, because a consultant assesses one
  // client's repository against one set of obligations and the next client's against another.
  let packs = wanted;
  if (packs.length === 0) {
    try {
      const shown = JSON.parse(
        execFileSync(join(here, "evalation-packs"), ["show"], {
          encoding: "utf8",
          stdio: ["ignore", "pipe", "ignore"],
        }),
      );
      packs = shown.packs ?? [];
    } catch {
      packs = [];
    }
  }
  if (packs.length === 0) {
    fail(
      "nothing-selected: this run was given no packs and none are recorded.\n" +
        "Run /ev-packs to choose what to be assessed against, or name them after the target.",
    );
  }

  // Named here, before the server is asked, so a retry after our own transport failed is the same run
  // rather than a second one to be charged for.
  const run = `run-${randomBytes(6).toString("hex")}`;

  const served = ask("/run", { run, packs });

  // What the reading is given. The tree is named rather than its contents, because nothing about the
  // repository has been read yet and nothing here will read it.
  process.stdout.write(
    JSON.stringify(
      {
        run,
        at: new Date().toISOString(),
        revision: served.revision,
        remaining: served.remaining,
        already: served.already === true,
        target: admitted.target,
        admitted: admitted.because,
        skill: served.skill,
        packs: served.packs,
        // How this run's findings become a score, where the packs it selected are scored at all. It
        // is served rather than shipped because the formula and the weights are the methodology, so
        // it lives here for as long as this run does and is never written down.
        rubrics: served.rubrics ?? [],
        // Answered here rather than by the reading, because the pack settled them when it was
        // authored: no repository could evidence a personnel duty or a physical control, so opening
        // a tree to discover that wastes the reading and tells nobody anything. They are still
        // answered, because an entry with nothing against it is a gap in the assessment.
        answered: settled(served.packs),
        to_read: reading(served.packs),
      },
      null,
      2,
    ) + "\n",
  );
}

main();
