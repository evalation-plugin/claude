#!/usr/bin/env node
// evalation-run - starts a findings run, and is the only thing that can.
//
// It does three things and then stops, because the reading itself is not this script's job. It
// establishes that this run may not write, asks the server for the methodology and the entries, and
// opens both. What comes back is handed to whatever is doing the reading.
//
// The order is the whole of it. The write bound is answered first, before a byte of the tree is read
// and before the server is asked for anything, because a run that turned out to hold write after it
// had read a repository has already had the access it must not have. Then the server, which is where
// the run is counted: serving is the count and the gate, so nothing here decides whether a run
// happened and nothing here could decline to say so.
//
// It writes nothing. The findings file is written by evalation-findings once there are findings to
// put in it, and the tree being read is never touched at all.
"use strict";

const { randomBytes } = require("node:crypto");
const { execFileSync } = require("node:child_process");
const { existsSync, mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } = require("node:fs");
const { basename, dirname, join, relative, resolve, sep } = require("node:path");
const { filesOf } = require("../lib/tree.js");
const { pluginHome } = require("../lib/home.js");
const { extended, problems } = require("../lib/questions.js");
const { newestFor, phasesRead } = require("../lib/scans.js");
const { runScript } = require("../lib/script.js");
const { choose, solutionOf } = require("../lib/solution.js");
const { answered } = require("../lib/answer.js");


function fail(reason) {
  process.stderr.write(reason + "\n");
  process.exit(1);
}

function askedOnce(path, body) {
  try {
    return { answer: JSON.parse(runScript("evalation-ask", [path, JSON.stringify(body)], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] })) };
  } catch (thrown) {
    return { refused: String(thrown.stderr || thrown.message).trim() };
  }
}

const unanswered = (said) => /^unreachable:/.test(said) || /^refused 5\d\d:/.test(said);

function ask(path, body) {
  let got = askedOnce(path, body);
  for (let again = 0; again < 2 && got.refused !== undefined && unanswered(got.refused); again += 1) {
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 1000);
    got = askedOnce(path, body);
  }
  return got;
}

const spoken = (name, values) => require("../lib/run-say.js").line(name, values);

function faulted(detail, after = false, cause = after ? "ev-run.fault-after" : "ev-run.fault-before") {
  fail(require("../lib/run-say.js").fault(spoken(cause), detail));
}

const CAUSES = {
  "evalation-questions": "ev-run.fault-sets", "evalation-packs": "ev-run.fault-before", "evalation-status": "ev-run.fault-before",
  "evalation-scan": "ev-run.fault-scan", "evalation-findings": "ev-run.fault-findings", "evalation-verify": "ev-run.fault-verify",
  "evalation-score": "ev-run.fault-score", "evalation-report": "ev-run.fault-reports", "evalation-deliver": "ev-run.fault-reports",
};

function observedIn(said) {
  const body = said.replace(/^refused \d+:\s*/, "");
  try {
    return (JSON.parse(body).refusals ?? []).map((one) => one.observed).join(" ");
  } catch {
    return body.split(" | ")[0];
  }
}

const approval = (said) => {
  const { approvalOf, lineFor, RUN } = require("../lib/approval.js");
  const found = approvalOf(said);
  return found ? lineFor(RUN[found.kind], found) : null;
};

function refusal(said) {
  if (approval(said)) return { spent: false, said: approval(said) };
  const credit = observedIn(said).match(/this run asks for (\d+) packs? and (?:no pack credits are left|([\d.]+) pack credits? (?:is|are) left)/);
  if (/^refused 402:/.test(said) && credit) {
    const count = Number(credit[1]);
    if (count === 1) return { spent: false, said: spoken("ev-run.start-short-one") };
    return { spent: false, said: credit[2] ? spoken("ev-run.start-short", { count, left: credit[2] }) : spoken("ev-run.start-short-none", { count }) };
  }
  if (/^refused 402:/.test(said)) return { spent: false, said: spoken("ev-run.start-ended") };
  if (/^refused 40[13]:/.test(said)) return { spent: false, said: spoken("ev-run.start-not-accepted") };
  if (SIGNED_OUT.test(said)) return { spent: false, said: spoken(NEVER_SET_UP.test(said) ? "ev-run.start-signed-out" : "ev-run.start-damaged") };
  return { spent: null, said: spoken("ev-run.start-unclear") };
}

const SIGNED_OUT = /^(no-settings|no-key|no-installation|unreadable-key-reference|key-wrong-size|settings-unreadable):/;
const NEVER_SET_UP = /^no-settings:/;

const reasonOf = (thrown) => String(thrown?.stderr ?? "").trim().split("\n")[0]
  .replace(/^(unreachable|clock|refused|not-set-up|damaged|unreadable|other): /, "");

function unlisted(thrown) {
  const said = reasonOf(thrown);
  if (approval(said)) return approval(said);
  if (SIGNED_OUT.test(said)) return spoken(NEVER_SET_UP.test(said) ? "ev-run.signed-out" : "ev-run.damaged");
  if (/^refused 402:/.test(said)) return spoken("ev-run.ended");
  if (/^refused 40[13]:/.test(said)) return spoken("ev-run.not-accepted");
  if (/^unreachable:/.test(said)) return spoken("ev-run.unreachable");
  return spoken("ev-run.server-trouble");
}

function pendingAt() {
  return join(pluginHome(), "runs", "pending.json");
}

function pending() {
  if (!existsSync(pendingAt())) return {};
  return JSON.parse(readFileSync(pendingAt(), "utf8"));
}

function keepPending(key, run) {
  const held = pending();
  if (run) held[key] = run;
  else delete held[key];
  mkdirSync(dirname(pendingAt()), { recursive: true, mode: 0o700 });
  writeFileSync(pendingAt(), `${JSON.stringify(held, null, 2)}\n`);
}

function kept(document) {
  const folder = join(pluginHome(), "runs", document.run);
  mkdirSync(folder, { recursive: true, mode: 0o700 });
  const written = join(folder, "run.json");
  writeFileSync(written, `${JSON.stringify(document, null, 2)}\n`);
  const rubrics = (document.rubrics ?? []).map((one) => {
    const body = one?.body?.id ? one.body : one;
    const pack = String(body.pack ?? one.rubric ?? "rubric").replace(/[^A-Za-z0-9._-]+/g, "-");
    const at = join(folder, `rubric-${pack}.json`);
    writeFileSync(at, `${JSON.stringify(body, null, 2)}\n`);
    return { pack, written: at };
  });
  return { written, rubrics };
}

/**
 * The entries the pack itself settled, answered without a file being opened.
 *
 * An entry marked as the organisation's is one no repository could ever evidence: a screening duty, a
 * physical control, a contract with a supplier. That is a fact about the clause rather than about any
 * tree, so it is decided once when the pack is authored and reading a repository to rediscover it
 * would spend the reading to learn nothing. Whole frameworks are mostly this.
 *
 * They are answered rather than dropped, because an entry with nothing against it is a gap in the
 * assessment rather than a clause that passed, and each carries `from: authored` so a person reading
 * the report can tell this apart from somebody having looked.
 */
function settled(packs) {
  const held = [];
  for (const pack of packs) {
    for (const entry of pack.body?.entries ?? []) {
      // A clause the standard still prints and nobody can enforce, such as one a court set aside, is
      // kept so a reader sees it was considered, and it applies to no repository while that holds.
      if (entry.in_force === false || entry.applies === false) {
        held.push({
          pack: pack.pack,
          entry: entry.identifier,
          status: "not-applicable",
          from: "authored",
          because: entry.in_force === false ? `${entry.title} is not in force, so the pack answers it.` : `${entry.title} places no duty a repository could meet, so the pack answers it.`,
          justification: entry.justification,
        });
        continue;
      }
      if (entry.bears_on !== "organisation") continue;
      held.push({
        pack: pack.pack,
        entry: entry.identifier,
        status: "org-level",
        from: "authored",
        because: entry.written_by === "customer"
          ? `${entry.title} is held in the organisation's own records, which a repository does not keep, so it is answered as the organisation's.`
          : `${entry.title} is about how the organisation runs, which a repository does not record, ` +
            "so the pack answers it.",
        justification: entry.justification,
        ...(entry.raised_by?.length ? { raised_by: entry.raised_by } : {}),
      });
    }
  }
  return held;
}

/** What is left for the reading, which is what the run actually costs. */
function reading(packs) {
  return packs.map((pack) => ({
    pack: pack.pack,
    entries: (pack.body?.entries ?? []).filter((one) => one.bears_on !== "organisation" && one.in_force !== false && one.applies !== false),
  }));
}

/**
 * Which of the selected packs read the scan: a concern set, whose findings name what a scanner found,
 * and a standard with an item only the scan settles. A run selecting none of them neither offers the
 * scanners nor runs them, since nothing it reports would carry a scan result.
 */
function scanFor(packs) {
  const as = (pack) => ({ kind: pack.body?.kind, entries: pack.body?.entries ?? [] });
  const by = packs.filter((pack) => phasesRead([as(pack)]).length > 0);
  const phases = phasesRead(packs.map(as));
  const asksDomains = packs.some((pack) => (pack.body?.entries ?? []).some((entry) => (entry.raised_by ?? []).includes("history:outside-contributors")));
  return { wanted: phases.length > 0, phases, for: by.map((pack) => pack.body?.title ?? pack.pack), asks_domains: asksDomains };
}

/** What a command says, or nothing where it says nothing or is not there. Never a throw. */
function quietly(command, args, cwd) {
  try {
    return execFileSync(command, args, { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim() || null;
  } catch {
    return null;
  }
}

/**
 * What is being read, named for the report. A checkout with a remote is named by that remote, and
 * a directory with none by its path, per section 1. Read from the clone's own configuration and
 * never by asking the host: the run reaches no host.
 */
function target(where) {
  const solution = solutionOf(where);
  if (solution) {
    return {
      kind: "solution",
      repository: solution.name ?? basename(resolve(where)),
      name: solution.name ?? basename(resolve(where)),
      path: solution.root,
      repositories: solution.repositories,
      left_out: solution.left_out,
    };
  }
  const remote = quietly("git", ["remote", "get-url", "origin"], where);
  const head = quietly("git", ["rev-parse", "HEAD"], where);
  const inside = quietly("git", ["rev-parse", "--is-inside-work-tree"], where) === "true";
  const named = remote ? remote.replace(/^.*[:/]{1}([^/:]+\/[^/]+?)(?:\.git)?$/, "$1") : basename(resolve(where));
  return { kind: remote ? "repository" : "directory", repository: named, head, remote, inside };
}

/**
 * Which branch the tree has checked out against the repository's main, from the clone alone. A run
 * assesses main, so a person is warned before it reads anything else. Null where the target is no
 * git checkout or names no main, since there is nothing to compare. A null branch is a commit on no
 * branch.
 */
function branchOf(where) {
  if (quietly("git", ["rev-parse", "--is-inside-work-tree"], where) !== "true") return null;
  const origin = quietly("git", ["symbolic-ref", "--short", "refs/remotes/origin/HEAD"], where);
  const main = origin
    ? origin.replace(/^origin\//, "")
    : ["main", "master"].find((one) => quietly("git", ["rev-parse", "--verify", "--quiet", `refs/heads/${one}`], where));
  if (!main) return null;
  const branch = quietly("git", ["symbolic-ref", "--short", "--quiet", "HEAD"], where);
  // When the newest commit on disk was made. A clone nobody pulled reads as a project that stopped.
  const newest = quietly("git", ["log", "-1", "--format=%cI"], where) || null;
  return { branch, main, on_main: branch === main, newest };
}

function described(solution) {
  if (!solution) return null;
  return {
    ...solution,
    repositories: solution.repositories.map((one) => {
      if (one.vcs === "git") return one;
      const files = filesOf(join(solution.root, one.folder)).map((file) => relative(join(solution.root, one.folder), file).split(sep).join("/")).sort();
      return { ...one, files: files.length, first: files[0] ?? null };
    }),
  };
}

function lastRun(where) {
  const folder = join(pluginHome(), "findings");
  const named = target(where).repository;
  let best = null;
  for (const name of existsSync(folder) ? readdirSync(folder).filter((one) => one.endsWith(".json")) : []) {
    let one;
    try {
      one = JSON.parse(readFileSync(join(folder, name), "utf8"));
    } catch {
      // empty-catch:allow: a file that will not parse is no earlier run, and the newest that does is wanted.
      continue;
    }
    if (one.target?.repository !== named) continue;
    if (!best || String(one.at) > String(best.document.at)) best = { written: join(folder, name), document: one };
  }
  return best;
}

function jsonOf(script, args) {
  try {
    return JSON.parse(runScript(script, args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }));
  } catch (thrown) {
    const said = reasonOf(thrown);
    if (script === "evalation-packs" || SIGNED_OUT.test(said) || /^(refused 40[123]|unreachable):/.test(said)) fail(unlisted(thrown));
    faulted(`${script} ${args.join(" ")} failed: ${String(thrown.stderr || thrown.message).trim()}`, false, CAUSES[script]);
  }
}

function credits() {
  const said = runScript("evalation-status", [], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
  const left = said.match(/^pack credits left: (\S+)$/m);
  if (left) return left[1];
  const state = said.match(/^state: (\S+)$/m)?.[1];
  const reason = said.match(/^reason: (\S+)$/m)?.[1];
  const owner = said.match(/^owner: (\S+)$/m)?.[1];
  const { RUN, lineFor, nameOf } = require("../lib/approval.js");
  const organisation = nameOf(said.match(/^organisation: (.+)$/m)?.[1]);
  if (Object.hasOwn(RUN, reason ?? "") && owner) fail(lineFor(RUN[reason], { owner, organisation }));
  if (state === "not-set-up") fail(spoken(/^sign-in: damaged$/m.test(said) ? "ev-run.damaged" : "ev-run.signed-out"));
  if (state === "unreachable") fail(spoken("ev-run.unreachable"));
  if (reason === "ended") fail(spoken("ev-run.ended"));
  if (reason === "refused" || reason === "clock") fail(spoken("ev-run.not-accepted"));
  return fail(spoken("ev-run.server-trouble"));
}

function saying(part, args) {
  const words = require("../lib/run-say.js");
  const at = () => args[0] || process.cwd();
  const solution = () => described(solutionOf(at(), { asChosen: false }));
  const chosen = () => solutionOf(at());
  const facts = () => branchOf(at()) ?? faulted(`${at()} is no git checkout with a main branch`);
  const titles = () => jsonOf("evalation-packs", ["titles"]);
  const sets = () => jsonOf("evalation-questions", ["list"]).sets ?? [];
  const usual = () => jsonOf("evalation-packs", ["show"]).packs ?? [];
  const read = () => JSON.parse(readFileSync(at(), "utf8"));
  const parts = {
    found: () => words.found(solution()),
    pick: () => words.pick(solution()),
    evidence: () => words.evidence(solution()),
    name: () => words.named(chosen()),
    branches: () => words.branches(chosen()),
    copies: () => words.copies(chosen()),
    "off-main": () => words.offMain(facts()),
    branch: () => words.branchAsk(facts()),
    stale: () => words.staleSaid(facts()),
    packs: () => words.packs({ repository: target(at()).repository, credits: credits(), usual: usual(), titles: titles() }),
    usual: () => words.usualAsk({ usual: usual(), titles: titles() }),
    all: () => words.all({ titles: titles() }),
    sets: () => words.setsFor({ pack: args[0], titles: titles(), sets: sets() }),
    "pick-sets": () => words.pickSets({ pack: args[0], titles: titles(), sets: sets() }),
    short: () => words.short(credits(), args[0]),
    reading: () => words.reading(read()),
    tally: () => words.tally(...args.slice(0, 4)),
    done: () => words.done(read(), args[1]),
    folder: () => words.folder(read(), args[1]),
  };
  if (!parts[part]) faulted(`usage: evalation-run --say <${Object.keys(parts).join("|")}> [argument ...]`);
  let said;
  try {
    said = parts[part]();
  } catch (thrown) {
    faulted(`--say ${part}: ${thrown?.message ?? thrown}`, ["reading", "tally", "done", "folder"].includes(part));
  }
  if (said) process.stdout.write(`${said}\n`);
}

function main() {
  if (process.argv[2] === "--say") {
    saying(process.argv[3], process.argv.slice(4));
    return;
  }
  if (process.argv[2] === "--fault") {
    const [command, ...detail] = process.argv.slice(3);
    process.stdout.write(`${require("../lib/run-say.js").fault(spoken(CAUSES[command] ?? "ev-run.fault-after"), `${command ?? ""}: ${detail.join(" ")}`)}\n`);
    return;
  }
  if (process.argv[2] === "--branch") {
    const at = process.argv[3] || process.cwd();
    process.stdout.write(JSON.stringify({
      repository: target(at).repository,
      folder: resolve(at),
      ...(branchOf(at) ?? { branch: null, main: null, on_main: null }),
      solution: described(solutionOf(at, { asChosen: false })),
    }) + "\n");
    return;
  }
  if (process.argv[2] === "--titles") {
    try {
      process.stdout.write(runScript("evalation-packs", ["titles"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }));
    } catch (thrown) {
      fail(unlisted(thrown));
    }
    return;
  }
  if (process.argv[2] === "--last") {
    const found = lastRun(process.argv[3] || process.cwd());
    if (!found) fail(spoken("ev-run.no-last"));
    process.stdout.write(`${JSON.stringify({ written: found.written, at: found.document.at,
      packs: (found.document.packs ?? []).map((one) => ({ pack: one.pack, kind: one.kind, title: one.title })) })}\n`);
    return;
  }
  if (process.argv[2] === "--scan") {
    const named = process.argv.slice(3).filter((one) => one.trim() !== "");
    if (named.length === 0) {
      process.stdout.write(`${JSON.stringify(scanFor([]))}\n`);
      return;
    }
    let listed;
    try {
      listed = JSON.parse(runScript("evalation-packs", ["list"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }));
    } catch (thrown) {
      fail(unlisted(thrown));
    }
    process.stdout.write(`${JSON.stringify(scanFor((listed.packs ?? []).filter((one) => named.includes(one.pack))))}\n`);
    return;
  }
  if (process.argv[2] === "--solution") {
    const at = process.argv[3];
    const rest = process.argv.slice(4);
    const name = rest.includes("--name") ? rest[rest.indexOf("--name") + 1] : undefined;
    const leave = rest.flatMap((one, index) => (rest[index - 1] === "--leave" ? [one] : []));
    answered([name, ...leave]);
    if (!at || !solutionOf(at)) fail(spoken("ev-run.no-solution"));
    choose(at, { name, leave });
    process.stdout.write(JSON.stringify(solutionOf(at)) + "\n");
    return;
  }

  const where = process.argv[2] || process.cwd();
  // Questions the customer brings, each a set file the session drafted and the customer approved.
  const args = process.argv.slice(3);
  const sets = [];
  const wanted = [];
  for (let at = 0; at < args.length; at += 1) {
    if (args[at] === "--questions") sets.push(setFrom(args[++at]));
    else wanted.push(args[at]);
  }
  answered(wanted);

  if (!existsSync(where)) fail(spoken("ev-run.no-folder", { folder: where }));

  // The target is a directory and nothing else, per section 1: the run reads the local clone, issues
  // no call to the host it came from and holds no credential for it, so there is nothing to prove
  // read-only against and nothing the run could write to. What it reads crosses evalation-read's
  // fence, which is the perimeter.
  let folder = false;
  try {
    folder = statSync(where).isDirectory();
  } catch {
    fail(spoken("ev-run.unopened", { folder: where }));
  }
  if (!folder) fail(spoken("ev-run.a-file", { folder: where }));

  // What to assess against: named on the command line where somebody named some, and the recorded
  // selection otherwise. Per run rather than per installation, because a consultant assesses one
  // client's repository against one set of obligations and the next client's against another.
  const alone = sets.find((one) => one.pack === "custom");
  if (alone) fail(spoken("ev-run.set-no-pack", { set: alone.name }));
  let packs = wanted;
  if (packs.length === 0) {
    try {
      const shown = JSON.parse(
        runScript("evalation-packs", ["show"], {
          encoding: "utf8",
          stdio: ["ignore", "pipe", "ignore"],
        }),
      );
      packs = shown.packs ?? [];
    } catch {
      packs = [];
    }
  }
  if (packs.length === 0) fail(spoken("ev-run.no-packs"));
  if (sets.length > 0) {
    let catalogue;
    try {
      catalogue = JSON.parse(runScript("evalation-packs", ["titles"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }));
    } catch (thrown) {
      fail(unlisted(thrown));
    }
    for (const one of sets) {
      const held = catalogue.find((each) => each.pack === one.pack);
      if (!held?.title) fail(spoken("ev-run.set-unknown-pack", { set: one.name }));
      if (!packs.includes(one.pack)) fail(spoken("ev-run.set-unread-pack", { set: one.name, pack: held.title }));
      if (!held.extensible) fail(spoken("ev-run.set-closed-pack", { set: one.name, pack: held.title }));
    }
  }

  // Named here, before the server is asked, so a retry after our own transport failed is the same run
  // rather than a second one to be charged for.
  const key = JSON.stringify([resolve(where), [...packs].sort(), sets.map((one) => `${one.pack}/${one.name}`).sort()]);
  const run = pending()[key] ?? `run-${randomBytes(6).toString("hex")}`;
  keepPending(key, run);

  const got = ask("/run", { run, packs });
  if (got.refused !== undefined) {
    const said = refusal(got.refused);
    if (said.spent === false) keepPending(key, null);
    fail(said.said);
  }
  counted = true;
  const document = { ...served({ ...got.answer, run }, sets, where), target: target(where) };
  const { written, rubrics } = kept(document);
  keepPending(key, null);
  process.stdout.write(`${JSON.stringify({ written, rubrics, remaining: document.remaining, already: document.already, scan: document.scan }, null, 2)}\n`);
}

function setFrom(file) {
  let set;
  try {
    set = JSON.parse(readFileSync(file, "utf8"));
  } catch {
    fail(spoken("ev-run.set-unreadable"));
  }
  if (problems(set).length > 0) fail(set?.name ? spoken("ev-run.set-broken", { set: set.name }) : spoken("ev-run.set-broken-unnamed"));
  return set;
}

function served(answer, sets = [], where = null) {
  let packs = answer.packs ?? [];
  for (const one of sets) {
    packs = packs.map((pack) => (pack.pack === one.pack ? extended(pack, one) : pack));
  }
  return {
    run: answer.run,
    at: new Date().toISOString(),
    revision: answer.revision,
    remaining: answer.remaining,
    already: answer.already === true,
    admitted: "a directory on this machine, read through the fence and reaching no host",
    skill: answer.skill,
    packs,
    // How this run's findings become a score, where the packs it selected are scored at all. It is
    // served rather than shipped because the formula and the weights are the methodology, so it lives
    // here for as long as this run does and is never written down.
    rubrics: answer.rubrics ?? [],
    // Answered here rather than by the reading, because the pack settled them when it was authored:
    // no repository could evidence a personnel duty or a physical control, so opening a tree to
    // discover that wastes the reading and tells nobody anything. They are still answered, because an
    // entry with nothing against it is a gap in the assessment.
    answered: settled(packs),
    to_read: reading(packs),
    scan: { ...scanFor(packs), follows: where ? newestFor(where)?.document.at ?? null : null },
  };
}

module.exports = { target, branchOf, scanFor, served };

let counted = false;

if (require.main === module) {
  try {
    main();
  } catch (thrown) {
    faulted(thrown?.stack ?? thrown, counted);
  }
}
