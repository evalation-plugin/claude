#!/usr/bin/env node
"use strict";

const { existsSync, mkdirSync, readFileSync, writeFileSync } = require("node:fs");
const { homedir } = require("node:os");
const { join } = require("node:path");
const { runScript } = require("../lib/script.js");
const { extensible } = require("../lib/questions.js");

const HOME = process.env.EVALATION_HOME || join(homedir(), ".evalation");
const SELECTION = join(HOME, "packs.json");

function usage() {
  process.stderr.write("usage: evalation-packs [show|list|titles|set <pack> [<pack>...]]\n");
  process.exit(2);
}

const byTitle = (a, b) => (a.toLowerCase() < b.toLowerCase() ? -1 : a.toLowerCase() > b.toLowerCase() ? 1 : 0);

function list() {
  let served;
  try {
    served = JSON.parse(runScript("evalation-ask", ["/packs", "{}"], { encoding: "utf8", stdio: ["ignore", "pipe", "inherit"] }));
  } catch {
    process.exit(1);
  }
  served.packs = [...(served.packs ?? [])].sort((a, b) => byTitle(a.body?.title ?? a.pack, b.body?.title ?? b.pack));
  return served;
}

function main() {
  const [what = "show", ...rest] = process.argv.slice(2);
  if (what === "show") {
    process.stdout.write(existsSync(SELECTION) ? readFileSync(SELECTION, "utf8") : '{"packs":[]}\n');
  } else if (what === "list") {
    process.stdout.write(`${JSON.stringify(list(), null, 2)}\n`);
  } else if (what === "titles") {
    process.stdout.write(`${JSON.stringify(list().packs.map((one) => ({ pack: one.pack, title: one.body?.title ?? null, extensible: extensible(one.body) })))}\n`);
  } else if (what === "set") {
    if (rest.length === 0) usage();
    const body = `${JSON.stringify({ packs: rest, chosen: new Date().toISOString().replace(/\.\d{3}Z$/, "Z") }, null, 2)}\n`;
    mkdirSync(HOME, { recursive: true });
    writeFileSync(SELECTION, body);
    process.stdout.write(body);
  } else {
    usage();
  }
}

main();
