#!/usr/bin/env node
"use strict";

const { existsSync, mkdirSync, readFileSync, writeFileSync } = require("node:fs");
const { pluginHome } = require("../lib/home.js");
const { join } = require("node:path");
const { runScript } = require("../lib/script.js");
const { extensible } = require("../lib/questions.js");
const { entries, say } = require("../lib/say.js");
const { answered } = require("../lib/answer.js");
const { held: broken } = require("../lib/prose.js");

const HOME = pluginHome();
const SELECTION = join(HOME, "packs.json");

function usage() {
  process.stderr.write("usage: evalation-packs [show|list|titles|chosen|chooser|set <title> [<title>...]]\n");
  process.exit(2);
}

const SUMMARIES = {
  "cyber-insurance": "ev-packs.summary-cyber-insurance",
  dora: "ev-packs.summary-dora",
  "eu-ai-act": "ev-packs.summary-eu-ai-act",
  gdpr: "ev-packs.summary-gdpr",
  hardening: "ev-packs.summary-hardening",
  hipaa: "ev-packs.summary-hipaa",
  "investment-diligence": "ev-packs.summary-investment-diligence",
  iso27001: "ev-packs.summary-iso27001",
  iso42001: "ev-packs.summary-iso42001",
  "nist-ai-rmf": "ev-packs.summary-nist-ai-rmf",
  "nist-csf": "ev-packs.summary-nist-csf",
  "nist-ssdf": "ev-packs.summary-nist-ssdf",
  "nz-privacy-act": "ev-packs.summary-nz-privacy-act",
  "owasp-agentic-threats": "ev-packs.summary-owasp-agentic-threats",
  "owasp-agentic-top-ten": "ev-packs.summary-owasp-agentic-top-ten",
  "owasp-asvs": "ev-packs.summary-owasp-asvs",
  "pci-dss": "ev-packs.summary-pci-dss",
  soc2: "ev-packs.summary-soc2",
};

const byTitle = (a, b) => (a.toLowerCase() < b.toLowerCase() ? -1 : a.toLowerCase() > b.toLowerCase() ? 1 : 0);

function failed(word, detail) {
  process.stderr.write(`${word}: ${String(detail).trim().split("\n")[0]}\n`);
  process.exit(1);
}

function askFailure(said) {
  if (/^unreachable:/.test(said) || /^refused 503:/.test(said)) return "unreachable";
  if (/^refused 40[13]:/.test(said) && /seconds from now|outside the window/.test(said)) return "clock";
  if (/^refused /.test(said)) return "refused";
  if (/^no-settings:/.test(said)) return "not-set-up";
  if (/^(settings-unreadable|no-installation|no-key|unreadable-key-reference|key-wrong-size):/.test(said)) return "damaged";
  if (/^will-not-open:/.test(said)) return "unreadable";
  return "other";
}

function list() {
  let said;
  try {
    said = runScript("evalation-ask", ["/packs", "{}"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
  } catch (thrown) {
    const reason = String(thrown.stderr || thrown.message).trim();
    failed(askFailure(reason), reason);
  }
  let served;
  try {
    served = JSON.parse(said);
  } catch (thrown) {
    failed("unreadable", thrown.message);
  }
  served.packs = [...(served.packs ?? [])].sort((a, b) => byTitle(a.body?.title ?? a.pack, b.body?.title ?? b.pack));
  return served;
}

function titled(packs) {
  const questions = Math.ceil(packs.length / 4);
  const questionOf = (at) => {
    const size = Math.floor(packs.length / questions);
    const larger = packs.length % questions;
    return at < larger * (size + 1) ? Math.floor(at / (size + 1)) + 1 : larger + Math.floor((at - larger * (size + 1)) / size) + 1;
  };
  const held = entries();
  const ours = (pack) => (SUMMARIES[pack] ? say(held, SUMMARIES[pack]) : null);
  return packs.map((one, at) => ({ pack: one.pack, title: one.body?.title ?? null, summary: (one.body?.summary && broken(one.body.summary).length === 0 ? one.body.summary : null) ?? ours(one.pack), extensible: extensible(one.body), question: questionOf(at) }));
}

function selected() {
  if (!existsSync(SELECTION)) return [];
  try {
    const packs = JSON.parse(readFileSync(SELECTION, "utf8")).packs ?? [];
    return Array.isArray(packs) ? packs : null;
  } catch {
    return null;
  }
}

const joined = (items) => (items.length < 2 ? items.join("") : `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`);

function chosen() {
  const offered = list().packs;
  const held = entries();
  const picked = selected();
  if (!picked) failed("choice-unreadable", SELECTION);
  const found = picked.map((pack) => offered.find((one) => one.pack === pack)).filter(Boolean);
  const titles = [...found.map((one) => one.body?.title ?? one.pack).sort(byTitle), ...picked.slice(found.length).map(() => say(held, "ev-packs.gone-pack"))];
  return { titles: picked.length > 0 ? joined(titles) : null, packs: picked.length };
}

function chooser() {
  const held = entries();
  const picked = new Set(selected() ?? []);
  const options = titled(list().packs).map((one) => {
    const label = one.title ?? one.pack;
    const summary = one.summary ?? label;
    return { label, description: picked.has(one.pack) ? `${summary} ${say(held, "ev-packs.chosen-now")}` : summary };
  });
  return JSON.parse(say(held, "ev-packs.which", {}, options)).questions;
}

function main() {
  const [what = "show", ...rest] = process.argv.slice(2);
  if (what === "show") {
    process.stdout.write(existsSync(SELECTION) ? readFileSync(SELECTION, "utf8") : '{"packs":[]}\n');
  } else if (what === "list") {
    process.stdout.write(`${JSON.stringify(list(), null, 2)}\n`);
  } else if (what === "titles") {
    process.stdout.write(`${JSON.stringify(titled(list().packs))}\n`);
  } else if (what === "chosen") {
    process.stdout.write(`${JSON.stringify(chosen())}\n`);
  } else if (what === "chooser") {
    process.stdout.write(`${JSON.stringify({ questions: chooser() })}\n`);
  } else if (what === "set") {
    if (rest.length === 0) usage();
    answered(rest);
    const offered = list().packs;
    const found = rest.map((named) => offered.find((one) => one.pack === named || one.body?.title === named));
    const unknown = rest.filter((_, at) => !found[at]);
    if (unknown.length > 0) {
      process.stderr.write(`unknown-pack: ${unknown.join(", ")} is not a pack Evalation offers, so nothing was saved\n`);
      process.exit(1);
    }
    const chosen = found.filter((one, at) => found.indexOf(one) === at);
    const body = `${JSON.stringify({ packs: chosen.map((one) => one.pack), chosen: new Date().toISOString().replace(/\.\d{3}Z$/, "Z") }, null, 2)}\n`;
    mkdirSync(HOME, { recursive: true });
    writeFileSync(SELECTION, body);
    process.stdout.write(chosen.map((one) => `${one.body?.title ?? one.pack}\n`).join(""));
  } else {
    usage();
  }
}

main();
