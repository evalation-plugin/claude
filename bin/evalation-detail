#!/usr/bin/env node
// evalation-detail - every finding, in the document somebody actually works from.
//
// The board pack carries the score and the shape of the thing. This carries the findings themselves,
// one row each, grouped by the lens that found them and ordered by severity. It is the artefact a
// reader checks a claim against, so it is a PDF: fixed, printable, and not quietly editable into
// something the run never said.
//
// **The measurements are the ones that were settled** and they are reproduced rather than reinvented.
// Landscape letter, a 0.35in margin, and seven columns sized to their longest real content so that
// every inch reclaimed from a fixed column goes to Finding and Remediation, split evenly:
//
//   Pr 0.30  ID 0.78  Sev 0.82  Model 0.88  Finding 3.16  Remediation 3.16  Result 1.20
//
// They sum to the body width exactly. A column wider than it needs to be is width taken from the two
// columns anybody reads.
//
// **The page paginates itself in the browser.** Row heights depend on how text wraps, which nothing
// here can know, and a page number cannot be written by the stylesheet. So the page measures its own
// rows before it prints, breaks where a row would cross the foot, and stamps each page. Guessing a
// row height instead is what produces a table split through the middle of a sentence.
"use strict";

const { readFileSync } = require("node:fs");
const { join, resolve } = require("node:path");

const { print } = require("../lib/print.js");

const ASSETS = resolve(__dirname, "..", "reporting", "assets");

// The house chrome, as the shared source holds it. Severity is this report's own: the evidence pack
// owns coverage colours and this owns severity, and neither writes into the other.
const CHROME = {
  page: "#070C18",
  panel: "#0E1730",
  hairline: "rgba(130,160,230,0.13)",
  ember: "#F9581E",
  text: "#E6ECF7",
  muted: "#9DAAC6",
  faint: "#6F82AB",
};

const SEVERITY = {
  Critical: "#FB3B4E",
  High: "#F9581E",
  Medium: "#FFB020",
  Low: "#6F82AB",
  Info: "#6F82AB",
  Positive: "#35C46A",
};

const ORDER = ["Critical", "High", "Medium", "Low", "Info", "Positive"];

// Inches. The fixed columns are their content's width and no more.
const FIXED = { pr: 0.30, id: 0.78, sev: 0.82, model: 0.88, result: 1.20 };
const MARGIN = 0.35;
const BODY = 11.0 - 2 * MARGIN;
const FLEX = (BODY - Object.values(FIXED).reduce((sum, one) => sum + one, 0)) / 2;

const FONTS = [
  ["Hanken Grotesk", "HankenGrotesk-Regular.ttf", 400],
  ["Hanken Grotesk", "HankenGrotesk-Bold.ttf", 700],
  ["JetBrains Mono", "JetBrainsMono-Regular.ttf", 400],
  ["JetBrains Mono", "JetBrainsMono-Bold.ttf", 700],
];

function escaped(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function faces() {
  return FONTS.map(([family, file, weight]) => {
    const data = readFileSync(join(ASSETS, "fonts", file)).toString("base64");
    return `@font-face{font-family:'${family}';font-weight:${weight};font-style:normal;` +
      `src:url(data:font/ttf;base64,${data}) format('truetype')}`;
  }).join("");
}

function mark() {
  return readFileSync(join(ASSETS, "ev-mark.svg")).toString("base64");
}

function counted(findings) {
  const held = { Critical: 0, High: 0, Medium: 0, Low: 0, Info: 0 };
  for (const one of findings) {
    if (held[one.sev] !== undefined) held[one.sev] += 1;
  }
  return held;
}

// A category's heading carries its own severity split, so a reader knows what a section holds before
// reading a row of it.
function heading(category) {
  const findings = category.findings ?? [];
  const held = counted(findings);
  return `${category.name} (${findings.length}): ` +
    `C ${held.Critical} | H ${held.High} | M ${held.Medium} | L ${held.Low} | I ${held.Info}`;
}

function row(one) {
  const colour = SEVERITY[one.sev] ?? CHROME.faint;
  return `<tr>
<td class="m">${escaped(one.pr)}</td>
<td class="m id">${escaped(one.id)}</td>
<td class="sev"><span class="dot" style="background:${colour}"></span><span style="color:${colour}">${escaped(one.sev)}</span></td>
<td class="m">${escaped(one.model)}</td>
<td>${escaped(one.finding)}</td>
<td>${escaped(one.remediation)}</td>
<td class="m res">${escaped(one.result)}</td>
</tr>`;
}

function table(category) {
  // Priority first, because the column is the work order and a reader following it down the page is
  // reading the order the work should be done in. Severity breaks a tie inside a tier, and the id
  // breaks that, so the same findings always print in the same order.
  const findings = [...(category.findings ?? [])]
    .sort((a, b) => String(a.pr ?? "P9").localeCompare(String(b.pr ?? "P9"))
      || ORDER.indexOf(a.sev) - ORDER.indexOf(b.sev)
      || String(a.id).localeCompare(String(b.id)));

  // A section with nothing in it is said aloud. A lens that read and found nothing is not the same
  // claim as a lens that never ran, and a report that drops the section makes them look identical.
  if (!findings.length) {
    return `<section class="block"><h2>${escaped(heading(category))}</h2>` +
      `<p class="blurb">${escaped(category.blurb ?? "")}</p>` +
      `<p class="none">Read, with nothing to report.</p></section>`;
  }

  return `<section class="block"><h2>${escaped(heading(category))}</h2>` +
    `<p class="blurb">${escaped(category.blurb ?? "")}</p>` +
    `<table><thead><tr>` +
    ["Pr", "ID", "Severity", "Model", "Finding", "Remediation", "Result"]
      .map((one) => `<th>${one}</th>`).join("") +
    `</tr></thead><tbody>${findings.map(row).join("")}</tbody></table></section>`;
}

// The opening page: what was done, what it came to, and how to read what follows.
//
// It is laid out across the page rather than down it, because the page is landscape and prose set to
// the full width of a landscape page runs to a hundred and thirty characters a line, which nobody
// reads comfortably. Three sections stacked full-width with no rule between them was the version
// that looked like three slabs.
//
// **The key is drawn as the table it explains.** Seven sentences in a list make a reader map words to
// columns themselves; the same seven under the real column headings, at the real column widths, is
// read once and understood.
function opening(document) {
  const meta = document.meta ?? {};
  const summary = document.exec_summary ?? {};
  const hardness = document.hardness ?? {};
  const legend = document.legend ?? {};

  const said = [
    ["Where the risk is", summary.where_risk],
    ["What it takes to close", summary.what_it_takes],
    ["The bottom line", summary.bottom_line],
  ].filter(([, value]) => value)
    .map(([label, value]) =>
      `<div class="column"><h3>${label}</h3><p>${escaped(value)}</p></div>`).join("");

  const score = hardness.score === undefined || hardness.score === null
    ? ""
    : `<div class="chip"><span class="chip-label">DETERMINISTIC HARDNESS</span>
<span class="chip-score">${escaped(hardness.score)}</span><span class="chip-of">/100</span>
<span class="chip-grade"> · grade ${escaped(hardness.grade ?? "")}</span></div>`;

  // Each column of the findings table, said in its own column, at its own width.
  const columns = [
    ["Pr", legend.priority ?? "P0 first through P3 last."],
    ["ID", "The stable id: the discipline's prefix and a number."],
    ["Severity", "Critical through Info, with a coloured dot."],
    ["Model", "What produced the finding."],
    ["Finding", "One line saying what the issue is."],
    ["Remediation", "The fix, stated concretely enough to act on."],
    ["Result", legend.result ?? "How far a second reading stood behind it."],
  ];

  return `<section class="block">
<h2>The work done</h2>
<p class="intro">${escaped(meta.intro ?? "")}</p>
</section>
${score ? `<section class="block settle">${score}</section>` : ""}
<section class="block">
<h2>Executive summary</h2>
<div class="columns">${said}</div>
</section>
<section class="block last">
<h2>Reading the columns</h2>
<p class="lede">Every findings table that follows uses these seven columns, in this order. This is a
key, not a finding.</p>
<table class="key">
<thead><tr>${columns.map(([name]) => `<th>${name}</th>`).join("")}</tr></thead>
<tbody><tr>${columns.map(([, said_]) => `<td>${escaped(said_)}</td>`).join("")}</tr></tbody>
</table>
</section>`;
}

function page(document) {
  const eyebrow = document.eyebrow
    ?? `EVALATION · ${(document.tenant ?? "").toUpperCase()} · FINDINGS DETAIL`;
  const foot = `${document.title ?? "Platform hardening review"}. Engineering / SDLC findings.`;

  const blocks = opening(document) +
    (document.categories ?? []).map(table).join("");

  return `<!doctype html><meta charset="utf-8"><title>${escaped(document.title ?? "")}</title>
<style>
${faces()}
@page{size:11in 8.5in;margin:0}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:${CHROME.page};color:${CHROME.text};
  font-family:'Hanken Grotesk',system-ui,sans-serif;
  -webkit-print-color-adjust:exact;print-color-adjust:exact}

.sheet{position:relative;width:11in;height:8.5in;overflow:hidden;background:${CHROME.page};
  page-break-after:always;break-after:page;padding:${MARGIN}in}
.sheet:last-child{page-break-after:auto;break-after:auto}

.masthead{position:absolute;left:${MARGIN}in;right:${MARGIN}in;top:0.34in;height:0.95in}
.eyebrow{font-family:'JetBrains Mono',monospace;font-size:8pt;letter-spacing:0.16em;
  color:${CHROME.faint};margin:0}
.title{font-size:18pt;font-weight:700;color:${CHROME.text};margin:0.10in 0 0}
.subtitle{font-size:9.5pt;color:${CHROME.muted};margin:0.05in 0 0}
.mark{position:absolute;right:0;top:0.02in;height:0.42in}

.flow{position:absolute;left:${MARGIN}in;right:${MARGIN}in;top:1.30in;bottom:0.52in;overflow:hidden}

.foot{position:absolute;left:${MARGIN}in;right:${MARGIN}in;bottom:0.34in;
  display:flex;justify-content:space-between;
  font-family:'JetBrains Mono',monospace;font-size:7pt;letter-spacing:0.05em;color:${CHROME.faint};
  border-top:1px solid ${CHROME.hairline};padding-top:5px}

h2{font-size:13pt;font-weight:700;color:${CHROME.text};margin:0 0 0.06in}
/* Set open. At eight point with tight tracking the mono W runs into the H beside it and "WHERE"
   reads as "#HERE", which is the kind of thing a reader notices and cannot explain. */
h3{font-family:'JetBrains Mono',monospace;font-size:8.5pt;font-weight:400;letter-spacing:0.16em;
  text-transform:uppercase;color:${CHROME.faint};margin:0 0 0.06in}
p{font-size:9pt;line-height:12.5pt;color:${CHROME.text};margin:0 0 0.05in}
.blurb{color:${CHROME.muted}}
.lede{color:${CHROME.muted};margin:0 0 0.07in}
.none{color:${CHROME.faint};font-style:italic}
.block{margin:0 0 0.16in}

/* Across the page rather than down it. Prose set to the full width of a landscape page runs to a
   hundred and thirty characters a line, which is past what anybody reads comfortably. */
/* One block, running the width of the page. Set in two columns the passage reads across the gutter
   mid-sentence, and a reader finishing "how far a second" has to jump the page to find "reading
   stood behind it", which costs more than a long line does. */
p.intro{max-width:none}
.columns{display:flex;gap:0.34in;align-items:flex-start}
.columns .column{flex:1 1 0;min-width:0}
.columns .column p{color:${CHROME.muted}}

/* The key names the seven columns in the order a reader meets them, each with room to be explained.
   It deliberately does not copy the table's own widths: a column three tenths of an inch wide holds
   two characters of a sentence, so a key drawn to those widths is a column of single letters and
   half a page tall. Order is what carries here; proportion is what the table itself shows. */
table.key{margin:0;table-layout:fixed}
table.key col{width:${100 / 7}%}
table.key td{color:${CHROME.muted};border-bottom:none;font-size:8pt;line-height:11pt;
  padding:6px 10px 0 0}
table.key th{background:transparent;border-bottom:1px solid ${CHROME.hairline};padding-left:0}
/* The last block on a sheet must not push its own margin into the measurement that decides whether
   it fits, or every sheet stops one section early. */
.flow > .block:last-child{margin-bottom:0}

.chip{background:${CHROME.panel};border-left:3px solid ${CHROME.ember};
  padding:0.12in 0.22in;margin:0;display:inline-flex;align-items:baseline;gap:0.10in;
  white-space:nowrap}

/* The score sits at the foot of the page it lands on, centred: it is the one number a reader takes
   away, and it reads as a conclusion there rather than as a box beside a paragraph. It is placed
   after the page has been laid out, because until then nothing knows which page it lands on. */
.settle{position:absolute;left:0;right:0;bottom:0.28in;margin:0;text-align:center}
.chip-label{font-family:'JetBrains Mono',monospace;font-size:7.5pt;letter-spacing:0.10em;
  color:${CHROME.faint}}
.chip-score{font-size:20pt;font-weight:700;color:${CHROME.text}}
.chip-of{font-size:9pt;color:${CHROME.muted}}
.chip-grade{font-size:11pt;color:${CHROME.text}}

table{width:100%;border-collapse:collapse;table-layout:fixed;margin:0.04in 0 0}
th{font-family:'JetBrains Mono',monospace;font-size:7.2pt;font-weight:400;text-align:left;
  color:${CHROME.faint};padding:4px 6px;background:${CHROME.panel};
  border-bottom:1px solid ${CHROME.hairline}}
td{font-size:7.6pt;line-height:9.6pt;color:${CHROME.text};padding:5px 6px;vertical-align:top;
  border-bottom:1px solid ${CHROME.hairline};overflow-wrap:anywhere}
td.m{font-family:'JetBrains Mono',monospace;font-size:7.2pt;line-height:9.2pt;color:${CHROME.muted}}
td.id{color:${CHROME.muted}}
td.res{color:${CHROME.muted}}
td.sev{font-size:7.6pt;white-space:nowrap}
.dot{display:inline-block;width:5px;height:5px;margin-right:4px;vertical-align:middle}
tbody tr:nth-child(even){background:rgba(14,23,48,0.5)}

col.pr{width:${FIXED.pr}in}col.id{width:${FIXED.id}in}col.sev{width:${FIXED.sev}in}
col.model{width:${FIXED.model}in}col.flex{width:${FLEX}in}col.result{width:${FIXED.result}in}
</style>
<div id="source">${blocks}</div>
<div id="out"></div>
<script>
// The page lays itself out before it prints. Row heights depend on how the text wraps, which only the
// browser knows, so blocks and rows are measured and moved onto a fresh sheet the moment one would
// cross the foot of the page. A table continued on the next sheet takes its heading and its column
// headers with it, because a column of text under no headings is unreadable.
(function () {
  var COLS = '<colgroup><col class="pr"><col class="id"><col class="sev"><col class="model">' +
             '<col class="flex"><col class="flex"><col class="result"></colgroup>';
  var source = document.getElementById('source');
  var out = document.getElementById('out');
  var eyebrow = ${JSON.stringify(eyebrow)};
  var title = ${JSON.stringify(document.title ?? "")};
  var subtitle = ${JSON.stringify(document.subtitle ?? "")};
  var foot = ${JSON.stringify(foot)};
  var mark = "data:image/svg+xml;base64,${mark()}";
  var sheet = null, flow = null;

  function open() {
    sheet = document.createElement('div');
    sheet.className = 'sheet';
    sheet.innerHTML =
      '<div class="masthead"><p class="eyebrow"></p><p class="title"></p>' +
      '<p class="subtitle"></p><img class="mark"></div>' +
      '<div class="flow"></div>' +
      '<div class="foot"><span class="foot-left"></span><span class="foot-right"></span></div>';
    sheet.querySelector('.eyebrow').textContent = eyebrow;
    sheet.querySelector('.title').textContent = title;
    sheet.querySelector('.subtitle').textContent = subtitle;
    sheet.querySelector('.mark').src = mark;
    sheet.querySelector('.foot-left').textContent = foot;
    out.appendChild(sheet);
    flow = sheet.querySelector('.flow');
    return flow;
  }

  // Measured from the boxes themselves rather than from scrollHeight, which counts a trailing margin
  // as content and so ends every sheet a section early.
  function overflows() {
    // The score is anchored to the foot of its page and takes no space in the flow, so it is never
    // what decides whether the page is full. Measured as the last block it would report every page
    // as overflowing, since it sits at the bottom by definition.
    var kept = [];
    for (var k = 0; k < flow.children.length; k++) {
      if (!flow.children[k].classList.contains('settle')) kept.push(flow.children[k]);
    }
    var last = kept[kept.length - 1];
    if (!last) return false;
    var rows = last.querySelectorAll('tbody tr');
    var edge = rows.length
      ? rows[rows.length - 1].getBoundingClientRect().bottom
      : last.getBoundingClientRect().bottom;
    return edge > flow.getBoundingClientRect().bottom + 0.5;
  }

  // Column widths go on before anything is measured. Measured without them the columns are equal, the
  // two prose columns are half the width they print at, every row wraps taller than it will, and each
  // sheet ends a section early against a height that was never real.
  var early = source.querySelectorAll('table');
  for (var e = 0; e < early.length; e++) early[e].insertAdjacentHTML('afterbegin', COLS);

  open();
  var blocks = Array.prototype.slice.call(source.children);
  for (var i = 0; i < blocks.length; i++) {
    var block = blocks[i];
    flow.appendChild(block);
    if (!overflows()) continue;

    // The block does not fit where it is. On a sheet that already holds something it moves to a
    // fresh one; on an empty sheet it stays, because taking it off and only putting it back when
    // there was something else there drops any block bigger than a page.
    if (flow.children.length > 1) {
      flow.removeChild(block);
      open();
      flow.appendChild(block);
    }
    if (!overflows()) continue;

    // Still too tall, so it is a table that has to be split row by row.
    var table = block.querySelector('table');
    if (!table) continue;

    // The section's own heading, taken once. Read from the block each time round, a continuation
    // takes the heading that already says so and says it again, and a long section ends up headed
    // "(cont.) (cont.) (cont.)" with its own name pushed off the page.
    var heading = block.querySelector('h2').textContent;

    var body = table.querySelector('tbody');
    var rows = Array.prototype.slice.call(body.children);
    for (var r = 0; r < rows.length; r++) body.removeChild(rows[r]);

    for (var r2 = 0; r2 < rows.length; r2++) {
      body.appendChild(rows[r2]);
      if (!overflows()) continue;
      body.removeChild(rows[r2]);

      open();
      var carried = document.createElement('section');
      carried.className = 'block';
      carried.innerHTML = '<h2></h2><table>' + COLS + table.querySelector('thead').outerHTML +
        '<tbody></tbody></table>';
      carried.querySelector('h2').textContent = heading + '  (cont.)';
      flow.appendChild(carried);
      block = carried;
      body = carried.querySelector('tbody');
      body.appendChild(rows[r2]);
    }
  }

  source.remove();
  var sheets = out.querySelectorAll('.sheet');
  for (var s = 0; s < sheets.length; s++) {
    sheets[s].querySelector('.foot-right').textContent = 'Page ' + (s + 1) + ' of ' + sheets.length;
  }
  // Column widths are set on every table, including the ones split above.
  var tables = out.querySelectorAll('table');
  for (var t = 0; t < tables.length; t++) {
    if (!tables[t].querySelector('colgroup')) tables[t].insertAdjacentHTML('afterbegin', COLS);
  }
})();
</script>`;
}

function detail(document, into) {
  const html = page(document);
  return print(html, `${into.replace(/\.pdf$/, "")}.html`, into);
}

module.exports = { detail };

if (require.main === module) {
  const [source, into] = process.argv.slice(2);
  if (!source || !into) {
    process.stderr.write("usage: evalation-detail <review-findings.json> <out.pdf>\n");
    process.exit(2);
  }
  const document = JSON.parse(readFileSync(resolve(source), "utf8"));
  const done = detail(document, resolve(into));
  const count = (document.categories ?? []).reduce((sum, one) => sum + (one.findings?.length ?? 0), 0);
  process.stdout.write(done.printed
    ? `wrote ${count} findings across ${(document.categories ?? []).length} categories\n`
    : `no browser to print with. The page is at ${done.page}: open it and print to PDF.\n`);
}
