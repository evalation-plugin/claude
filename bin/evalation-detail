#!/usr/bin/env node
// evalation-detail - every finding, in the document somebody actually works from.
//
// The board pack carries the score and the shape of the thing. This carries the findings themselves,
// one section each, grouped by the discipline that found them and ordered by the work order. It is
// the artefact a reader checks a claim against, so it is a PDF: fixed, printable, and not quietly
// editable into something the run never said.
//
// **A finding is a section, not a row.** A row is read across seven narrow columns, so the two
// columns anybody actually reads are each about three inches wide and every sentence wraps four
// times. A section gives the finding the width of the page: what was found reads as prose, the file
// it rests on sits under it, and what closes it sits under that, marked so a reader skimming for
// work can find it without reading the finding first.
//
// **Portrait, because prose.** The table needed the long edge of the page and this does not. At
// 8.5 by 11 with a 0.45 inch margin a line of body text runs to about ninety characters, which is
// what a reader takes in without losing the line.
//
// **The page paginates itself in the browser.** Section heights depend on how text wraps, which
// nothing here can know, and a page number cannot be written by the stylesheet. So the page measures
// its own sections before it prints and breaks where one would cross the foot. A discipline whose
// findings run past the foot says its name again at the top of the next page, because a section with
// no discipline over it reads as belonging to the one before.
"use strict";

const { readFileSync } = require("node:fs");
const { join, resolve } = require("node:path");

const { print } = require("../lib/print.js");
const { named } = require("../lib/scans.js");

const ASSETS = resolve(__dirname, "..", "reporting", "assets");

// The house chrome, as the shared source holds it. Severity is this report's own: the evidence pack
// owns coverage colours and this owns severity, and neither writes into the other.
const CHROME = {
  page: "#070C18",
  panel: "#0E1730",
  // A finding's own card, and its edge. Both are deliberately well clear of the page: the panel the
  // rest of the house uses sits one step off it, which is enough for a single box on a page and not
  // enough for twenty down one.
  card: "#141E3C",
  edge: "rgba(130,160,230,0.32)",
  // Inside a card, set below it. A bar lighter than the card it sits in reads as another card.
  inset: "#0B1226",
  rule: "#1B2748",
  hairline: "rgba(130,160,230,0.13)",
  ember: "#F9581E",
  blue: "#6B8FFF",
  text: "#E6ECF7",
  muted: "#9DAAC6",
  faint: "#6F82AB",
};

const SEVERITY = {
  Critical: "#FB3B4E",
  High: "#F9581E",
  Medium: "#FFB020",
  Low: "#6F82AB",
  Info: "#6F82AB",
  Positive: "#35C46A",
};

const ORDER = ["Critical", "High", "Medium", "Low", "Info", "Positive"];

// How far a finding was checked, in the run's own words, each in a colour a reader learns once and
// then reads off the bar without going back to the key. Green is the colour a control that holds
// already carries, and blue is the house colour a finding's own id carries.
const STANDING = {
  verified: SEVERITY.Positive,
  asserted: CHROME.blue,
  scanned: CHROME.muted,
};

function standing(word) {
  return STANDING[String(word ?? "").toLowerCase()] ?? CHROME.faint;
}

const MARGIN = 0.45;

const FONTS = [
  ["Hanken Grotesk", "HankenGrotesk-Regular.ttf", 400],
  ["Hanken Grotesk", "HankenGrotesk-Bold.ttf", 700],
  ["JetBrains Mono", "JetBrainsMono-Regular.ttf", 400],
  ["JetBrains Mono", "JetBrainsMono-Bold.ttf", 700],
];

function escaped(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function faces() {
  return FONTS.map(([family, file, weight]) => {
    const data = readFileSync(join(ASSETS, "fonts", file)).toString("base64");
    return `@font-face{font-family:'${family}';font-weight:${weight};font-style:normal;` +
      `src:url(data:font/ttf;base64,${data}) format('truetype')}`;
  }).join("");
}

function mark() {
  return readFileSync(join(ASSETS, "ev-mark.svg")).toString("base64");
}

function counted(findings) {
  const held = { Critical: 0, High: 0, Medium: 0, Low: 0, Info: 0, Positive: 0 };
  for (const one of findings) {
    if (held[one.sev] !== undefined) held[one.sev] += 1;
  }
  return held;
}

function everyFinding(document) {
  return (document.categories ?? []).flatMap((one) => one.findings ?? []);
}

// A discipline's heading carries its own split, so a reader knows what the pages under it hold
// before reading one of them. Each letter is the severity's own colour, the same colour it carries
// on the tag of every finding and in the bar on the first page, and a zero is set in the muted grey
// so the colour marks what is there. The positive count is in the split as well, or the letters sum
// to fewer than the number in brackets and a reader cannot see where the rest went.
const SPLIT = [["C", "Critical"], ["H", "High"], ["M", "Medium"], ["L", "Low"], ["I", "Info"],
  ["P", "Positive"]];

function heading(category) {
  const findings = category.findings ?? [];
  const held = counted(findings);
  const split = SPLIT.map(([letter, sev]) =>
    `<span style="color:${held[sev] ? SEVERITY[sev] : CHROME.faint}">${letter} ${held[sev]}</span>`)
    .join('<span class="bar-sep">|</span>');
  return `${escaped(category.name)} (${findings.length}): <span class="split">${split}</span>`;
}

// The headline of a finding is its own first sentence, taken whole rather than cut: a cut headline
// is the same words as the paragraph under it and a reader reads them twice. What is left of the
// paragraph goes under it, and a finding said in one sentence has nothing there at all.
//
// A full stop, a question mark or an exclamation mark ends a sentence and a colon does not. Cutting
// at a colon leaves a headline hanging on it and a paragraph opening in lower case halfway through
// the writer's own sentence.
function split(text) {
  const said = String(text ?? "").trim();
  const ends = said.match(/^([\s\S]*?[.!?])(\s+)([\s\S]*)$/);
  if (!ends) return { headline: said, rest: "" };
  return { headline: ends[1], rest: ends[3].trim() };
}

// A positive control has nothing to fix, and a fix block in the colour of a warning tells a reader
// the opposite of what the finding says. So the block is named and coloured by which it is.
function remedy(sev) {
  return sev === "Positive"
    ? { label: "What to keep", className: "did keep" }
    : { label: "What to do", className: "did" };
}

function entry(one, lens) {
  const colour = SEVERITY[one.sev] ?? CHROME.faint;
  const { headline, rest } = split(one.finding);
  const said = [one.pr, one.model].filter(Boolean).map(escaped).join(" &middot; ");

  const body = [
    rest ? `<p class="because">${escaped(rest)}</p>` : "",
    one.location
      ? `<div class="cite"><div class="where"><span>${escaped(one.location)}</span>` +
        `<span class="grade" style="color:${standing(one.result)}">` +
        `${escaped(one.result ?? "")}</span></div></div>`
      : "",
    one.remediation
      ? `<div class="${remedy(one.sev).className}"><b>${remedy(one.sev).label}</b>` +
        `${escaped(one.remediation)}</div>`
      : "",
  ].join("");

  return `<article class="entry" data-lens="${escaped(lens)}">
<div class="head">
<span class="id">${escaped(one.id)}</span>
<span class="ttl">${escaped(headline)}</span>
<span class="tag">${said}</span>
<span class="pill" style="background:${colour}">${escaped(one.sev)}</span>
</div>
<div class="body">${body}</div>
</article>`;
}

function section(category) {
  // Priority first, because the order is the work order and a reader going down a discipline is
  // reading the order the work should be done in. Severity breaks a tie inside a tier and the id
  // breaks that, so the same findings always print in the same order. A positive control carries no
  // priority and closes the discipline: a section that opens on what is already working buries the
  // thing the reader came for.
  const findings = [...(category.findings ?? [])]
    .sort((a, b) => String(a.pr || "P9").localeCompare(String(b.pr || "P9"))
      || ORDER.indexOf(a.sev) - ORDER.indexOf(b.sev)
      || String(a.id).localeCompare(String(b.id)));

  // The blurb names what the discipline looked for. A discipline the run recorded no titles for
  // carries no line, and an empty paragraph would leave a gap under the heading saying nothing.
  const blurb = String(category.blurb ?? "").trim();

  // Which scan did not run here, and why. It sits under the heading, before the findings, because a
  // reader has to know what was not run before they read what was found.
  //
  // It says what happened and stops. An earlier version added that everything below was found by
  // reading alone, which is true and reads as a warning about the findings: the reader takes it as
  // a reason to trust them less, when the only thing it establishes is that one tool was absent.
  const unchecked = (category.unchecked ?? []).filter(Boolean);
  const missed = unchecked.map((one) =>
    `<div class="unchecked"><b>${escaped(named(one.phase))} did not run</b>` +
    `${escaped(one.why)}.</div>`).join("");

  const head = `<h2>${heading(category)}</h2>` +
    (blurb ? `<p class="blurb">${escaped(blurb)}</p>` : "") + missed;

  // A discipline with nothing in it is said aloud. The line says what the reading did, and the bar
  // above it, where there is one, says which scan did not run. Two facts, one each, and a reader
  // draws whatever conclusion they draw.
  if (!findings.length) {
    return `<div class="block lens">${head}<p class="none">The reading found nothing to report.</p></div>`;
  }

  // The heading travels with its first finding. Left to break on its own it lands at the foot of a
  // page with its findings on the next one. It carries no discipline name of its own, because a
  // page that opens on the heading is opening the discipline rather than continuing it.
  const [first, ...rest] = findings.map((one) => entry(one, category.name));
  return `<div class="block lens">${head}${first}</div>` + rest.join("");
}

// The stamp the run wrote, as a date. It is carried as YYYYMMDD for the filename, and a reader
// should not have to parse eight digits.
function dated(stamp) {
  const said = String(stamp ?? "");
  return /^\d{8}$/.test(said) ? `${said.slice(0, 4)}-${said.slice(4, 6)}-${said.slice(6)}` : said;
}

// What was assessed, in the facts a reader checks before reading a finding.
function facts(document) {
  const meta = document.meta ?? {};
  // The repository is not here: the subtitle on every page already names it, and a fact stated twice
  // on one page is a fact a reader stops trusting the layout about.
  const said = [
    ["Assessed", dated(document.generated_at)],
    ["Disciplines read", (document.categories ?? []).length],
    ["Findings", meta.finding_count ?? everyFinding(document).length],
    ["Read by", (meta.models ?? []).join(", ")],
  ].filter(([, value]) => value !== undefined && value !== null && String(value) !== "");

  return `<ul class="facts">${said
    .map(([label, value]) => `<li>${escaped(label)}<b>${escaped(value)}</b></li>`).join("")}</ul>`;
}

// The severity split of the whole review, as counts and as a bar of the same colours. The bar says
// the proportion, which a column of five numbers does not.
function tally(document) {
  const held = counted(everyFinding(document));
  const total = Object.values(held).reduce((sum, one) => sum + one, 0);

  const cells = ORDER.map((sev) =>
    `<li><div class="n" style="color:${SEVERITY[sev]}">${held[sev]}</div>` +
    `<div class="l">${sev}</div></li>`).join("");

  const bar = total === 0 ? "" : `<div class="bar">${ORDER
    .map((sev) => `<span style="width:${(held[sev] / total) * 100}%;background:${SEVERITY[sev]}"></span>`)
    .join("")}</div>`;

  return `<ul class="tally">${cells}</ul>${bar}`;
}

// What the tools did, said once at the front. A reader deciding how much this report is worth needs
// it before the findings, not after them, and a phase that never ran is the single most important
// thing a hardening review can fail to mention.
function scanned(document) {
  const phases = document.scan?.phases ?? [];
  if (!phases.length) {
    return `<div class="block"><h2>What the tools checked</h2>
<p class="none">No scan was run over this repository.</p></div>`;
  }

  const rows = phases.map((one) => {
    const said = one.ran
      ? (one.inventory
        ? `${escaped(one.tool)} counted ${one.inventory.components} components, ` +
          `${one.inventory.declaring_no_licence} declaring no licence`
        : `${escaped(one.tool)} found ${one.found}`)
      : `did not run: ${escaped(one.why ?? "no reason recorded")}`;
    return `<dt${one.ran ? "" : ' class="off"'}>${escaped(named(one.phase))}</dt>` +
      `<dd${one.ran ? "" : ' class="off"'}>${said}</dd>`;
  }).join("");

  // The count and nothing after it. What a missing check would have found is unknowable, so any
  // sentence about it is a guess dressed as a caveat.
  const absent = phases.filter((one) => !one.ran).length;
  return `<div class="block">
<h2>What the tools checked</h2>
<p class="lede">${absent === 0
  ? `All ${phases.length} ran.`
  : `${absent} of the ${phases.length} did not run.`}</p>
<dl class="key wide">${rows}</dl>
</div>`;
}

// The opening page: what was assessed, what it came to, and how to read a finding.
function opening(document) {
  const meta = document.meta ?? {};
  const summary = document.exec_summary ?? {};
  const hardness = document.hardness ?? {};
  const legend = document.legend ?? {};

  const said = [
    ["Where the risk is", summary.where_risk],
    ["What it takes to close", summary.what_it_takes],
    ["The bottom line", summary.bottom_line],
  ].filter(([, value]) => value)
    .map(([label, value]) =>
      `<div class="column"><h3>${label}</h3><p>${escaped(value)}</p></div>`).join("");

  // The one number a reader takes away, beside the split it is a summary of. It sits in the flow
  // rather than pinned to the foot of the page: pinned, it lands on top of whatever the page was
  // already holding there.
  const score = hardness.score === undefined || hardness.score === null
    ? ""
    : `<div class="score"><div class="chip"><span class="chip-label">DETERMINISTIC HARDNESS</span>
<span class="chip-score">${escaped(hardness.score)}</span><span class="chip-of">/100</span>
<span class="chip-grade"> &middot; grade ${escaped(hardness.grade ?? "")}</span></div></div>`;

  // Each part of a finding, named where a reader meets it. It is a key, so it says what the part is
  // for and not what any one finding says. The three standing words are set here in the colours they
  // carry on every bar, so a reader learns the colour once and never comes back for it.
  const standings = escaped(legend.result ?? "Scanned, verified or asserted.")
    .replace(/\b(scanned|verified|asserted)\b/gi,
      (word) => `<span style="color:${standing(word)}">${word}</span>`);

  const parts = [
    ["Id", escaped("The stable id: the discipline's prefix and a number. It survives a re-run, so the same weakness found again carries the same id.")],
    ["Headline", escaped("What was found, in one sentence. Anything more sits under it.")],
    ["Severity", escaped("Critical through Info, on the coloured tag at the right. Positive marks a control found working.")],
    ["Priority", escaped(legend.priority ?? "P0 first through P3 last.")],
    ["Model", escaped("What produced the finding.")],
    ["Where it rests", escaped("The file and lines the finding was read from, on the grey bar, so the exact place can be opened.")],
    ["Standing", standings],
    ["What to do", escaped("The fix, on the orange bar, stated concretely enough to act on.")],
  ];

  return `<div class="block">
${facts(document)}
${tally(document)}
${score}
</div>
<div class="block">
<h2>The work done</h2>
<p class="intro">${escaped(meta.intro ?? "")}</p>
</div>
${scanned(document)}
<div class="block">
<h2>Executive summary</h2>
<div class="columns">${said}</div>
</div>
<div class="block last">
<h2>Reading a finding</h2>
<p class="lede">Every finding that follows is laid out the same way. This is a key, not a finding.</p>
<dl class="key">${parts
  .map(([name, meaning]) => `<dt>${escaped(name)}</dt><dd>${meaning}</dd>`).join("")}</dl>
</div>`;
}

function page(document) {
  const foot = `${document.title ?? "Evalation Hardening Review"}. Engineering / SDLC findings.`;

  const blocks = opening(document) +
    (document.categories ?? []).map(section).join("");

  return `<!doctype html><meta charset="utf-8"><title>${escaped(document.title ?? "")}</title>
<style>
${faces()}
@page{size:8.5in 11in;margin:0}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:${CHROME.page};color:${CHROME.text};
  font-family:'Hanken Grotesk',system-ui,sans-serif;
  -webkit-print-color-adjust:exact;print-color-adjust:exact}

.sheet{position:relative;width:8.5in;height:11in;overflow:hidden;background:${CHROME.page};
  page-break-after:always;break-after:page;padding:${MARGIN}in}
.sheet:last-child{page-break-after:auto;break-after:auto}

.masthead{position:absolute;left:${MARGIN}in;right:${MARGIN}in;top:0.34in;height:0.70in}
.title{font-size:18pt;font-weight:700;color:${CHROME.text};margin:0}
.subtitle{font-size:9.5pt;color:${CHROME.muted};margin:0.05in 0 0}
.mark{position:absolute;right:0;top:0.02in;height:0.42in}

/* The flow stops well clear of the foot. Ending it where the foot's own rule begins lets a last
   line print hard against the rule, which reads as a page that ran out of room. */
.flow{position:absolute;left:${MARGIN}in;right:${MARGIN}in;top:1.12in;bottom:0.62in;overflow:hidden}

.foot{position:absolute;left:${MARGIN}in;right:${MARGIN}in;bottom:0.34in;
  display:flex;justify-content:space-between;
  font-family:'JetBrains Mono',monospace;font-size:7pt;letter-spacing:0.05em;color:${CHROME.faint};
  border-top:1px solid ${CHROME.hairline};padding-top:5px}

h2{font-size:13pt;font-weight:700;color:${CHROME.text};margin:0 0 0.14in}
h2 .split{font-family:'JetBrains Mono',monospace;font-size:10pt;font-weight:400}
h2 .bar-sep{color:${CHROME.rule};margin:0 5px}
/* Set open. At eight point with tight tracking the mono W runs into the H beside it and "WHERE"
   reads as "#HERE", which is the kind of thing a reader notices and cannot explain. */
h3{font-family:'JetBrains Mono',monospace;font-size:8.5pt;font-weight:400;letter-spacing:0.16em;
  text-transform:uppercase;color:${CHROME.faint};margin:0 0 0.06in}
p{font-size:9.5pt;line-height:13pt;color:${CHROME.text};margin:0 0 0.05in}
.blurb{color:${CHROME.muted};font-size:9pt;margin:0 0 0.09in}
.lede{color:${CHROME.muted};margin:0 0 0.09in}
.none{color:${CHROME.faint};font-style:italic}
.block{margin:0 0 0.15in}
/* A discipline opens on a gap wider than the one between its own findings, so the page reads as
   several sections and not as one long column. Adjacent margins collapse to the larger of the two,
   so this has to beat a finding's own bottom margin to show at all. A discipline that lands at the
   top of a page takes no gap, since there is nothing above it to be separated from. */
.lens{margin-top:0.44in}
.flow > .lens:first-child{margin-top:0}
/* The last block on a sheet must not push its own margin into the measurement that decides whether
   it fits, or every sheet stops one section early. */
.flow > .block:last-child,.flow > .entry:last-child{margin-bottom:0}

/* The discipline said again where its findings run past the foot of a page. */
.carry{font-family:'JetBrains Mono',monospace;font-size:8pt;letter-spacing:0.1em;
  text-transform:uppercase;color:${CHROME.faint};margin:0 0 0.09in;
  border-bottom:1px solid ${CHROME.hairline};padding-bottom:4px}

.facts{display:flex;flex-wrap:wrap;gap:8px 26px;margin:0 0 0.16in;padding:0;list-style:none;
  font-size:8pt;color:${CHROME.faint}}
.facts b{display:block;color:${CHROME.text};font-weight:400;font-family:'JetBrains Mono',monospace;
  font-size:8.5pt;margin-top:2px}

.tally{display:flex;gap:7px;margin:0;padding:0;list-style:none}
/* The same surface a finding sits on, so the document has one raised thing and not two. */
.tally li{flex:1 1 0;border:1px solid ${CHROME.edge};background:${CHROME.card};
  padding:0.08in 0.10in}
.tally .n{font-family:'JetBrains Mono',monospace;font-size:17pt;font-weight:700;line-height:1.1}
.tally .l{font-size:7.5pt;color:${CHROME.faint};margin-top:2px}
.bar{display:flex;height:6px;overflow:hidden;margin:7px 0 0;background:${CHROME.rule}}
.bar span{display:block}

/* The opening is set a half point tighter than a finding. It holds the facts, the split, the score,
   what was done, the summary and the key, and set at the findings' own size the key falls onto the
   second page and leaves two inches of nothing under the summary. */
p.intro{font-size:9pt;line-height:12.5pt}
.columns{display:flex;gap:0.28in;align-items:flex-start}
.columns .column{flex:1 1 0;min-width:0}
.columns .column p{color:${CHROME.muted};font-size:8.5pt;line-height:12pt}

/* A term and what it means, side by side at a fixed term width. Set as a list the terms are a
   column of one word each with the meanings wrapping under them, which reads as prose broken in
   half rather than as a key. */
dl.key{margin:0;font-size:7.5pt;line-height:10pt}
dl.key dt{float:left;clear:left;width:1.15in;font-family:'JetBrains Mono',monospace;font-size:7pt;
  letter-spacing:0.08em;text-transform:uppercase;color:${CHROME.faint};padding-top:1px}
dl.key dd{margin:0 0 0.03in 1.15in;color:${CHROME.muted}}
/* The scan's own list needs a wider term column: "dependency advisories" wraps at the width the
   finding key uses, and a wrapped term is two lines tall beside a description that is one, which
   puts the next term alongside the wrong description. */
dl.key.wide dt{width:1.6in}
dl.key.wide dd{margin-left:1.6in}
/* A check that did not run, set in the warning colour in both columns, so the eye finds the gaps
   in the list rather than reading eight lines to work out which two are missing. */
dl.key dt.off,dl.key dd.off{color:${SEVERITY.Medium}}

/* What no tool looked at, under the heading of the discipline it leaves uncovered. In the warning
   colour and not the fix colour: it is neither a finding nor something to do, it is the bound on
   what the section below it is worth. */
.unchecked{margin:0 0 0.10in;padding:0.06in 0.10in;border-left:2px solid ${SEVERITY.Medium};
  background:rgba(255,176,32,0.07);font-size:8.5pt;line-height:11.5pt;color:${CHROME.text}}
.unchecked b{display:block;font-family:'JetBrains Mono',monospace;font-size:7pt;letter-spacing:0.08em;
  text-transform:uppercase;color:${SEVERITY.Medium};font-weight:400;margin-bottom:3px}

.score{margin:0.16in 0 0;text-align:center}
.chip{background:${CHROME.card};border-left:3px solid ${CHROME.ember};
  padding:0.12in 0.22in;margin:0;display:inline-flex;align-items:baseline;gap:0.10in;
  white-space:nowrap}
.chip-label{font-family:'JetBrains Mono',monospace;font-size:7.5pt;letter-spacing:0.10em;
  color:${CHROME.faint}}
.chip-score{font-size:20pt;font-weight:700;color:${CHROME.text}}
.chip-of{font-size:9pt;color:${CHROME.muted}}
.chip-grade{font-size:11pt;color:${CHROME.text}}

/* The card is what says where one finding ends and the next begins, and which of the four things on
   the page belong to which finding. Space alone does not do that job: a reader counting blank gaps
   has to measure them against each other to tell a gap inside a finding from a gap between two.
   What it needs is to be visible. At one step off the page colour a card is not a boundary, so
   twenty of them read as one dark surface, and the fix is to lift the fill and the border until the
   edge is a line somebody can see. */
.entry{background:${CHROME.card};border:1px solid ${CHROME.edge};margin:0 0 0.22in;overflow:hidden}
.entry .head{display:flex;gap:0.09in;align-items:baseline;padding:0.10in 0.13in 0}
.entry .id{font-family:'JetBrains Mono',monospace;font-size:8.5pt;font-weight:700;
  color:${CHROME.blue};flex:none}
