#!/usr/bin/env node
// evalation-rotate - replaces this installation's receiving key.
//
// A key that cannot be changed is one nobody may ever suspect, so this is a thing the customer does
// rather than a support request. One command, no coordination, no downtime.
//
// The order matters more than the cryptography here, because the failure this must never have is a
// customer left holding a key the server does not know or a key the server knows and they cannot
// use. So the old private half is kept until the new one has been shown to open something real, and
// the server is told to retire the old one only after that.
//
//   generate, keeping the private half out of sight
//   send the public half, unconfirmed, so the server keeps the old key readable for a window
//   put the new private half in the store, keeping the old beside it
//   fetch something and open it, which is the only proof that any of this worked
//   tell the server it may retire the old key, and drop our copy of it
//
// Interrupted anywhere before the fourth step, the old key still works and the window closes on its
// own. Interrupted after it, the new key works and the old one expires unused.
"use strict";

const { generateKeyPairSync } = require("node:crypto");
const { execFileSync } = require("node:child_process");
const { readFileSync } = require("node:fs");
const { homedir } = require("node:os");
const { join } = require("node:path");

const store = require("./evalation-store");

const here = __dirname;

/**
 * The names this installation's receiving keys are kept under, read from the settings rather than
 * rebuilt here.
 *
 * Rebuilt from a constant they are the same names for every installation on the machine, and a
 * rotation would then replace another installation's key with this one's. The settings already
 * record where this installation's key is, so reading them is both correct and one fewer place that
 * has to agree. An older installation whose settings name the shared slot keeps rotating exactly
 * where it always did.
 */
function named() {
  const settings = process.env.EVALATION_LOCAL || join(homedir(), ".evalation", "evalation.local");
  let held;
  try {
    held = JSON.parse(readFileSync(settings, "utf8"));
  } catch (thrown) {
    fail(`no-settings: ${settings} could not be read, so there is no way to tell which installation this is (${thrown.message})`);
  }
  const reference = store.referenced(held?.secrets?.receiving_key);
  if (!reference) {
    fail(
      `no-receiving-key: ${settings} names no receiving key, so there is nothing to rotate. ` +
        "Activate this installation first.",
    );
  }
  return { service: reference.service, current: reference.account, previous: `${reference.account}-previous` };
}

const { service: SERVICE, current: CURRENT, previous: PREVIOUS } = named();

function fail(reason) {
  process.stderr.write(reason + "\n");
  process.exit(1);
}

function ask(path, body) {
  try {
    return JSON.parse(execFileSync(join(here, "evalation-ask"), [path, JSON.stringify(body)], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "pipe"],
    }));
  } catch (thrown) {
    fail(`the server refused: ${(thrown.stderr || thrown.message).toString().trim()}`);
  }
}

function keep(account, value) {
  store.keep(SERVICE, account, value);
}

/** Null rather than a throw, because the caller is asking whether one is there at all. */
function held(account) {
  try {
    return store.held(SERVICE, account);
  } catch {
    return null;
  }
}

const { privateKey, publicKey } = generateKeyPairSync("x25519");
const priv = privateKey.export({ type: "pkcs8", format: "der" });
const pub = publicKey.export({ type: "spki", format: "der" });
// The raw thirty-two bytes are the tail of each encoding, and raw is what a key is.
const fresh = priv.subarray(priv.length - 32).toString("base64");
const offered = [...pub.subarray(pub.length - 32)];

const standing = held(CURRENT);

process.stderr.write("offering the new key\n");
const answered = ask("/rotate", { receiving_key: offered, confirmed: false });

// Kept before the swap, so an interruption between the two leaves something to go back to.
if (standing) keep(PREVIOUS, standing);
keep(CURRENT, fresh);

process.stderr.write("checking the new key opens what is served\n");
try {
  const packs = ask("/packs", {});
  if (!Array.isArray(packs.packs)) throw new Error("what came back is not a catalogue");
  process.stderr.write(`opened ${packs.packs.length} pack(s) at revision ${packs.revision}\n`);
} catch (thrown) {
  // Put back exactly what was there. The server still accepts the old key for its window, so this
  // is a recovery rather than an outage.
  if (standing) keep(CURRENT, standing);
  fail(
    `the new key did not open what is served, so the old one is back in place: ${thrown.message}\n` +
      "nothing was lost, and the key the server holds returns to the old one when its window closes",
  );
}

ask("/rotate", { receiving_key: offered, confirmed: true });
try {
  store.forget(SERVICE, PREVIOUS);
} catch {
  // Nothing to drop, which is the ordinary case on a first rotation.
}

process.stdout.write(
  JSON.stringify({
    rotated: true,
    previous_accepted_until: answered.previous_until ?? null,
    previous_retired: true,
  }) + "\n",
);
