#!/usr/bin/env node
"use strict";
require("../lib/errors.js");

const { createPrivateKey, createPublicKey, generateKeyPairSync } = require("node:crypto");
const { readFileSync } = require("node:fs");
const { pluginHome } = require("../lib/home.js");
const { join } = require("node:path");
const { runScript } = require("../lib/script.js");
const { why } = require("./evalation-status");
const { entries, say } = require("../lib/say.js");

const store = require("./evalation-store");

const NOT_REPLACED = { clock: "ev-rotate.not-replaced-clock", "key-store-refused": "ev-rotate.not-replaced-key-store", other: "ev-rotate.not-replaced-other" };
const NOT_FINISHED = { clock: "ev-rotate.not-finished-clock", unreachable: "ev-rotate.not-finished-unreachable",
  "key-store-refused": "ev-rotate.not-finished-key-store", other: "ev-rotate.not-finished-other" };
const ENDED = { refused: "ev-account.refused", ended: "ev-account.ended" };
const PKCS8_X25519 = Buffer.from("302e020100300506032b656e04220420", "hex");
const DAMAGED = "sign-in-damaged: this machine's Evalation sign-in could not be read, so nothing was changed";

function fail(reason) {
  process.stderr.write(reason + "\n");
  process.exit(1);
}

function stop(outcomes, kind, detail) {
  const line = say(entries(), ENDED[kind] ?? outcomes[kind] ?? outcomes.other);
  fail([line, ...(process.argv.includes("--reason") ? [kind, detail] : [])].join("\n"));
}

function reasonOf(thrown) {
  return (thrown.stderr || thrown.message).toString().trim();
}

function stopped(first, thrown) {
  const detail = reasonOf(thrown);
  stop(first, why(detail), detail);
}

function signsIn(held) {
  const reference = store.referenced(held?.secrets?.installation_key);
  let key = null;
  if (typeof held?.installation === "string" && reference) {
    try {
      key = store.held(reference.service, reference.account);
    } catch (thrown) {
      if (!store.absent(thrown)) fail("sign-in-unclear: this machine's Evalation sign-in could not be read just now, so nothing was changed");
    }
  }
  if (!key || Buffer.from(key, "base64").length !== 32) fail(DAMAGED);
}

function named() {
  const settings = process.env.EVALATION_LOCAL || join(pluginHome(), "evalation.local");
  let text;
  try {
    text = readFileSync(settings, "utf8");
  } catch {
    fail("no-settings: this machine is not signed in to Evalation, so there is nothing to replace");
  }
  let held;
  try {
    held = JSON.parse(text);
  } catch {
    fail(DAMAGED);
  }
  signsIn(held);
  const reference = store.referenced(held?.secrets?.receiving_key);
  if (!reference) fail("no-receiving-key: this machine's sign-in names no key to replace, so nothing was changed");
  return { service: reference.service, current: reference.account, previous: `${reference.account}-previous` };
}

const { service: SERVICE, current: CURRENT, previous: PREVIOUS } = named();

function ask(path, body) {
  return JSON.parse(runScript("evalation-ask", [path, JSON.stringify(body)], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  }));
}

function held(account) {
  try {
    return store.held(SERVICE, account);
  } catch {
    return null;
  }
}

function forget(account) {
  try {
    store.forget(SERVICE, account);
  } catch {
    return;
  }
}

function publicOf(raw) {
  const key = createPrivateKey({ key: Buffer.concat([PKCS8_X25519, Buffer.from(raw, "base64")]), format: "der", type: "pkcs8" });
  const pub = createPublicKey(key).export({ type: "spki", format: "der" });
  return [...pub.subarray(pub.length - 32)];
}

function restored(standing) {
  try {
    store.keep(SERVICE, CURRENT, standing);
  } catch {
    return false;
  }
  forget(PREVIOUS);
  return true;
}

function finished(sent) {
  try {
    const packs = ask("/packs", {});
    if (!Array.isArray(packs.packs)) throw new Error("what came back is not a catalogue");
    ask("/rotate", { receiving_key: sent, confirmed: true });
  } catch (thrown) {
    stopped(NOT_FINISHED, thrown);
  }
  forget(PREVIOUS);
  process.stdout.write(`${say(entries(), "ev-rotate.replaced")}\n`);
  process.exit(0);
}

let current;
try {
  current = store.held(SERVICE, CURRENT);
  if (!current) throw new Error("it is empty");
} catch {
  fail("no-key: this machine's current key could not be read, so nothing was changed");
}

const older = held(PREVIOUS);
if (older === current) forget(PREVIOUS);
else if (older) {
  let sent = null;
  try {
    sent = publicOf(current);
  } catch {
    if (!restored(older)) stop(NOT_FINISHED, "key-store-refused", "the kept key is not a key and the one before it could not be put back");
    current = older;
  }
  if (sent) {
    try {
      ask("/rotate", { receiving_key: sent, confirmed: false });
    } catch (thrown) {
      stopped(NOT_FINISHED, thrown);
    }
    finished(sent);
  }
}

const { privateKey, publicKey } = generateKeyPairSync("x25519");
const priv = privateKey.export({ type: "pkcs8", format: "der" });
const pub = publicKey.export({ type: "spki", format: "der" });
const fresh = priv.subarray(priv.length - 32).toString("base64");
const offered = [...pub.subarray(pub.length - 32)];

try {
  store.keep(SERVICE, PREVIOUS, current);
  store.keep(SERVICE, CURRENT, fresh);
} catch (thrown) {
  restored(current);
  stop(NOT_REPLACED, "key-store-refused", thrown.message);
}

try {
  ask("/rotate", { receiving_key: offered, confirmed: false });
} catch (thrown) {
  const detail = reasonOf(thrown);
  if (/^refused 4\d\d:/.test(detail) && restored(current)) stop(NOT_REPLACED, why(detail), detail);
  stop(NOT_FINISHED, why(detail), detail);
}

finished(offered);
