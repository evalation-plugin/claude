#!/usr/bin/env node
// evalation-scan - the deterministic half of a hardening review.
//
// A reading of a repository is a judgement. Whether lodash 4.17.20 carries a known advisory is not:
// it is a lookup, and a model answering it from memory is answering from a knowledge cutoff against
// a database that moved this morning. So the advisories, the secrets and the static findings come
// from tools that either ran or did not, and the reading is handed what they found and judges what
// it means in this codebase. Deterministic facts, judged exploitability, and a reader can see which
// is which.
//
// **The reading never runs this and never holds a shell.** This runs before the reading starts. The
// reading reaches what it found through `evalation-read <target> scan`, fenced like every other
// thing it is shown, so the one command that can start a process is not one the model holds.
//
// **A phase whose tool is not on the machine skips and says so.** It never falls back to guessing,
// and the scan file records the skip with its reason, because a report that cannot tell a clean scan
// from an absent one is worth nothing. The reading is told which phases ran, and a discipline whose
// scanner never ran says that where it appears.
//
// **Read-only on the target.** Each tool is given the target as an argument and is run as argv, never
// through a shell, so nothing derived from the tree is ever interpolated into a command line. Where
// the target is a git repository a porcelain witness is taken before and after, and a scan that
// changed the thing being measured fails rather than reports.
//
// **A secret's material never leaves the machine it was found on.** The secret phase records the
// file, the lines and the rule that fired. Not the secret, not the line it sat on, and not a partial
// of either: a finding that quotes the credential it found has published it into a PDF.
//
// **Nothing is cached.** The same lockfile carries a different answer the day an advisory lands, so
// a cache keyed on the dependencies would serve yesterday's all-clear as today's.
"use strict";
const errors = require("../lib/errors.js");

const { execFileSync, spawnSync } = require("node:child_process");
const { existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, renameSync, rmSync,
  statSync, writeFileSync } = require("node:fs");
const { tmpdir } = require("node:os");
const { pluginHome } = require("../lib/home.js");
const { basename, dirname, isAbsolute, join, resolve } = require("node:path");

const { SCANS } = require("../lib/scans.js");
const { copied, filesOf, inRepository, skipped } = require("../lib/tree.js");
const { attributesOf, counted, languageOf } = require("../lib/linguist.js");
const { solutionOf } = require("../lib/solution.js");
const { answered } = require("../lib/answer.js");
const { cwesOf } = require("../lib/weaknesses.js");
const { answersFor, asked: lookupAsked, candidates } = require("../lib/lookup.js");

const HOME = pluginHome();
const SETTINGS = process.env.EVALATION_LOCAL || join(HOME, "evalation.local");

// Worst last. A floor keeps the noise of a thousand negligible transitive advisories out of a report
// somebody has to act on, without pretending they were not there: the count of what fell below it is
// recorded beside what was kept.
const LADDER = ["negligible", "low", "medium", "high", "critical"];

// What runs, and what it runs with. Four phases because the questions are four: what does the
// dependency tree carry, what is in the tree, what does the code itself do wrong, and what was
// committed that should never have been.
//
// Three of them answer in findings and the bill of materials answers in an inventory, because an
// inventory is not a list of things wrong. A phase held to findings alone would report the bill of
// materials clean on every repository that ever had one, which is a true number and a useless one.
// So a phase returns findings, an inventory, or both, and the reading is shown whichever it gave.
const DEFAULTS = {
  sca: { enabled: true, tool: "trivy" },
  sbom: { enabled: true, tool: "syft" },
  sast: { enabled: true, tool: "semgrep" },
  secret: { enabled: true, tool: "gitleaks" },
  history: { enabled: true, tool: "git" },
  licence: { enabled: true, tool: "trivy" },
};

const FLOOR = "low";

const MEASURES = {
  history: ["concentration", "quiet", "releases", "dormant", "area", "slowing", "departed", "tickets", "tests", "reverts", "markers"].map((one) => `history:${one}`),
  licence: ["licence:restricted", "licence:unknown", "licence:in-code"],
};

// How a tool gets onto a machine that has none of them, which is every customer's machine on the
// first run. The plugin is the only thing they installed, so a scanner it needs is a scanner it has
// to offer to fetch: told to go and install four tools themselves, most people run the review
// without them and never learn what it did not look at.
//
// Homebrew, because it is the one package manager that covers macOS and Linux and is what all four
// of these publish through. Where it is absent this says so and the phase skips, which is the same
// honest ending as a refusal.
const BREW = "brew";

function installer(tool) {
  return { command: BREW, args: ["install", tool], said: `${BREW} install ${tool}` };
}

const { fault, line } = require("../lib/run-say.js");

const TOOLS = {
  trivy: { name: "Trivy", does: "ev-run.does-trivy", page: "https://github.com/aquasecurity/trivy" },
  syft: { name: "Syft", does: "ev-run.does-syft", page: "https://github.com/anchore/syft" },
  semgrep: { name: "Semgrep", does: "ev-run.does-semgrep", page: "https://github.com/semgrep/semgrep" },
  gitleaks: { name: "Gitleaks", does: "ev-run.does-gitleaks", page: "https://github.com/gitleaks/gitleaks" },
  git: { name: "git", does: "ev-run.does-git", page: "https://git-scm.com/downloads" },
};

const AREAS = { sca: "ev-run.area-sca", sbom: "ev-run.area-sbom", sast: "ev-run.area-sast", secret: "ev-run.area-secret", history: "ev-run.area-history", licence: "ev-run.area-licence" };
const DOES = { licence: "ev-run.does-licence" };
const CHECKS = Object.fromEntries(Object.entries(AREAS).map(([phase, name]) => [phase, line(name)]));

const nameOf = (tool) => TOOLS[tool]?.name ?? tool;
const offerOf = (tool, phase) => line("ev-run.tool-offer", { tool: nameOf(tool), does: DOES[phase] ? line(DOES[phase]) : TOOLS[tool] ? line(TOOLS[tool].does) : CHECKS[phase] ?? phase });

function today() {
  const now = new Date();
  return [now.getFullYear(), now.getMonth() + 1, now.getDate()].map((one) => String(one).padStart(2, "0")).join("-");
}

function spoken(day) {
  return day
    ? new Date(`${day}T00:00:00Z`).toLocaleDateString("en-NZ", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
    : null;
}

function missingWhy(tool, held) {
  const failed = held.could_not_install[tool];
  if (failed) return `${nameOf(tool)} could not be installed (${failed.why})`;
  if (held.declined.includes(tool)) {
    const on = spoken(held.declined_on[tool]);
    return `the person running the review chose not to install ${nameOf(tool)}${on ? ` on ${on}` : ""}`;
  }
  return `${nameOf(tool)} is not installed on this machine`;
}

function missingReason(tool, held) {
  if (held.could_not_install[tool]) return "could-not-install";
  return held.declined.includes(tool) ? "declined" : "missing";
}

const WHY = {
  "could-not-install": "ev-run.scan-could-not-install", missing: "ev-run.scan-missing", off: "ev-run.scan-off",
  "no-adapter": "ev-run.scan-no-adapter", failed: "ev-run.scan-failed", "no-history": "ev-run.scan-no-history",
  "no-lockfile": "ev-run.scan-no-lockfile", "not-installed": "ev-run.scan-not-installed",
};

function listed(items) {
  if (items.length < 3) return items.join(" and ");
  return `${items.slice(0, -1).join(", ")}, and ${items.at(-1)}`;
}

function notChecked(one) {
  const values = { area: CHECKS[one.phase] ?? one.phase, tool: nameOf(one.tool) };
  if (one.reason === "declined") {
    return one.declined_on ? line("ev-run.scan-not-checked-declined", { ...values, date: one.declined_on })
      : line("ev-run.scan-not-checked-declined-undated", values);
  }
  return line("ev-run.scan-not-checked", { ...values, why: line(WHY[one.reason] ?? "ev-run.scan-did-not-run", values) });
}

function readOut(phases) {
  const checked = phases.filter((one) => one.ran).map((one) => CHECKS[one.phase] ?? one.phase);
  return [...(checked.length > 0 ? [line("ev-run.scan-checked", { areas: listed(checked) })] : []),
    ...phases.filter((each) => each.looked_up).map((each) => each.looked_up),
    ...phases.filter((each) => !each.ran).map(notChecked)].join(" ");
}

function stopped(text) {
  process.stderr.write(`${text}\n`);
  process.exit(1);
}

function fail(detail) {
  stopped(fault(line("ev-run.fault-scan"), detail));
}

function settings() {
  if (!existsSync(SETTINGS)) return {};
  try {
    return JSON.parse(readFileSync(SETTINGS, "utf8"));
  } catch (thrown) {
    fail(`settings-unreadable: ${SETTINGS} is not JSON (${thrown.message})`);
  }
}

function keep(next) {
  mkdirSync(dirname(SETTINGS), { recursive: true });
  const draft = `${SETTINGS}.writing`;
  writeFileSync(draft, `${JSON.stringify(next, null, 2)}\n`);
  renameSync(draft, SETTINGS);
}

function phases() {
  const held = settings().scan ?? {};
  const built = {};
  for (const [phase, fallback] of Object.entries(DEFAULTS)) {
    built[phase] = { ...fallback, ...(held.phases?.[phase] ?? {}) };
  }
  return {
    floor: held.floor ?? FLOOR,
    drop_transitive_below_floor: held.drop_transitive_below_floor ?? true,
    declined: held.declined ?? [],
    declined_on: held.declined_on ?? {},
    could_not_install: held.could_not_install ?? {},
    phases: built,
  };
}

// Whether the tool is here, by walking the path rather than by asking a shell. Asking a shell to
// answer it means building a command line out of a tool name, which is the one thing this file does
// not do anywhere else.
function onThisMachine(tool) {
  if (tool.includes("/")) return existsSync(tool);
  for (const where of (process.env.PATH ?? "").split(":")) {
    if (!where) continue;
    try {
      const at = statSync(join(where, tool));
      if (at.isFile() && (at.mode & 0o111) !== 0) return true;
    } catch {
      // Not in this one.
    }
  }
  return false;
}

function ranked(said) {
  const at = LADDER.indexOf(String(said ?? "").toLowerCase());
  return at === -1 ? 0 : at;
}

// What each tool calls a grade, in ours. Static analysers speak in errors and warnings and advisory
// databases speak in the ladder, and a word this does not know is taken as the bottom of it rather
// than dropped, so an unrecognised grade is quiet and never absent.
const SPOKEN = {
  error: "high",
  warning: "medium",
  info: "low",
  unknown: "negligible",
  none: "negligible",
};

function severityOf(said) {
  const word = String(said ?? "").toLowerCase();
  return LADDER.includes(word) ? word : (SPOKEN[word] ?? "negligible");
}

/** The first sentences of an advisory's description, up to about three hundred characters. */
function opening(text) {
  // Advisories are written in markdown, and a report prints plain words: headings, table rows, link
  // targets and emphasis marks come out, keeping the words they carry.
  const flat = String(text ?? "")
    .replace(/^\s*#+\s.*$/gm, " ")
    .replace(/^\s*\|.*\|\s*$/gm, " ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[`*_]/g, "")
    .replace(/\s+/g, " ").trim();
  if (flat.length <= 300) return flat;
  const cut = flat.slice(0, 300);
  const end = cut.lastIndexOf(". ");
  return end > 80 ? cut.slice(0, end + 1) : `${cut.slice(0, cut.lastIndexOf(" "))}…`;
}

// Where a tool says a thing is, said as the repository says it. A tool that answers in absolute
// paths writes the person's home directory into a file that becomes a PDF, and names a path the
// reading cannot open, since the one command it holds takes a path inside the tree.
function within(root, path) {
  if (!path) return path;
  const full = isAbsolute(path) ? path : join(root, path);
  const said = inRepository(root, full);
  return said && !said.startsWith("..") ? said : path;
}

/** The direct dependencies an indirect package is reached through, as name and version, at most four. */
function broughtBy(id, packages, parents) {
  const found = [];
  const seen = new Set([id]);
  const queue = [...(parents.get(id) ?? [])];
  while (queue.length > 0 && found.length < 4) {
    const at = queue.shift();
    if (seen.has(at)) continue;
    seen.add(at);
    const one = packages.get(at);
    if (!one) continue;
    if (["direct", "root", "workspace"].includes(String(one.Relationship ?? "").toLowerCase())) {
      if (String(one.Relationship).toLowerCase() === "direct") found.push(`${one.Name} ${one.Version}`);
      continue;
    }
    queue.push(...(parents.get(at) ?? []));
  }
  return found;
}

/**
 * The adapters. Each says how to start its tool and how to read what it printed, and each returns
 * findings in the one shape the rest of this file and the reading ever see. A tool the table does
 * not name cannot be set, because a tool name that reached a command line from anywhere else is a
 * command somebody else chose.
 */
const ADAPTERS = {
  trivy: {
    phase: "sca",
    // Every package listed, so the scan knows which the repository depends on itself and which came
    // in through another. An advisory carries neither, and read from it every result was direct.
    argv: (target) => ["fs", "--scanners", "vuln", "--list-all-pkgs", "--format", "json", "--quiet", target],
    read: (out, root) => {
      const held = JSON.parse(out || "{}");
      const found = [];
      for (const result of held.Results ?? []) {
        const packages = new Map((result.Packages ?? []).map((one) => [one.ID, one]));
        const parents = new Map();
        for (const one of result.Packages ?? []) {
          for (const child of one.DependsOn ?? []) {
            if (!parents.has(child)) parents.set(child, []);
            parents.get(child).push(one.ID);
          }
        }
        for (const one of result.Vulnerabilities ?? []) {
          const version = one.InstalledVersion ?? "";
          const own = packages.get(one.PkgID);
          const direct = !own || ["direct", "root", "workspace"].includes(String(own.Relationship ?? "direct").toLowerCase());
          found.push({
            key: `sca:${one.PkgName}@${version}:${one.VulnerabilityID}`,
            severity: severityOf(one.Severity),
            title: `${one.VulnerabilityID} in ${one.PkgName} ${version}`,
            package: one.PkgName,
            version,
            fixed: one.FixedVersion ?? null,
            transitive: !direct,
            // Said outright, so a report can tell a scan that knew from an older one that did not.
            relation: direct ? "direct" : "indirect",
            // The packages this repository depends on directly that bring an indirect one in, which is
            // what has to move when upgrading the repository's own dependencies cannot reach it.
            ...(direct ? {} : { via: broughtBy(one.PkgID, packages, parents) }),
            at: { path: within(root, result.Target) },
            // What the weakness is and what it lets somebody do: the advisory's title, then the opening
            // of its description, which is where an advisory says what an attacker gains.
            body: [one.Title, opening(one.Description)].filter(Boolean).join(". "),
            link: one.PrimaryURL ?? null,
            // The class of weakness, which is what says what an attacker could do with it.
            cwe: cwesOf(one.CweIDs ?? []),
          });
        }
      }
      return found;
    },
  },

  syft: {
    phase: "sbom",
    argv: (target) => ["scan", `dir:${target}`, "-o", "syft-json", "-q"],
    read: (out) => {
      const parts = JSON.parse(out || "{}").artifacts ?? [];
      const ecosystems = {};
      for (const one of parts) ecosystems[one.type ?? "unknown"] = (ecosystems[one.type ?? "unknown"] ?? 0) + 1;
      return { findings: [], inventory: { components: parts.length, ecosystems } };
    },
  },

  semgrep: {
    phase: "sast",
    // The published security rules rather than the automatic set, which asks for an account on this
    // version and would stop the phase on a machine that has none.
    argv: (target) => ["scan", "--config", "p/security-audit", "--json", "--quiet", "--no-git-ignore",
      "--metrics", "off", target],
    read: (out, root) => (JSON.parse(out || "{}").results ?? []).map((one) => {
      const at = within(root, one.path);
      const from = one.start?.line ?? 0;
      return {
        key: `sast:${one.check_id}:${at}:${from}`,
        severity: severityOf(one.extra?.severity),
        title: `${String(one.check_id).split(".").pop()} in ${at}`,
        at: { path: at, from, to: one.end?.line ?? from },
        body: String(one.extra?.message ?? "").replace(/\s+/g, " ").trim(),
        cwe: cwesOf(one.extra?.metadata?.cwe ?? []),
      };
    }),
  },

  gitleaks: {
    phase: "secret",
    // Reported to a file because the tool writes its own progress to the terminal, and told to exit
    // zero on a leak so that finding something is not read here as the tool having failed.
    intoFile: true,
    argv: (target, into, isRepository) => [
      isRepository ? "git" : "dir", target,
      "--report-format", "json", "--report-path", into,
      "--redact", "--exit-code", "0", "--no-banner", "--log-level", "error",
    ],
    read: (out, root) => (JSON.parse(out || "[]")).map((one) => {
      // The rule, the file and the line. Nothing from the match itself: the tool is told to redact,
      // and this drops the redacted remains too, since a report is the wrong place to carry even the
      // shape of a credential.
      const at = within(root, one.File);
      return {
        key: `secret:${one.RuleID}:${at}:${one.StartLine}`,
        severity: "high",
        title: `${one.RuleID} in ${at}`,
        at: { path: at, from: one.StartLine, to: one.EndLine ?? one.StartLine },
        body: `${String(one.Description ?? one.RuleID).replace(/\.$/, "")}${one.Commit ? `, in commit ${one.Commit}` : ""}.`,
        // A committed credential, whatever the rule that found it.
        cwe: ["CWE-798"],
      };
    }),
  },
};

const GRADES = [
  [/\b(AGPL|SSPL)/i, "critical"],
  [/\bLGPL/i, "medium"],
  [/\b(GPL|EUPL|OSL)/i, "high"],
  [/\b(MPL|EPL|CDDL)/i, "medium"],
];

function licenceGrade(expression) {
  const worse = (a, b) => (ranked(a) >= ranked(b) ? a : b);
  const choices = String(expression).replace(/[()]/g, " ").split(/\s+OR\s+/i).map((choice) =>
    choice.split(/\s+AND\s+/i).map((part) => GRADES.find(([pattern]) => pattern.test(part))?.[1] ?? null)
      .reduce((worst, one) => (one === null ? worst : worst === null ? one : worse(worst, one)), null));
  return choices.includes(null) ? null : choices.reduce((mildest, one) => (ranked(one) < ranked(mildest) ? one : mildest));
}

const listedUpTo = (names) => `${names.slice(0, 12).join(", ")}${names.length > 12 ? ` and ${names.length - 12} more` : ""}`;

const unquoted = (text) => String(text).trim().replace(/^["']|["']$/g, "");

function tomlPath(header) {
  return [...header.matchAll(/"[^"]*"|'[^']*'|[^.]+/g)].map((one) => unquoted(one[0]));
}

const KINDS = { dependencies: "normal", "dev-dependencies": "dev", dev_dependencies: "dev", "build-dependencies": "build", build_dependencies: "build" };

function manifestOf(text) {
  const kinds = new Map();
  const add = (name, kind) => {
    if (!kinds.has(name)) kinds.set(name, new Set());
    kinds.get(name).add(kind);
  };
  let licence = null;
  let licenceFile = false;
  let section = [];
  let single = null;
  for (const raw of String(text).split("\n")) {
    const lineText = raw.replace(/\s+#.*$/, "").trim();
    const header = /^\[([^[\]]+)\]$/.exec(lineText);
    if (header) {
      section = tomlPath(header[1]);
      single = null;
      const at = section.findIndex((one) => KINDS[one]);
      if (section[0] !== "workspace" && at >= 0 && at === section.length - 2) {
        single = { name: section.at(-1), kind: KINDS[section[at]] };
        add(single.name, single.kind);
      }
      continue;
    }
    const pair = /^("[^"]+"|'[^']+'|[A-Za-z0-9_.-]+)\s*=\s*(.*)$/.exec(lineText);
    if (!pair) continue;
    const key = unquoted(pair[1]);
    if (section.length === 1 && section[0] === "package") {
      if (key === "license") licence = unquoted(pair[2]);
      if (key === "license-file") licenceFile = true;
      continue;
    }
    if (single) {
      if (key === "package") {
        kinds.get(single.name).delete(single.kind);
        single = { name: unquoted(pair[2]), kind: single.kind };
        add(single.name, single.kind);
      }
      continue;
    }
    const kind = section[0] !== "workspace" && KINDS[section.at(-1)];
    if (!kind) continue;
    const renamed = /package\s*=\s*"([^"]+)"/.exec(pair[2]);
    add(renamed ? renamed[1] : key.split(".")[0], kind);
  }
  return { licence: licence ?? (licenceFile ? "a licence file" : null), kinds };
}

function lockPackages(text) {
  return String(text).split(/^\[\[package\]\]\s*$/m).slice(1).map((block) => {
    const field = (name) => new RegExp(`^${name}\\s*=\\s*"([^"]*)"`, "m").exec(block)?.[1] ?? null;
    const listed = /^dependencies\s*=\s*\[([\s\S]*?)\]/m.exec(block)?.[1] ?? "";
    return { name: field("name"), version: field("version"), source: field("source"),
      deps: [...listed.matchAll(/"([^"]+)"/g)].map((one) => one[1].split(" ")) };
  }).filter((one) => one.name);
}

function registryManifest(cargoHome, name, version) {
  const at = join(cargoHome, "registry", "src");
  let indexes = [];
  try {
    indexes = readdirSync(at);
  } catch {
    return null;
  }
  for (const index of indexes) {
    try {
      return readFileSync(join(at, index, `${name}-${version}`, "Cargo.toml"), "utf8");
    } catch {
      continue;
    }
  }
  return null;
}

function cratesIn(root, target, { cargoHome = process.env.CARGO_HOME || join(require("node:os").homedir(), ".cargo") } = {}) {
  const lockDir = dirname(join(root, target));
  const locked = lockPackages(readFileSync(join(root, target), "utf8"));
  const byName = new Map();
  for (const one of locked) byName.set(one.name, [...(byName.get(one.name) ?? []), one]);
  const resolveDep = ([name, version]) => (byName.get(name) ?? []).find((one) => !version || one.version === version) ?? null;
  const own = new Map();
  for (const path of filesOf(lockDir)) {
    if (basename(path) !== "Cargo.toml") continue;
    const text = readFileSync(path, "utf8");
    const name = /^\[package\][\s\S]*?^name\s*=\s*"([^"]+)"/m.exec(text)?.[1];
    if (name) own.set(name, manifestOf(text));
  }
  const members = locked.filter((one) => !one.source);
  const found = new Map();
  const unread = new Set();
  const seen = new Set();
  const queue = members.map((one) => ({ one, from: null }));
  while (queue.length > 0) {
    const { one, from } = queue.shift();
    const key = `${one.name} ${one.version}`;
    if (seen.has(key)) continue;
    seen.add(key);
    const member = !one.source;
    const text = member ? null : String(one.source).startsWith("registry+") ? registryManifest(cargoHome, one.name, one.version) : null;
    const manifest = member ? own.get(one.name) ?? null : text === null ? null : manifestOf(text);
    if (!member) {
      if (manifest === null) unread.add(key);
      found.set(key, { Name: one.name, Version: one.version, Relationship: from && !from.source ? "direct" : "indirect",
        Licenses: manifest?.licence ? [manifest.licence] : [] });
    }
    for (const dep of one.deps) {
      const next = resolveDep(dep);
      if (!next) continue;
      const kinds = manifest?.kinds.get(next.name);
      if (manifest && !(kinds?.has("normal"))) continue;
      queue.push({ one: next, from: one });
    }
  }
  return { Class: "lang-pkgs", Target: target, Type: "cargo", Packages: [...found.values()], Unread: [...unread] };
}

function withAnswers(lockfile, answered) {
  const own = (one) => !["root", "workspace"].includes(String(one.Relationship ?? "").toLowerCase());
  const unread = new Set(lockfile.Unread ?? []);
  const had = Boolean(lockfile.Unread) || (lockfile.Packages ?? []).some((one) => (one.Licenses ?? []).length > 0);
  let found = 0;
  const Packages = (lockfile.Packages ?? []).map((one) => {
    if ((one.Licenses ?? []).length > 0 && !unread.has(`${one.Name} ${one.Version}`)) return one;
    const held = answered(lockfile, one.Name, one.Version);
    if (!held) return one;
    found += 1;
    unread.delete(`${one.Name} ${one.Version}`);
    return { ...one, Licenses: held };
  });
  if (found === 0) return lockfile;
  const Unread = had ? [...unread] : Packages.filter((one) => own(one) && (one.Licenses ?? []).length === 0).map((one) => `${one.Name} ${one.Version}`);
  return { ...lockfile, Packages, ...(had && !lockfile.Unread ? {} : { Unread }) };
}

function licences(out, files, crates = [], answers = []) {
  const repository = new Set(files);
  const replaced = new Set(crates.map((one) => one.Target));
  const answered = answersFor(answers);
  const lockfiles = [...(JSON.parse(out || "{}").Results ?? [])
    .filter((one) => one.Class === "lang-pkgs" && repository.has(one.Target) && !replaced.has(one.Target)), ...crates]
    .map((one) => withAnswers(one, answered));
  const unreadOf = (one) => new Set(one.Unread ?? []);
  const read = lockfiles.filter((one) => (one.Packages ?? []).some((each) => (each.Licenses ?? []).length > 0 ||
    (one.Unread && !unreadOf(one).has(`${each.Name} ${each.Version}`))));
  const unread = [...lockfiles.filter((one) => !read.includes(one)).map((one) => one.Target),
    ...read.flatMap((one) => (one.Unread ?? []).map((crate) => `${crate} in ${one.Target}`))];
  const restricted = [];
  const bare = [];
  let total = 0;
  for (const lockfile of read) {
    const missing = unreadOf(lockfile);
    for (const one of lockfile.Packages ?? []) {
      const relation = String(one.Relationship ?? "").toLowerCase();
      if (["root", "workspace"].includes(relation) || missing.has(`${one.Name} ${one.Version}`)) continue;
      total += 1;
      const held = one.Licenses ?? [];
      const named = `${one.Name} ${one.Version ?? ""}`.trim();
      if (held.length === 0) {
        if (relation !== "indirect") bare.push({ named, lockfile: lockfile.Target, package: { name: one.Name, version: one.Version ?? "", licence: null } });
        continue;
      }
      const grades = held.map(licenceGrade);
      if (grades.includes(null)) continue;
      const grade = grades.reduce((mildest, each) => (ranked(each) < ranked(mildest) ? each : mildest));
      restricted.push({ named: `${named} (${held.join(", ")})`, grade, lockfile: lockfile.Target, package: { name: one.Name, version: one.Version ?? "", licence: held.join(", ") } });
    }
  }
  const at = (list) => ({ path: [...new Set(list.map((one) => one.lockfile))].join(", ") });
  const findings = [];
  if (restricted.length > 0) {
    findings.push({ key: "licence:restricted", phase: "licence", at: at(restricted),
      severity: restricted.map((one) => one.grade).reduce((worst, one) => (ranked(one) > ranked(worst) ? one : worst)),
      title: "Dependencies under a restrictive licence", packages: restricted.map((one) => one.package),
      body: `${restricted.length} of the ${total} production dependencies ${restricted.length === 1 ? "is" : "are"} under a licence that can oblige the product to share its own code: ${listedUpTo(restricted.map((one) => one.named))}.` }); // say:allow: report,a scanner result printed in the reports
  }
  const inCode = (JSON.parse(out || "{}").Results ?? []).filter((one) => one.Class === "license-file")
    .flatMap((one) => one.Licenses ?? [])
    .filter((one) => repository.has(one.FilePath) && !/^(licen[cs]e|copying)/i.test(one.FilePath))
    .map((one) => ({ path: one.FilePath, name: one.Name, grade: licenceGrade(one.Name) }))
    .filter((one) => one.grade !== null);
  if (inCode.length > 0) {
    findings.push({ key: "licence:in-code", phase: "licence", at: { path: [...new Set(inCode.map((one) => one.path))].join(", ") },
      severity: inCode.map((one) => one.grade).reduce((worst, one) => (ranked(one) > ranked(worst) ? one : worst)),
      title: "Code in the repository under a restrictive licence",
      body: `${inCode.length === 1 ? "A file in the repository carries" : `${inCode.length} files in the repository carry`} a licence that can oblige the product to share its own code: ${listedUpTo(inCode.map((one) => `${one.path} (${one.name})`))}.` }); // say:allow: report,a scanner result printed in the reports
  }
  if (bare.length > 0) {
    findings.push({ key: "licence:unknown", phase: "licence", severity: "medium", at: at(bare),
      title: "Dependencies declaring no licence", packages: bare.map((one) => one.package),
      body: `${bare.length} of the production dependencies the repository names itself ${bare.length === 1 ? "declares" : "declare"} no licence: ${listedUpTo(bare.map((one) => one.named))}.` }); // say:allow: report,a scanner result printed in the reports
  }
  const fetch = lockfiles.filter((one) => basename(one.Target) === "Cargo.lock" && (!read.includes(one) || (one.Unread ?? []).length > 0))
    .map((one) => dirname(one.Target));
  return { findings, lockfiles: lockfiles.length, read: read.length, unread, fetch };
}

function lookedUp(path) {
  const list = JSON.parse(readFileSync(path, "utf8"));
  const override = process.env.EVALATION_LOOKUP_CMD;
  const [command, ...args] = override ? override.split(/\s+/) : [process.execPath, join(__dirname, "..", "lib", "lookup.js")];
  const sent = `${list.length} package${list.length === 1 ? "" : "s"}`;
  let answers;
  try {
    answers = JSON.parse(execFileSync(command, args,
      { input: JSON.stringify(list), encoding: "utf8", maxBuffer: 64 * 1024 * 1024, timeout: 300_000, stdio: ["pipe", "pipe", "ignore"] }) || "[]");
  } catch (thrown) {
    return { answers: [], said: line("ev-run.lookup-failed", { sent }), failed: String(thrown.message ?? thrown).split("\n")[0] };
  }
  const found = answers.filter((one) => (one.licences ?? []).length > 0).length;
  return { answers, said: line("ev-run.lookup-done", { found: String(found), sent }) };
}

const fetchSaid = (folders) => folders.map((folder) => (folder === "." ? line("ev-run.cargo-fetch-top") : line("ev-run.cargo-fetch", { folder })));

const BY_PHASE = {
  licence: {
    trivy: {
      phase: "licence",
      argv: (target) => ["fs", "--scanners", "license", "--license-full", "--list-all-pkgs", "--format", "json", "--quiet", target],
      read: (out, root, held = {}) => {
        const files = filesOf(root).map((one) => inRepository(root, one));
        const sent = held.lookup ? lookedUp(held.lookup) : null;
        const said = licences(out, files, files.filter((one) => basename(one) === "Cargo.lock").map((one) => cratesIn(root, one)), sent?.answers ?? []);
        const told = sent ? { looked_up: sent.said, ...(sent.failed ? { lookup_failed: sent.failed } : {}) } : {};
        if (said.lockfiles === 0 && said.findings.length === 0) return { skipped: "no-lockfile", why: "the repository holds no dependency lockfile to read licences from" };
        if (said.lockfiles === 0) return { findings: said.findings, unread: [], ...told, measures: ["licence:in-code"], why: "the repository holds no dependency lockfile to read dependency licences from" };
        const todo = fetchSaid(said.fetch);
        if (said.read === 0 && said.findings.length === 0) return { skipped: "not-installed", why: [`no dependency licences could be read from ${said.unread.join(", ")}, since the dependencies are not installed here.`, ...todo].join(" ").replace(/\.$/, "") };
        return { findings: said.findings, unread: said.unread, ...told, ...(todo.length > 0 ? { todo } : {}), ...(said.read === 0 ? { measures: ["licence:in-code"] } : {}),
          ...(said.unread.length > 0 ? { why: `licences not read for ${said.unread.length > 5 ? `${said.unread.slice(0, 5).join(", ")} and ${said.unread.length - 5} more` : said.unread.join(", ")}, since those dependencies are not installed here${sent ? " and deps.dev gave no licence for them" : ""}` } : {}) };
      },
    },
  },
};

const adapterFor = (phase, tool) => BY_PHASE[phase]?.[tool] ?? (ADAPTERS[tool]?.phase === phase ? ADAPTERS[tool] : null);
const knownTool = (tool) => Boolean(ADAPTERS[tool]) || Object.values(BY_PHASE).some((one) => one[tool]);

const botAccount = (name, address) =>
  /\[bot\]/.test(name) || /\[bot\]@/.test(address) || /^bot@/.test(address) || /(^|[\s_-])bot$/.test(name);

/**
 * The person behind each commit's author, or null for a bot. Addresses sharing an author name are one
 * person, since one person commonly commits from a work address and a code host's private address.
 */
function people(authors) {
  const root = new Map();
  const find = (key) => {
    while (root.get(key) !== key) key = root.get(key);
    return key;
  };
  const join = (a, b) => {
    for (const key of [a, b]) if (!root.has(key)) root.set(key, key);
    root.set(find(a), find(b));
  };
  const keys = authors.map(({ name = "", address = "" }) => {
    const [named, at] = [name.trim().toLowerCase(), address.trim().toLowerCase()];
    if (botAccount(named, at)) return null;
    join(`@${at}`, named ? `=${named}` : `@${at}`);
    return `@${at}`;
  });
  return keys.map((one) => one && find(one));
}

const PUBLIC_MAIL = new Set(["gmail.com", "googlemail.com", "outlook.com", "hotmail.com", "live.com", "msn.com", "yahoo.com",
  "icloud.com", "me.com", "mac.com", "aol.com", "proton.me", "protonmail.com", "pm.me", "gmx.com", "gmx.net", "gmx.de", "mail.com",
  "yandex.com", "yandex.ru", "qq.com", "163.com", "126.com", "fastmail.com", "hey.com", "zoho.com", "tutanota.com", "web.de"]);
const domainOf = (address) => String(address).trim().toLowerCase().split("@")[1] ?? "";
const privateAddress = (address) => /(^|[.+@])noreply\b/.test(String(address).toLowerCase());
const nobodysDomain = (domain) => !domain.includes(".") || PUBLIC_MAIL.has(domain) || /\.(local|lan|localdomain|internal|home)$/.test(domain) ||
  /(^|\.)noreply\./.test(domain);
const atCompany = (address, domains) => !privateAddress(address) &&
  domains.some((one) => (one.includes("@") ? String(address).trim().toLowerCase() === one.toLowerCase()
    : domainOf(address) === one.toLowerCase() || domainOf(address).endsWith(`.${one.toLowerCase()}`)));

function everyone(authors) {
  const who = people(authors);
  const held = new Map();
  authors.forEach((one, at) => {
    if (!who[at]) return;
    if (!held.has(who[at])) held.set(who[at], { name: one.name.trim(), addresses: new Set(), commits: 0 });
    const person = held.get(who[at]);
    person.addresses.add(one.address.trim().toLowerCase());
    person.commits += 1;
  });
  return [...held.values()].map((one) => ({ ...one, addresses: [...one.addresses].sort() }));
}

function outsiders(authors, domains) {
  const all = everyone(authors);
  const outside = all.filter((one) => !one.addresses.some((address) => atCompany(address, domains)))
    .map((one) => ({ name: one.name || one.addresses[0], addresses: one.addresses, commits: one.commits,
      ...(one.addresses.every(privateAddress) ? { why: "commits only through a code host's private address, so cannot be shown to be staff" } : {}) }))
    .sort((a, b) => b.commits - a.commits || a.name.localeCompare(b.name));
  if (outside.length === 0) return null;
  return { key: "history:outside-contributors", phase: "history", severity: "low", at: { path: "git history" }, names_people: true,
    title: "People outside the company who committed",
    body: `${outside.length} of the ${all.length} people who ever committed have no commit address at ${domains.join(" or ")}.`, // say:allow: report,a scanner result printed in the reports
    people: outside };
}

function domainChoices(authors, signedIn = null) {
  const address = String(signedIn ?? "").trim().toLowerCase();
  const own = address.includes("@") ? (nobodysDomain(domainOf(address)) ? address : domainOf(address)) : null;
  const counts = new Map();
  for (const one of everyone(authors)) {
    for (const domain of new Set(one.addresses.filter((address) => !privateAddress(address)).map(domainOf))) {
      if (nobodysDomain(domain)) continue;
      const held = counts.get(domain) ?? { people: 0, commits: 0 };
      counts.set(domain, { people: held.people + 1, commits: held.commits + one.commits });
    }
  }
  const seen = [...counts].filter(([domain]) => domain !== own)
    .sort((a, b) => b[1].people - a[1].people || b[1].commits - a[1].commits || a[0].localeCompare(b[0]));
  return [
    ...(own ? [{ domain: own, description: line("ev-run.domain-sign-in") }] : []),
    ...seen.map(([domain, held]) => ({ domain, description: held.people === 1 ? line("ev-run.domain-person")
      : line("ev-run.domain-people", { count: String(held.people) }) })),
  ].slice(0, 6);
}

function authorsOver(root, solution) {
  const roots = solution ? solution.repositories.filter((one) => one.vcs === "git").map((one) => join(root, one.folder)) : [root];
  return roots.flatMap((at) => {
    try {
      return execFileSync("git", ["-C", at, "log", "--no-merges", "--format=%aN%x1f%aE"], { encoding: "utf8", maxBuffer: 256 * 1024 * 1024, stdio: ["ignore", "pipe", "ignore"] })
        .split("\n").filter(Boolean).map((one) => {
          const [name, address] = one.split("\x1f");
          return { name, address };
        });
    } catch {
      return [];
    }
  });
}

/**
 * How concentrated the last twelve months of commits are in one person, from one author per line of
 * git log, as a name and an address split by \x1f, or an address alone. Only the shares are kept: a
 * name or an address is somebody's personal data and says nothing a buyer needs. One person holding
 * most of the work is the risk a buyer asks about.
 */
function authorship(out) {
  const authors = String(out).split("\n").filter((one) => one.trim()).map((line) => {
    const [name, address] = line.includes("\x1f") ? line.split("\x1f") : ["", line];
    return { name, address };
  });
  const counts = new Map();
  for (const one of people(authors).filter(Boolean)) counts.set(one, (counts.get(one) ?? 0) + 1);
  const total = [...counts.values()].reduce((sum, one) => sum + one, 0);
  const at = { path: "git history" };
  if (total === 0) {
    return [{ key: "history:quiet", phase: "history", severity: "medium", title: "No commits in a year", at,
      body: "No commits in the last twelve months, so nobody has changed this code for a year." }]; // say:allow: report,a scanner result printed in the reports
  }
  const share = Math.round((Math.max(...counts.values()) / total) * 100);
  const severity = counts.size === 1 || share >= 80 ? "high" : share >= 50 ? "medium" : null;
  if (!severity) return [];
  return [{
    key: "history:concentration", phase: "history", severity, at,
    title: counts.size === 1 ? "Every commit made by one person" : "Most commits made by one person",
    body: `Of ${total} commits in the last twelve months, the most active person made ${share}% of them, across ${counts.size} ${counts.size === 1 ? "person" : "people"}.`, // say:allow: report,a scanner result printed in the reports
  }];
}

/** The history phase, read from the checkout itself, since the copy the other tools read has none. */
function history(root, isRepository, named) {
  if (!named.enabled) return { phase: "history", tool: "git", ran: false, reason: "off", why: "it is turned off", findings: [] };
  if (!isRepository) return { phase: "history", tool: "git", ran: false, reason: "no-history", why: "the target has no git history", findings: [] };
  try {
    const git = (...args) => execFileSync("git", ["-C", root, ...args],
      { encoding: "utf8", maxBuffer: 256 * 1024 * 1024, stdio: ["ignore", "pipe", "ignore"] });
    const commits = git("log", "--since=12 months ago", "--no-merges", "--format=%x1e%aI%x1f%aE%x1f%aN%x1f%B%x1d", "--name-only")
      .split("\x1e").filter((one) => one.trim()).map((one) => {
        const [head, files = ""] = one.split("\x1d");
        const [at, address, name, message] = head.split("\x1f");
        return { at, address, name, message, files: files.split("\n").filter(Boolean) };
      });
    const who = people(commits);
    const byPeople = commits.map((one, n) => ({ ...one, who: who[n] })).filter((one) => one.who);
    const tags = git("for-each-ref", "refs/tags", "--format=%(creatordate:iso-strict)").split("\n").filter(Boolean);
    const tracked = git("ls-files").split("\n").filter(Boolean);
    const now = Date.now();
    return { phase: "history", tool: "git", ran: true,
      findings: [...authorship(commits.map((one) => `${one.name}\x1f${one.address}`).join("\n")), ...measured({ commits: byPeople, tags, tracked, now }),
        ...practices({ commits: byPeople, source: markersIn(root, tracked) })] };
  } catch (thrown) {
    return { phase: "history", tool: "git", ran: false, reason: "failed", why: `git could not read the history: ${thrown.message}`, findings: [] };
  }
}

function placed(found, one) {
  const area = String(found.key).startsWith("history:area:");
  return {
    ...found,
    key: area ? `history:area:${one.folder}/${found.key.slice("history:area:".length)}` : `${found.key}:${one.folder}`,
    at: { ...found.at, path: `${one.folder}/${found.at?.path ?? ""}` },
    title: area
      ? `${String(found.title).split(" in ")[0]} in ${one.repository}, ${found.key.slice("history:area:".length)}`
      : `${found.title} in ${one.repository}`,
  };
}

function historyAcross(root, solution, named) {
  const held = solution.repositories.filter((one) => one.vcs === "git");
  if (held.length === 0) return history(root, false, named);
  const each = held.map((one) => ({ one, said: history(join(root, one.folder), true, named) }));
  const ran = each.filter(({ said }) => said.ran);
  const missed = each.filter(({ said }) => !said.ran);
  if (ran.length === 0) return { phase: "history", tool: "git", ran: false, reason: missed[0].said.reason, why: missed.map(({ one, said }) => `${one.repository}: ${said.why}`).join("; "), findings: [] };
  return {
    phase: "history", tool: "git", ran: true,
    ...(missed.length > 0 ? { why: `not read in ${missed.map(({ one, said }) => `${one.repository} (${said.why})`).join(", ")}`, unread: missed.map(({ one }) => one.repository) } : {}),
    findings: ran.flatMap(({ one, said }) => said.findings.map((found) => placed(found, one))),
  };
}

function secretAcross(root, solution, named, held, copy) {
  const each = solution.repositories.map((one) => {
    const git = one.vcs === "git";
    const said = runPhase("secret", named, join(git ? root : copy, one.folder), git, held);
    const findings = said.findings.map((found) => {
      const path = `${one.folder}/${found.at?.path ?? ""}`;
      return {
        ...found,
        key: String(found.key).replace(`:${found.at?.path}:`, `:${path}:`),
        title: String(found.title).replace(` in ${found.at?.path}`, ` in ${path}`),
        at: { ...found.at, path },
      };
    });
    return { one, said: { ...said, findings } };
  });
  const ran = each.filter(({ said }) => said.ran);
  if (ran.length === 0) return { ...each[0].said, findings: [] };
  const missed = each.filter(({ said }) => !said.ran);
  return {
    ...ran[0].said,
    ...(missed.length > 0 ? { why: `not read in ${missed.map(({ one, said }) => `${one.repository} (${said.why})`).join(", ")}`, unread: missed.map(({ one }) => one.repository) } : {}),
    findings: ran.flatMap(({ said }) => said.findings),
  };
}

const DAY = 86400000;

/**
 * What a year of history says beyond who wrote it, each a number with a threshold: how often the team
 * tagged a release, which top-level areas nobody changed, which rest on one person, and whether the
 * last three months ran at under half the pace of the nine before.
 */
function measured({ commits, tags, tracked, now }) {
  const found = [];
  const within = (at, days) => now - Date.parse(at) <= days * DAY;
  const releases = tags.filter((at) => within(at, 365)).length;
  if (releases < 4) {
    found.push({ key: "history:releases", phase: "history", severity: releases === 0 ? "medium" : "low", at: { path: "git tags" },
      title: releases === 0 ? "No releases tagged in a year" : "Few releases tagged in a year",
      body: `${releases} ${releases === 1 ? "release was" : "releases were"} tagged in the last twelve months.` });
  }
  const areaOf = (path) => (path.includes("/") ? path.split("/")[0] : null);
  const areas = [...new Set(tracked.map(areaOf).filter(Boolean))].sort();
  const touched = new Map(areas.map((one) => [one, []]));
  for (const one of commits) {
    for (const area of new Set(one.files.map(areaOf).filter(Boolean))) touched.get(area)?.push(one.who);
  }
  const dormant = areas.filter((one) => touched.get(one).length === 0);
  if (dormant.length > 0) {
    found.push({ key: "history:dormant", phase: "history", severity: "low", at: { path: "git history" },
      title: "Areas nobody changed in a year",
      body: `Nobody changed ${dormant.slice(0, 6).join(", ")}${dormant.length > 6 ? ` or ${dormant.length - 6} more` : ""} in the last twelve months.` }); // say:allow: report,a scanner result printed in the reports
  }
  for (const [area, who] of touched) {
    if (who.length < 10) continue;
    const counts = new Map();
    for (const one of who) counts.set(one, (counts.get(one) ?? 0) + 1);
    const share = Math.round((Math.max(...counts.values()) / who.length) * 100);
    if (share >= 80) {
      found.push({ key: `history:area:${area}`, phase: "history", severity: "medium", at: { path: area },
        title: `An area resting on one person in ${area}`,
        body: `Of ${who.length} commits to ${area} in the last twelve months, one person made ${share}% of them.` }); // say:allow: report,a scanner result printed in the reports
    }
  }
  const recent = commits.filter((one) => within(one.at, 90)).length / 3;
  const before = commits.filter((one) => !within(one.at, 90) && within(one.at, 365)).length / 9;
  if (before >= 4 && recent < before / 2) {
    found.push({ key: "history:slowing", phase: "history", severity: "medium", at: { path: "git history" },
      title: "Changes slowed in the last three months",
      body: `The last three months ran at ${Math.round(recent)} commits a month, down from ${Math.round(before)} a month in the nine before.` }); // say:allow: report,a scanner result printed in the reports
  }
  return found;
}

const TEST_FOLDER = /^(tests?|__tests__|specs?|e2e|testing)$/i;
const TEST_NAME = [/[._-](test|spec)s?\.[^.]+$/i, /^test[_-]/i, /(Test|Tests|Spec)\.[^.]+$/];
const isTest = (path) => {
  const parts = path.split("/");
  return parts.slice(0, -1).some((one) => TEST_FOLDER.test(one)) || TEST_NAME.some((one) => one.test(parts.at(-1)));
};
const isSource = (path, head = "") => !path.split("/").some(skipped) && languageOf(path, head)?.type === "programming";
const MARKER = /\b(TODO|FIXME|HACK|XXX)\b/;
const TICKET = /(^|[^\w&])#\d+\b|\b[A-Z][A-Z0-9]{1,9}-\d+\b/;
const unsquashed = (message) => {
  const [subject, ...rest] = String(message ?? "").split("\n");
  return [subject.replace(/\s*\(#\d+\)\s*$/, ""), ...rest].join("\n");
};
const REVERT =/^Revert\b|This reverts commit [0-9a-f]{7,}/m;

function markersIn(root, tracked) {
  const attributes = attributesOf(root, tracked);
  let lines = 0;
  let markers = 0;
  for (const path of tracked) {
    if (path.split("/").some(skipped) || !languageOf(path, "")) continue;
    const full = join(root, path);
    let text;
    try {
      if (statSync(full).size >= 2_000_000) continue;
      text = readFileSync(full, "utf8");
    } catch {
      continue;
    }
    const head = text.slice(0, 65536);
    if (!counted(path, head, attributes.get(path)) || !isSource(path, head)) continue;
    const held = text.split("\n");
    if (held.at(-1) === "") held.pop();
    lines += held.length;
    markers += held.filter((one) => MARKER.test(one)).length;
  }
  return { lines, markers };
}

function practices({ commits, source }) {
  const found = [];
  const total = commits.length;
  const share = (part, whole) => Math.round((part / whole) * 100);
  const at = { path: "git history" };
  if (total > 0) {
    const last = new Map();
    for (const one of commits) last.set(one.who, Math.max(last.get(one.who) ?? 0, Date.parse(one.at)));
    const newest = Math.max(...last.values());
    const gone = new Set([...last].filter(([, when]) => newest - when > 90 * DAY).map(([who]) => who));
    const theirs = commits.filter((one) => gone.has(one.who)).length;
    if (theirs / total >= 0.25) {
      found.push({ key: "history:departed", phase: "history", severity: theirs / total >= 0.5 ? "high" : "medium", at,
        title: "Much of the work made by people no longer committing",
        body: `Of ${total} commits in the last twelve months, ${share(theirs, total)}% were made by ${gone.size} of ${last.size} people with no commit in the three months before the newest commit.` }); // say:allow: report,a scanner result printed in the reports
    }
    const ticketed = commits.filter((one) => TICKET.test(unsquashed(one.message))).length;
    if (ticketed / total < 0.5) {
      found.push({ key: "history:tickets", phase: "history", severity: "low", at,
        title: "Few changes name the ticket they answer",
        body: `Of ${total} commits in the last twelve months, ${share(ticketed, total)}% name a ticket in their message, such as #123 or ABC-123.` }); // say:allow: report,a scanner result printed in the reports
    }
    const reverted = commits.filter((one) => REVERT.test(one.message ?? "")).length;
    if (reverted / total >= 0.05) {
      found.push({ key: "history:reverts", phase: "history", severity: reverted / total >= 0.1 ? "medium" : "low", at,
        title: "Changes often undone",
        body: `Of ${total} commits in the last twelve months, ${reverted} undid an earlier one, ${share(reverted, total)}% of them.` }); // say:allow: report,a scanner result printed in the reports
    }
  }
  const changing = commits.filter((one) => one.files.some((path) => isSource(path) && !isTest(path)));
  const tested = changing.filter((one) => one.files.some(isTest)).length;
  if (changing.length > 0 && tested / changing.length < 0.2) {
    found.push({ key: "history:tests", phase: "history", severity: "medium", at,
      title: "Code changed without its tests",
      body: `Of ${changing.length} commits changing source code in the last twelve months, ${share(tested, changing.length)}% also changed a test file.` }); // say:allow: report,a scanner result printed in the reports
  }
  const rate = source.lines > 0 ? (source.markers / source.lines) * 1000 : 0;
  if (rate > 2) {
    found.push({ key: "history:markers", phase: "history", severity: rate > 5 ? "medium" : "low", at: { path: "tracked source" },
      title: "Unfinished work marked in the code",
      body: `The tracked source holds ${source.markers} lines marked TODO, FIXME, HACK or XXX in ${source.lines} lines, ${rate.toFixed(1)} per thousand lines.` }); // say:allow: report,a scanner result printed in the reports
  }
  return found;
}

/** What the tree was before and after, where git can say. A scan that moved anything is a scan that changed what it measured. */
function witness(target) {
  try {
    return execFileSync("git", ["-C", target, "status", "--porcelain"],
      { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
  } catch {
    return null;
  }
}

/**
 * One phase. Returns what it found and how it went, and never both a skip and a finding: a phase
 * that could not run has no opinion about the repository.
 */
function runPhase(phase, named, target, isRepository, held) {
  const override = process.env[`EVALATION_${phase.toUpperCase()}_CMD`];
  const adapter = adapterFor(phase, named.tool);

  if (!named.enabled) return { phase, tool: named.tool, ran: false, reason: "off", why: "it is turned off", findings: [] };
  if (!override) {
    // Why it did not run, in the words a person reading the report will be given. A declined install
    // is a decision somebody made and reads as one, a failed install is not a decision, and a
    // report that flattens them says less than either.
    if (!onThisMachine(named.tool)) {
      return {
        phase,
        tool: named.tool,
        ran: false,
        reason: missingReason(named.tool, held),
        why: missingWhy(named.tool, held),
        ...(held.declined.includes(named.tool) && !held.could_not_install[named.tool]
          ? { declined_on: spoken(held.declined_on[named.tool]) } : {}),
        findings: [],
      };
    }
    if (!adapter) {
      return { phase, tool: named.tool, ran: false, reason: "no-adapter", why: `this build knows no adapter for ${named.tool}`, findings: [] };
    }
  }

  let scratch = null;
  try {
    let out;
    if (override) {
      // The seam a test drives: the command prints findings in the shape above and this reads them
      // as they are. Split on spaces and run as argv, so nothing reaches a shell here either.
      const [command, ...args] = override.split(/\s+/);
      out = execFileSync(command, [...args, target],
        { encoding: "utf8", maxBuffer: 64 * 1024 * 1024, timeout: 600_000, stdio: ["ignore", "pipe", "ignore"] });
      return { phase, tool: override, ran: true, findings: JSON.parse(out || "[]") };
    }

    if (adapter.intoFile) {
      scratch = mkdtempSync(join(tmpdir(), "evalation-scan-"));
      const into = join(scratch, "found.json");
      execFileSync(named.tool, adapter.argv(target, into, isRepository),
        { stdio: ["ignore", "ignore", "ignore"], timeout: 600_000 });
      out = existsSync(into) ? readFileSync(into, "utf8") : "[]";
    } else {
      out = execFileSync(named.tool, adapter.argv(target, null, isRepository),
        { encoding: "utf8", maxBuffer: 64 * 1024 * 1024, timeout: 600_000, stdio: ["ignore", "pipe", "ignore"] });
    }

    // An adapter answers with findings, with an inventory, or with both. A list on its own is the
    // ordinary case and is read as findings.
    const answered = adapter.read(out, target, held);
    if (answered.skipped) return { phase, tool: named.tool, ran: false, reason: answered.skipped, why: answered.why, findings: [] };
    const found = (Array.isArray(answered) ? answered : answered.findings ?? [])
      .map((one) => ({ ...one, phase, tool: named.tool }));
    const inventory = Array.isArray(answered) ? null : answered.inventory ?? null;
    return { phase, tool: named.tool, ran: true, ...(answered.why ? { why: answered.why } : {}), ...(answered.measures ? { measures: answered.measures } : {}),
      ...(answered.looked_up ? { looked_up: answered.looked_up } : {}), ...(answered.lookup_failed ? { lookup_failed: answered.lookup_failed } : {}),
      ...(answered.unread?.length ? { unread: answered.unread } : {}), ...(answered.todo?.length ? { todo: answered.todo } : {}), findings: found, inventory };
  } catch (thrown) {
    // Said rather than swallowed, and with no findings, since a tool that fell over knows nothing
    // about this repository and a phase reported clean on a crash is the worst answer available.
    return {
      phase,
      tool: named.tool,
      ran: false,
      reason: "failed",
      why: `the tool did not finish: ${String(thrown.message ?? thrown).split("\n")[0]}`,
      findings: [],
    };
  } finally {
    if (scratch) rmSync(scratch, { recursive: true, force: true });
  }
}

/**
 * The phases a run asked for, from --phases a,b, or every phase where none is named. A phase no
 * selected pack reads is not run at all: a SOC 2 run building a bill of materials spends the time and
 * prints nothing of it.
 */
function asked(rest) {
  const at = rest.indexOf("--phases");
  if (at < 0) return { only: null, rest };
  const only = String(rest[at + 1] ?? "").split(",").map((one) => one.trim()).filter(Boolean);
  for (const one of only) {
    if (!DEFAULTS[one]) fail(`no phase ${JSON.stringify(one)}. The phases are ${Object.keys(DEFAULTS).join(", ")}.`);
  }
  return { only, rest: rest.filter((_, index) => index !== at && index !== at + 1) };
}

function domainsAsked(rest) {
  const at = rest.indexOf("--domains");
  if (at < 0) return { domains: [], rest };
  answered([String(rest[at + 1] ?? "")].filter((one) => one.trim()));
  return { domains: typedDomains(rest[at + 1]), rest: rest.filter((_, index) => index !== at && index !== at + 1) };
}

function typedDomains(typed) {
  return String(typed ?? "").split(/[\s,;]+/).map((one) => one.toLowerCase().replace(/^@+/, "")).filter(Boolean);
}

function withOutsiders(said, authors, domains) {
  if (!said.ran || domains.length === 0) return said;
  const found = outsiders(authors, domains);
  return { ...said, domains, measures: [...MEASURES.history, "history:outside-contributors"], findings: [...said.findings, ...(found ? [found] : [])] };
}

function scan(target, only = null, { domains = [], lookup = null } = {}) {
  const root = resolve(target);
  try {
    if (!statSync(root).isDirectory()) fail(`${target} is not a directory`);
  } catch {
    fail(`no-such-target: ${target} is not a directory this machine can read`);
  }

  const held = phases();
  const isRepository = existsSync(join(root, ".git"));
  const solution = isRepository ? null : solutionOf(root);
  const watched = () => (solution
    ? solution.repositories.filter((one) => one.vcs === "git").map((one) => `${one.folder}\n${witness(join(root, one.folder)) ?? ""}`).join("\n")
    : witness(root));
  const before = watched();

  // The tools read a directory, and handed the checkout they read everything in it: a customer run
  // counted one advisory 34 times, once for the repository and once for each editor worktree
  // checked out inside it. So they read a copy holding the repository's files and nothing else. The
  // secret scan of a git checkout reads its history, which is the repository's own.
  const copy = copied(root);
  let ran;
  try {
    ran = Object.entries(held.phases)
      .filter(([phase]) => !only || only.includes(phase))
      .map(([phase, named]) => (phase === "history"
        ? withOutsiders(solution ? historyAcross(root, solution, named) : history(root, isRepository, named), authorsOver(root, solution), domains)
        : phase === "secret" && solution
        ? secretAcross(root, solution, named, held, copy.path)
        : phase === "licence"
        ? runPhase(phase, named, root, isRepository, { ...held, lookup })
        : runPhase(phase, named, phase === "secret" && isRepository ? root : copy.path,
          phase === "secret" && isRepository, held)));
  } finally {
    copy.done();
  }

  const after = watched();
  if (before !== null && after !== null && before !== after) {
    stopped(line("ev-run.scan-changed"));
  }

  const all = ran.flatMap((one) => one.findings);
  const floor = ranked(held.floor);
  const kept = [];
  let below = 0;
  for (const one of all) {
    if (ranked(one.severity) >= floor) {
      kept.push(one);
      continue;
    }
    below += 1;
    // Below the floor and a dependency nobody here chose. Kept where it is the repository's own, so
    // a quiet finding in a direct dependency is still the repository's to answer.
    if (!(held.drop_transitive_below_floor && one.transitive)) kept.push(one);
  }
  kept.sort((a, b) => ranked(b.severity) - ranked(a.severity) || a.key.localeCompare(b.key));

  const document = {
    schema: "evalation.scan.v1",
    at: new Date().toISOString(),
    target: { path: root, name: basename(root), git: isRepository },
    floor: held.floor,
    witnessed: before !== null,
    phases: ran.map(({ findings, inventory, ...said }) => ({
      ...said,
      ...(said.ran ? { measures: said.measures ?? MEASURES[said.phase] ?? [said.phase] } : {}),
      found: findings.length,
      ...(inventory ? { inventory } : {}),
    })),
    below_floor: below,
    findings: kept,
  };

  mkdirSync(SCANS, { recursive: true, mode: 0o700 });
  const path = join(SCANS, `${document.at.replace(/[:.]/g, "-")}-${basename(root)}.json`);
  writeFileSync(path, `${JSON.stringify(document, null, 2)}\n`);
  return { path, document };
}

const BREAKS = new RegExp(`\\s*[;${String.fromCharCode(0x2013, 0x2014)}]\\s*`, "g");

function offered(held, only) {
  const { entries, say } = require("../lib/say.js");
  const wanted = Object.entries(held.phases).filter(([phase, named]) => (!only || only.includes(phase)) && named.enabled !== false);
  const missing = wanted.filter(([, named]) => !onThisMachine(named.tool)).map(([phase, named]) => ({ phase, tool: named.tool }))
    .filter((one, at, all) => all.findIndex((each) => each.tool === one.tool) === at);
  if (missing.length === 0) {
    const names = [...new Set(wanted.map(([, named]) => nameOf(named.tool)))];
    if (names.length === 0) return { said: null, asks: null };
    return { asks: null, said: names.length === 1 ? line("ev-run.tool-installed", { tool: names[0] })
      : line("ev-run.tools-installed", { tools: `${names.slice(0, -1).join(", ")} and ${names.at(-1)}` }) };
  }
  if (!onThisMachine(BREW)) {
    return { asks: null, said: [line("ev-run.no-brew"), ...missing.map((one) => line("ev-run.tool-page", {
      tool: nameOf(one.tool), page: TOOLS[one.tool]?.page ?? installer(one.tool).said }))].join("\n") };
  }
  if (missing.length === 1) return { said: null, asks: JSON.parse(say(entries(), "ev-run.install-one", { tool: nameOf(missing[0].tool) })) };
  const plain = (text) => String(text).replace(BREAKS, ", ").replace(/\.$/, "");
  const described = (tool) => {
    const failed = held.could_not_install[tool];
    if (failed) return line("ev-run.tool-failed", { date: spoken(failed.on) ?? spoken(today()), why: plain(failed.why) });
    if (held.declined.includes(tool) && held.declined_on[tool]) return line("ev-run.tool-declined", { date: spoken(held.declined_on[tool]) });
    return line("ev-run.tool-installs");
  };
  return { said: null, asks: JSON.parse(say(entries(), "ev-run.tools", {}, missing.map((one) => ({
    label: offerOf(one.tool, one.phase), description: described(one.tool) })))) };
}

function show(only = null) {
  const held = phases();
  process.stdout.write(`${JSON.stringify({
    ...offered(held, only),
    floor: held.floor,
    drop_transitive_below_floor: held.drop_transitive_below_floor,
    declined: held.declined,
    can_install_with: onThisMachine(BREW) ? BREW : null,
    phases: Object.fromEntries(Object.entries(held.phases).filter(([phase]) => !only || only.includes(phase)).map(([phase, named]) => [phase, {
      ...named,
      on_this_machine: onThisMachine(named.tool),
      adapter: Boolean(adapterFor(phase, named.tool)) || phase === "history",
      declined: held.declined.includes(named.tool),
      declined_on: held.declined.includes(named.tool) ? spoken(held.declined_on[named.tool]) : null,
      could_not_install: held.could_not_install[named.tool]
        ? { ...held.could_not_install[named.tool], on: spoken(held.could_not_install[named.tool].on) } : null,
      install_with: onThisMachine(named.tool) ? null : installer(named.tool).said,
      offer: offerOf(named.tool, phase),
      install_page: TOOLS[named.tool]?.page ?? null,
    }])),
    tools_this_knows: Object.keys(ADAPTERS),
    at: SETTINGS,
  }, null, 2)}\n`);
}

/**
 * Fetches a tool this file knows, and nothing else. Only a name in the adapter table can reach the
 * package manager, so a grant over this verb is a grant over four fetches rather than over the
 * machine.
 */
function install(tools) {
  if (!onThisMachine(BREW)) {
    fail(`this build installs scanners with ${BREW}, which is not on this machine. Install the ` +
      `tools another way, or run the review without them and it will say what it did not check.`);
  }
  const done = [];
  for (const tool of tools) {
    if (!ADAPTERS[tool]) fail(`this build knows no tool called ${JSON.stringify(tool)}.`);
    const how = installer(tool);
    try {
      execFileSync(how.command, how.args, { stdio: ["ignore", "ignore", "pipe"], timeout: 900_000 });
      done.push(onThisMachine(tool)
        ? { tool, installed: true }
        : { tool, installed: false, why: `${BREW} finished but ${tool} is still not on the path` });
    } catch (thrown) {
      const said = String(thrown.stderr ?? "").split("\n").map((line) => line.trim()).filter(Boolean);
      done.push({ tool, installed: false, why: said.at(-1) ?? String(thrown.message ?? thrown).split("\n")[0] });
    }
  }
  const held = settings();
  const scan = held.scan ?? {};
  const failed = { ...(scan.could_not_install ?? {}) };
  const declinedOn = { ...(scan.declined_on ?? {}) };
  for (const one of done) {
    delete declinedOn[one.tool];
    if (one.installed) delete failed[one.tool];
    else failed[one.tool] = { why: one.why, on: today() };
  }
  const took = new Set(done.map((one) => one.tool));
  keep({ ...held, scan: { ...scan, declined: (scan.declined ?? []).filter((one) => !took.has(one)),
    declined_on: declinedOn, could_not_install: failed } });
  process.stdout.write(`${JSON.stringify({ installed: done }, null, 2)}\n`);
}

/** Written down with its date, because a person who said no has made a decision and the report names it as one. */
function decline(tools) {
  for (const tool of tools) {
    if (!ADAPTERS[tool]) fail(`this build knows no tool called ${JSON.stringify(tool)}.`);
  }
  const held = settings();
  const scan = held.scan ?? {};
  const failed = { ...(scan.could_not_install ?? {}) };
  const declinedOn = { ...(scan.declined_on ?? {}) };
  for (const tool of tools) {
    delete failed[tool];
    declinedOn[tool] = today();
  }
  keep({ ...held, scan: { ...scan, declined: [...new Set([...(scan.declined ?? []), ...tools])].sort(),
    declined_on: declinedOn, could_not_install: failed } });
  show();
}

const USAGE = `usage: evalation-scan <verb>

  show [--phases a,b]      what would run, what of it is on this machine, and how to get the rest
  install <tool ...>       fetch a scanner this build knows, with the person's yes
  decline <tool ...>       record that a scanner was not wanted, so the report can say so
  domains <target>         the question asking which email domains are the company's
  run <target> [--phases a,b] [--domains a.com,b.com]
                           scan a repository with those phases, or all, and write what they found
  set <phase> <tool|off>   name the tool for a phase, or turn the phase off
`;

function main() {
  const [verb, ...rest] = process.argv.slice(2);
  switch (verb ?? "show") {
    case "show":
      show(asked(rest).only);
      return;
    case "install":
      if (rest.length === 0) fail("usage: evalation-scan install <tool ...>");
      answered(rest);
      install(rest);
      return;
    case "decline":
      if (rest.length === 0) fail("usage: evalation-scan decline <tool ...>");
      answered(rest);
      decline(rest);
      return;
    case "domains": {
      if (!rest[0]) fail("usage: evalation-scan domains <target>");
      const root = resolve(rest[0]);
      const solution = existsSync(join(root, ".git")) ? null : solutionOf(root);
      const choices = domainChoices(authorsOver(root, solution), settings().signed_in_as);
      if (choices.length === 0) {
        process.stdout.write(`${JSON.stringify({ said: line("ev-run.domains-type"), asks: null }, null, 2)}\n`);
        return;
      }
      const { entries, say } = require("../lib/say.js");
      const asks = choices.length === 1 ? { only: choices[0].domain, ...JSON.parse(say(entries(), "ev-run.domains-one", { domain: choices[0].domain })) }
        : JSON.parse(say(entries(), "ev-run.domains", {}, choices.map((one) => ({ label: one.domain, description: one.description }))));
      process.stdout.write(`${JSON.stringify({ said: null, asks }, null, 2)}\n`);
      return;
    }
    case "lookup": {
      if (!rest[0]) fail("usage: evalation-scan lookup <target>");
      const root = resolve(rest[0]);
      const named = phases().phases.licence;
      if (!named?.enabled || named.tool !== "trivy" || !onThisMachine("trivy")) {
        process.stdout.write(`${JSON.stringify({ said: null, asks: null }, null, 2)}\n`);
        return;
      }
      const out = execFileSync("trivy", argvOf("licence", root),
        { encoding: "utf8", maxBuffer: 64 * 1024 * 1024, timeout: 600_000, stdio: ["ignore", "pipe", "ignore"] });
      const files = filesOf(root).map((one) => inRepository(root, one));
      const { send } = candidates(out, root, files.filter((one) => basename(one) === "Cargo.lock").map((one) => cratesIn(root, one)));
      process.stdout.write(`${JSON.stringify(send.length === 0 ? { said: null, asks: null } : lookupAsked(send, HOME), null, 2)}\n`);
      return;
    }
    case "open": {
      const folder = join(HOME, "lookups");
      const path = rest[0] ? resolve(rest[0]) : "";
      if (!path.startsWith(`${folder}/`) && !path.startsWith(`${folder}\\`) || !existsSync(path)) fail(`evalation-scan opens only a list evalation-scan lookup wrote, under ${folder}`);
      const override = process.env.EVALATION_OPEN_CMD;
      const [command, ...args] = override ? override.split(/\s+/) : process.platform === "darwin" ? ["open"] : process.platform === "win32" ? ["explorer"] : ["xdg-open"];
      const opened = spawnSync(command, [...args, path], { stdio: "ignore" });
      if (opened.error) fail(`could not open ${path}: ${opened.error.message}`);
      return;
    }
    case "run": {
      const { only, rest: afterPhases } = asked(rest);
      const { domains, rest: afterDomains } = domainsAsked(afterPhases);
      const at = afterDomains.indexOf("--lookup");
      const lookup = at < 0 ? null : afterDomains[at + 1];
      if (at >= 0 && !(lookup && isAbsolute(lookup) && lookup.startsWith(join(HOME, "lookups")))) fail(`the list to look up must be one evalation-scan lookup wrote, under ${join(HOME, "lookups")}`);
      const left = at < 0 ? afterDomains : afterDomains.filter((_, index) => index !== at && index !== at + 1);
      if (!left[0]) fail("usage: evalation-scan run <target> [--phases a,b] [--domains a.com,b.com] [--lookup <list>]");
      const { path, document } = scan(left[0], only, { domains, lookup });
      process.stdout.write(`${JSON.stringify({
        written: path,
        said: readOut(document.phases),
        checked: document.phases.filter((one) => one.ran).map((one) => CHECKS[one.phase] ?? one.phase),
        not_checked: document.phases.filter((one) => !one.ran).map((one) => ({
          checks: CHECKS[one.phase] ?? one.phase,
          why: one.why,
          ...(one.declined_on ? { declined_on: one.declined_on } : {}),
          ...(TOOLS[one.tool] ? { tool: nameOf(one.tool) } : {}),
        })),
        findings: document.findings.length,
        below_floor: document.below_floor,
      }, null, 2)}\n`);
      return;
    }
    case "set": {
      const [phase, tool] = rest;
      if (!phase || !tool) fail("usage: evalation-scan set <phase> <tool|off>");
      if (!DEFAULTS[phase]) fail(`no phase ${JSON.stringify(phase)}. The phases are ${Object.keys(DEFAULTS).join(", ")}.`);
      // Only a tool this file knows how to start and how to read. A name from anywhere else is a
      // command somebody would be running without having chosen it.
      if (tool !== "off" && !knownTool(tool)) {
        fail(`no adapter for ${JSON.stringify(tool)}. This knows ${Object.keys(ADAPTERS).join(", ")}.`);
      }
      // And only a tool that answers this phase's question. A secret scanner pointed at the
      // dependency phase runs, finds nothing, and reports the dependencies clean, which is the one
      // wrong answer a scan can give that nobody sees.
      if (tool !== "off" && !adapterFor(phase, tool)) {
        const fits = [...new Set([...Object.keys(BY_PHASE[phase] ?? {}), ...Object.entries(ADAPTERS)
          .filter(([, one]) => one.phase === phase).map(([name]) => name)])];
        fail(`${tool} does not answer the ${phase} phase. ` +
          (fits.length ? `For ${phase} this knows ${fits.join(", ")}.` : `This knows no tool for ${phase}.`)); // say:allow: machine,detail for the fault file, and set is not granted to a session
      }
      const held = settings();
      const next = { ...held, scan: { ...(held.scan ?? {}), phases: { ...(held.scan?.phases ?? {}) } } };
      next.scan.phases[phase] = tool === "off"
        ? { ...DEFAULTS[phase], enabled: false }
        : { enabled: true, tool };
      keep(next);
      show();
      return;
    }
    default:
      process.stderr.write(USAGE);
      process.exit(2);
  }
}

const argvOf = (phase, target) => adapterFor(phase, DEFAULTS[phase].tool).argv(target, null, false);

module.exports = { adapterFor, argvOf, authorship, cratesIn, domainChoices, licenceRead: licences, licences, measured, outsiders, practices, scan, typedDomains };

if (require.main === module) {
  try {
    main();
  } catch (thrown) {
    errors.report("unexpected-error", thrown);
    fail(thrown?.stack ?? thrown);
  }
}
