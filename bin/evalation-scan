#!/usr/bin/env node
// evalation-scan - the deterministic half of a hardening review.
//
// A reading of a repository is a judgement. Whether lodash 4.17.20 carries a known advisory is not:
// it is a lookup, and a model answering it from memory is answering from a knowledge cutoff against
// a database that moved this morning. So the advisories, the secrets and the static findings come
// from tools that either ran or did not, and the reading is handed what they found and judges what
// it means in this codebase. Deterministic facts, judged exploitability, and a reader can see which
// is which.
//
// **The reading never runs this and never holds a shell.** This runs before the reading starts. The
// reading reaches what it found through `evalation-read <target> scan`, fenced like every other
// thing it is shown, so the one command that can start a process is not one the model holds.
//
// **A phase whose tool is not on the machine skips and says so.** It never falls back to guessing,
// and the scan file records the skip with its reason, because a report that cannot tell a clean scan
// from an absent one is worth nothing. The reading is told which phases ran, and a discipline whose
// scanner never ran says that where it appears.
//
// **Read-only on the target.** Each tool is given the target as an argument and is run as argv, never
// through a shell, so nothing derived from the tree is ever interpolated into a command line. Where
// the target is a git repository a porcelain witness is taken before and after, and a scan that
// changed the thing being measured fails rather than reports.
//
// **A secret's material never leaves the machine it was found on.** The secret phase records the
// file, the lines and the rule that fired. Not the secret, not the line it sat on, and not a partial
// of either: a finding that quotes the credential it found has published it into a PDF.
//
// **Nothing is cached.** The same lockfile carries a different answer the day an advisory lands, so
// a cache keyed on the dependencies would serve yesterday's all-clear as today's.
"use strict";

const { execFileSync } = require("node:child_process");
const { existsSync, mkdirSync, mkdtempSync, readFileSync, renameSync, rmSync,
  statSync, writeFileSync } = require("node:fs");
const { tmpdir } = require("node:os");
const { pluginHome } = require("../lib/home.js");
const { basename, dirname, isAbsolute, join, resolve } = require("node:path");

const { SCANS } = require("../lib/scans.js");
const { copied, inRepository } = require("../lib/tree.js");
const { solutionOf } = require("../lib/solution.js");
const { cwesOf } = require("../lib/weaknesses.js");

const HOME = pluginHome();
const SETTINGS = process.env.EVALATION_LOCAL || join(HOME, "evalation.local");

// Worst last. A floor keeps the noise of a thousand negligible transitive advisories out of a report
// somebody has to act on, without pretending they were not there: the count of what fell below it is
// recorded beside what was kept.
const LADDER = ["negligible", "low", "medium", "high", "critical"];

// What runs, and what it runs with. Four phases because the questions are four: what does the
// dependency tree carry, what is in the tree, what does the code itself do wrong, and what was
// committed that should never have been.
//
// Three of them answer in findings and the bill of materials answers in an inventory, because an
// inventory is not a list of things wrong. A phase held to findings alone would report the bill of
// materials clean on every repository that ever had one, which is a true number and a useless one.
// So a phase returns findings, an inventory, or both, and the reading is shown whichever it gave.
const DEFAULTS = {
  sca: { enabled: true, tool: "trivy" },
  sbom: { enabled: true, tool: "syft" },
  sast: { enabled: true, tool: "semgrep" },
  secret: { enabled: true, tool: "gitleaks" },
  history: { enabled: true, tool: "git" },
};

const FLOOR = "low";

// How a tool gets onto a machine that has none of them, which is every customer's machine on the
// first run. The plugin is the only thing they installed, so a scanner it needs is a scanner it has
// to offer to fetch: told to go and install four tools themselves, most people run the review
// without them and never learn what it did not look at.
//
// Homebrew, because it is the one package manager that covers macOS and Linux and is what all four
// of these publish through. Where it is absent this says so and the phase skips, which is the same
// honest ending as a refusal.
const BREW = "brew";

function installer(tool) {
  return { command: BREW, args: ["install", tool], said: `${BREW} install ${tool}` };
}

const TOOLS = {
  trivy: { name: "Trivy", does: "checks dependencies for known security flaws", page: "https://github.com/aquasecurity/trivy" },
  syft: { name: "Syft", does: "lists every dependency", page: "https://github.com/anchore/syft" },
  semgrep: { name: "Semgrep", does: "finds risky code patterns", page: "https://github.com/semgrep/semgrep" },
  gitleaks: { name: "Gitleaks", does: "finds passwords and keys committed to the code", page: "https://github.com/gitleaks/gitleaks" },
  git: { name: "git", does: "reads the commit history", page: "https://git-scm.com/downloads" },
};

const CHECKS = {
  sca: "dependencies for known security flaws",
  sbom: "the list of every dependency",
  sast: "risky code patterns",
  secret: "passwords and keys committed to the code",
  history: "the commit history",
};

const nameOf = (tool) => TOOLS[tool]?.name ?? tool;

function today() {
  const now = new Date();
  return [now.getFullYear(), now.getMonth() + 1, now.getDate()].map((one) => String(one).padStart(2, "0")).join("-");
}

function spoken(day) {
  return day
    ? new Date(`${day}T00:00:00Z`).toLocaleDateString("en-NZ", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
    : null;
}

function missingWhy(tool, held) {
  const failed = held.could_not_install[tool];
  if (failed) return `${nameOf(tool)} could not be installed (${failed.why})`;
  if (held.declined.includes(tool)) {
    const on = spoken(held.declined_on[tool]);
    return `the person running the review chose not to install ${nameOf(tool)}${on ? ` on ${on}` : ""}`;
  }
  return `${nameOf(tool)} is not installed on this machine`;
}

function missingReason(tool, held) {
  if (held.could_not_install[tool]) return "could-not-install";
  return held.declined.includes(tool) ? "declined" : "missing";
}

function toldWhy(one) {
  const tool = nameOf(one.tool);
  const said = {
    declined: `you chose not to install ${tool}${one.declined_on ? ` on ${one.declined_on}` : ""}`,
    "could-not-install": `${tool} could not be installed on this machine`,
    missing: `${tool} is not installed on this machine`,
    off: "it is turned off in this machine's Evalation settings",
    "no-adapter": `this version of Evalation cannot run ${tool}`,
    failed: `${tool} stopped before it finished`,
    "no-history": "the folder has no git history",
  };
  return said[one.reason] ?? `${tool} did not run`;
}

function listed(items) {
  if (items.length < 3) return items.join(" and ");
  return `${items.slice(0, -1).join(", ")}, and ${items.at(-1)}`;
}

function readOut(phases) {
  const checked = phases.filter((one) => one.ran).map((one) => CHECKS[one.phase] ?? one.phase);
  const lines = checked.length > 0 ? [`Checked: ${listed(checked)}.`] : [];
  for (const one of phases.filter((each) => !each.ran)) {
    lines.push(`Not checked: ${CHECKS[one.phase] ?? one.phase}, since ${toldWhy(one)}.` +
      (one.reason === "declined" ? ` To change that, run /ev-run again and tick ${nameOf(one.tool)} when asked.` : ""));
  }
  return lines.join(" ");
}

function fail(reason) {
  process.stderr.write(`${reason}\n`);
  process.exit(1);
}

function settings() {
  if (!existsSync(SETTINGS)) return {};
  try {
    return JSON.parse(readFileSync(SETTINGS, "utf8"));
  } catch (thrown) {
    fail(`settings-unreadable: ${SETTINGS} is not JSON (${thrown.message})`);
  }
}

function keep(next) {
  mkdirSync(dirname(SETTINGS), { recursive: true });
  const draft = `${SETTINGS}.writing`;
  writeFileSync(draft, `${JSON.stringify(next, null, 2)}\n`);
  renameSync(draft, SETTINGS);
}

function phases() {
  const held = settings().scan ?? {};
  const built = {};
  for (const [phase, fallback] of Object.entries(DEFAULTS)) {
    built[phase] = { ...fallback, ...(held.phases?.[phase] ?? {}) };
  }
  return {
    floor: held.floor ?? FLOOR,
    drop_transitive_below_floor: held.drop_transitive_below_floor ?? true,
    declined: held.declined ?? [],
    declined_on: held.declined_on ?? {},
    could_not_install: held.could_not_install ?? {},
    phases: built,
  };
}

// Whether the tool is here, by walking the path rather than by asking a shell. Asking a shell to
// answer it means building a command line out of a tool name, which is the one thing this file does
// not do anywhere else.
function onThisMachine(tool) {
  if (tool.includes("/")) return existsSync(tool);
  for (const where of (process.env.PATH ?? "").split(":")) {
    if (!where) continue;
    try {
      const at = statSync(join(where, tool));
      if (at.isFile() && (at.mode & 0o111) !== 0) return true;
    } catch {
      // Not in this one.
    }
  }
  return false;
}

function ranked(said) {
  const at = LADDER.indexOf(String(said ?? "").toLowerCase());
  return at === -1 ? 0 : at;
}

// What each tool calls a grade, in ours. Static analysers speak in errors and warnings and advisory
// databases speak in the ladder, and a word this does not know is taken as the bottom of it rather
// than dropped, so an unrecognised grade is quiet and never absent.
const SPOKEN = {
  error: "high",
  warning: "medium",
  info: "low",
  unknown: "negligible",
  none: "negligible",
};

function severityOf(said) {
  const word = String(said ?? "").toLowerCase();
  return LADDER.includes(word) ? word : (SPOKEN[word] ?? "negligible");
}

/** The first sentences of an advisory's description, up to about three hundred characters. */
function opening(text) {
  // Advisories are written in markdown, and a report prints plain words: headings, table rows, link
  // targets and emphasis marks come out, keeping the words they carry.
  const flat = String(text ?? "")
    .replace(/^\s*#+\s.*$/gm, " ")
    .replace(/^\s*\|.*\|\s*$/gm, " ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[`*_]/g, "")
    .replace(/\s+/g, " ").trim();
  if (flat.length <= 300) return flat;
  const cut = flat.slice(0, 300);
  const end = cut.lastIndexOf(". ");
  return end > 80 ? cut.slice(0, end + 1) : `${cut.slice(0, cut.lastIndexOf(" "))}…`;
}

// Where a tool says a thing is, said as the repository says it. A tool that answers in absolute
// paths writes the person's home directory into a file that becomes a PDF, and names a path the
// reading cannot open, since the one command it holds takes a path inside the tree.
function within(root, path) {
  if (!path) return path;
  const full = isAbsolute(path) ? path : join(root, path);
  const said = inRepository(root, full);
  return said && !said.startsWith("..") ? said : path;
}

/** The direct dependencies an indirect package is reached through, as name and version, at most four. */
function broughtBy(id, packages, parents) {
  const found = [];
  const seen = new Set([id]);
  const queue = [...(parents.get(id) ?? [])];
  while (queue.length > 0 && found.length < 4) {
    const at = queue.shift();
    if (seen.has(at)) continue;
    seen.add(at);
    const one = packages.get(at);
    if (!one) continue;
    if (["direct", "root", "workspace"].includes(String(one.Relationship ?? "").toLowerCase())) {
      if (String(one.Relationship).toLowerCase() === "direct") found.push(`${one.Name} ${one.Version}`);
      continue;
    }
    queue.push(...(parents.get(at) ?? []));
  }
  return found;
}

/**
 * The adapters. Each says how to start its tool and how to read what it printed, and each returns
 * findings in the one shape the rest of this file and the reading ever see. A tool the table does
 * not name cannot be set, because a tool name that reached a command line from anywhere else is a
 * command somebody else chose.
 */
const ADAPTERS = {
  trivy: {
    phase: "sca",
    // Every package listed, so the scan knows which the repository depends on itself and which came
    // in through another. An advisory carries neither, and read from it every result was direct.
    argv: (target) => ["fs", "--scanners", "vuln", "--list-all-pkgs", "--format", "json", "--quiet", target],
    read: (out, root) => {
      const held = JSON.parse(out || "{}");
      const found = [];
      for (const result of held.Results ?? []) {
        const packages = new Map((result.Packages ?? []).map((one) => [one.ID, one]));
        const parents = new Map();
        for (const one of result.Packages ?? []) {
          for (const child of one.DependsOn ?? []) {
            if (!parents.has(child)) parents.set(child, []);
            parents.get(child).push(one.ID);
          }
        }
        for (const one of result.Vulnerabilities ?? []) {
          const version = one.InstalledVersion ?? "";
          const own = packages.get(one.PkgID);
          const direct = !own || ["direct", "root", "workspace"].includes(String(own.Relationship ?? "direct").toLowerCase());
          found.push({
            key: `sca:${one.PkgName}@${version}:${one.VulnerabilityID}`,
            severity: severityOf(one.Severity),
            title: `${one.VulnerabilityID} in ${one.PkgName} ${version}`,
            package: one.PkgName,
            version,
            fixed: one.FixedVersion ?? null,
            transitive: !direct,
            // Said outright, so a report can tell a scan that knew from an older one that did not.
            relation: direct ? "direct" : "indirect",
            // The packages this repository depends on directly that bring an indirect one in, which is
            // what has to move when upgrading the repository's own dependencies cannot reach it.
            ...(direct ? {} : { via: broughtBy(one.PkgID, packages, parents) }),
            at: { path: within(root, result.Target) },
            // What the weakness is and what it lets somebody do: the advisory's title, then the opening
            // of its description, which is where an advisory says what an attacker gains.
            body: [one.Title, opening(one.Description)].filter(Boolean).join(". "),
            link: one.PrimaryURL ?? null,
            // The class of weakness, which is what says what an attacker could do with it.
            cwe: cwesOf(one.CweIDs ?? []),
          });
        }
      }
      return found;
    },
  },

  syft: {
    phase: "sbom",
    argv: (target) => ["scan", `dir:${target}`, "-o", "syft-json", "-q"],
    // An inventory, not findings. What a reviewer answering the bill of materials needs is how much
    // is in there, what it is written against, and how much of it declares no licence, since an
    // undeclared licence is the one thing in a bill of materials that is somebody's problem later.
    read: (out) => {
      const held = JSON.parse(out || "{}");
      const parts = held.artifacts ?? [];
      const ecosystems = {};
      const unlicensed = [];
      for (const one of parts) {
        ecosystems[one.type ?? "unknown"] = (ecosystems[one.type ?? "unknown"] ?? 0) + 1;
        const licences = (one.licenses ?? [])
          .map((each) => each.value || each.spdxExpression || "").filter(Boolean);
        if (licences.length === 0) unlicensed.push(`${one.name}@${one.version ?? ""}`);
      }
      return {
        findings: [],
        inventory: {
          components: parts.length,
          ecosystems,
          declaring_no_licence: unlicensed.length,
          // Named to a bound. A tree with four hundred unlicensed components needs the number and a
          // sample, and a report carrying all four hundred is a report nobody reads.
          some_of_them: unlicensed.sort().slice(0, 12),
        },
      };
    },
  },

  semgrep: {
    phase: "sast",
    // The published security rules rather than the automatic set, which asks for an account on this
    // version and would stop the phase on a machine that has none.
    argv: (target) => ["scan", "--config", "p/security-audit", "--json", "--quiet", "--no-git-ignore",
      "--metrics", "off", target],
    read: (out, root) => (JSON.parse(out || "{}").results ?? []).map((one) => {
      const at = within(root, one.path);
      const from = one.start?.line ?? 0;
      return {
        key: `sast:${one.check_id}:${at}:${from}`,
        severity: severityOf(one.extra?.severity),
        title: `${String(one.check_id).split(".").pop()} in ${at}`,
        at: { path: at, from, to: one.end?.line ?? from },
        body: String(one.extra?.message ?? "").replace(/\s+/g, " ").trim(),
        cwe: cwesOf(one.extra?.metadata?.cwe ?? []),
      };
    }),
  },

  gitleaks: {
    phase: "secret",
    // Reported to a file because the tool writes its own progress to the terminal, and told to exit
    // zero on a leak so that finding something is not read here as the tool having failed.
    intoFile: true,
    argv: (target, into, isRepository) => [
      isRepository ? "git" : "dir", target,
      "--report-format", "json", "--report-path", into,
      "--redact", "--exit-code", "0", "--no-banner", "--log-level", "error",
    ],
    read: (out, root) => (JSON.parse(out || "[]")).map((one) => {
      // The rule, the file and the line. Nothing from the match itself: the tool is told to redact,
      // and this drops the redacted remains too, since a report is the wrong place to carry even the
      // shape of a credential.
      const at = within(root, one.File);
      return {
        key: `secret:${one.RuleID}:${at}:${one.StartLine}`,
        severity: "high",
        title: `${one.RuleID} in ${at}`,
        at: { path: at, from: one.StartLine, to: one.EndLine ?? one.StartLine },
        body: `${String(one.Description ?? one.RuleID).replace(/\.$/, "")}${one.Commit ? `, in commit ${one.Commit}` : ""}.`,
        // A committed credential, whatever the rule that found it.
        cwe: ["CWE-798"],
      };
    }),
  },
};

/**
 * How concentrated the last twelve months of commits are in one person, from one address per line of
 * git log. Only the shares are kept: a name or an address is somebody's personal data and says
 * nothing a buyer needs. One person holding most of the work is the risk a buyer asks about.
 */
const botAccount = (address) => /\[bot\]@/.test(address);

function authorship(out) {
  const counts = new Map();
  for (const one of String(out).split("\n").map((line) => line.trim().toLowerCase()).filter((line) => line && !botAccount(line))) {
    counts.set(one, (counts.get(one) ?? 0) + 1);
  }
  const total = [...counts.values()].reduce((sum, one) => sum + one, 0);
  const at = { path: "git history" };
  if (total === 0) {
    return [{ key: "history:quiet", phase: "history", severity: "medium", title: "No commits in a year", at,
      body: "No commits in the last twelve months, so nobody has changed this code for a year." }];
  }
  const share = Math.round((Math.max(...counts.values()) / total) * 100);
  const severity = counts.size === 1 || share >= 80 ? "high" : share >= 50 ? "medium" : null;
  if (!severity) return [];
  return [{
    key: "history:concentration", phase: "history", severity, at,
    title: counts.size === 1 ? "Every commit made by one person" : "Most commits made by one person",
    body: `Of ${total} commits in the last twelve months, the most active person made ${share}% of them, across ${counts.size} ${counts.size === 1 ? "person" : "people"}.`,
  }];
}

/** The history phase, read from the checkout itself, since the copy the other tools read has none. */
function history(root, isRepository, named) {
  if (!named.enabled) return { phase: "history", tool: "git", ran: false, reason: "off", why: "it is turned off", findings: [] };
  if (!isRepository) return { phase: "history", tool: "git", ran: false, reason: "no-history", why: "the target has no git history", findings: [] };
  try {
    const git = (...args) => execFileSync("git", ["-C", root, ...args],
      { encoding: "utf8", maxBuffer: 256 * 1024 * 1024, stdio: ["ignore", "pipe", "ignore"] });
    const commits = git("log", "--since=12 months ago", "--no-merges", "--format=%x1e%aI%x1f%aE", "--name-only")
      .split("\x1e").filter((one) => one.trim()).map((one) => {
        const [head, ...files] = one.split("\n");
        const [at, who] = head.split("\x1f");
        return { at, who, files: files.filter(Boolean) };
      });
    const tags = git("for-each-ref", "refs/tags", "--format=%(creatordate:iso-strict)").split("\n").filter(Boolean);
    const tracked = git("ls-files").split("\n").filter(Boolean);
    return { phase: "history", tool: "git", ran: true,
      findings: [...authorship(commits.map((one) => one.who).join("\n")), ...measured({ commits, tags, tracked, now: Date.now() })] };
  } catch (thrown) {
    return { phase: "history", tool: "git", ran: false, reason: "failed", why: `git could not read the history: ${thrown.message}`, findings: [] };
  }
}

function placed(found, one) {
  const area = String(found.key).startsWith("history:area:");
  return {
    ...found,
    key: area ? `history:area:${one.folder}/${found.key.slice("history:area:".length)}` : `${found.key}:${one.folder}`,
    at: { ...found.at, path: `${one.folder}/${found.at?.path ?? ""}` },
    title: area
      ? `${String(found.title).split(" in ")[0]} in ${one.repository}, ${found.key.slice("history:area:".length)}`
      : `${found.title} in ${one.repository}`,
  };
}

function historyAcross(root, solution, named) {
  const held = solution.repositories.filter((one) => one.vcs === "git");
  if (held.length === 0) return history(root, false, named);
  const each = held.map((one) => ({ one, said: history(join(root, one.folder), true, named) }));
  const ran = each.filter(({ said }) => said.ran);
  const missed = each.filter(({ said }) => !said.ran);
  if (ran.length === 0) return { phase: "history", tool: "git", ran: false, reason: missed[0].said.reason, why: missed.map(({ one, said }) => `${one.repository}: ${said.why}`).join("; "), findings: [] };
  return {
    phase: "history", tool: "git", ran: true,
    ...(missed.length > 0 ? { why: `not read in ${missed.map(({ one, said }) => `${one.repository} (${said.why})`).join(", ")}` } : {}),
    findings: ran.flatMap(({ one, said }) => said.findings.map((found) => placed(found, one))),
  };
}

function secretAcross(root, solution, named, held, copy) {
  const each = solution.repositories.map((one) => {
    const git = one.vcs === "git";
    const said = runPhase("secret", named, join(git ? root : copy, one.folder), git, held);
    const findings = said.findings.map((found) => {
      const path = `${one.folder}/${found.at?.path ?? ""}`;
      return {
        ...found,
        key: String(found.key).replace(`:${found.at?.path}:`, `:${path}:`),
        title: String(found.title).replace(` in ${found.at?.path}`, ` in ${path}`),
        at: { ...found.at, path },
      };
    });
    return { one, said: { ...said, findings } };
  });
  const ran = each.filter(({ said }) => said.ran);
  if (ran.length === 0) return { ...each[0].said, findings: [] };
  const missed = each.filter(({ said }) => !said.ran);
  return {
    ...ran[0].said,
    ...(missed.length > 0 ? { why: `not read in ${missed.map(({ one, said }) => `${one.repository} (${said.why})`).join(", ")}` } : {}),
    findings: ran.flatMap(({ said }) => said.findings),
  };
}

const DAY = 86400000;

/**
 * What a year of history says beyond who wrote it, each a number with a threshold: how often the team
 * tagged a release, which top-level areas nobody changed, which rest on one person, and whether the
 * last three months ran at under half the pace of the nine before.
 */
function measured({ commits, tags, tracked, now }) {
  const found = [];
  const within = (at, days) => now - Date.parse(at) <= days * DAY;
  const releases = tags.filter((at) => within(at, 365)).length;
  if (releases < 4) {
    found.push({ key: "history:releases", phase: "history", severity: releases === 0 ? "medium" : "low", at: { path: "git tags" },
      title: releases === 0 ? "No releases tagged in a year" : "Few releases tagged in a year",
      body: `${releases} ${releases === 1 ? "release was" : "releases were"} tagged in the last twelve months.` });
  }
  const areaOf = (path) => (path.includes("/") ? path.split("/")[0] : null);
  const areas = [...new Set(tracked.map(areaOf).filter(Boolean))].sort();
  const touched = new Map(areas.map((one) => [one, []]));
  for (const one of commits) {
    for (const area of new Set(one.files.map(areaOf).filter(Boolean))) touched.get(area)?.push(one.who);
  }
  const dormant = areas.filter((one) => touched.get(one).length === 0);
  if (dormant.length > 0) {
    found.push({ key: "history:dormant", phase: "history", severity: "low", at: { path: "git history" },
      title: "Areas nobody changed in a year",
      body: `Nobody changed ${dormant.slice(0, 6).join(", ")}${dormant.length > 6 ? ` or ${dormant.length - 6} more` : ""} in the last twelve months.` });
  }
  for (const [area, who] of touched) {
    if (who.length < 10) continue;
    const counts = new Map();
    for (const one of who) counts.set(one, (counts.get(one) ?? 0) + 1);
    const share = Math.round((Math.max(...counts.values()) / who.length) * 100);
    if (share >= 80) {
      found.push({ key: `history:area:${area}`, phase: "history", severity: "medium", at: { path: area },
        title: `An area resting on one person in ${area}`,
        body: `Of ${who.length} commits to ${area} in the last twelve months, one person made ${share}% of them.` });
    }
  }
  const recent = commits.filter((one) => within(one.at, 90)).length / 3;
  const before = commits.filter((one) => !within(one.at, 90) && within(one.at, 365)).length / 9;
  if (before >= 4 && recent < before / 2) {
    found.push({ key: "history:slowing", phase: "history", severity: "medium", at: { path: "git history" },
      title: "Changes slowed in the last three months",
      body: `The last three months ran at ${Math.round(recent)} commits a month, down from ${Math.round(before)} a month in the nine before.` });
  }
  return found;
}

/** What the tree was before and after, where git can say. A scan that moved anything is a scan that changed what it measured. */
function witness(target) {
  try {
    return execFileSync("git", ["-C", target, "status", "--porcelain"],
      { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
  } catch {
    return null;
  }
}

/**
 * One phase. Returns what it found and how it went, and never both a skip and a finding: a phase
 * that could not run has no opinion about the repository.
 */
function runPhase(phase, named, target, isRepository, held) {
  const override = process.env[`EVALATION_${phase.toUpperCase()}_CMD`];
  const adapter = ADAPTERS[named.tool];

  if (!named.enabled) return { phase, tool: named.tool, ran: false, reason: "off", why: "it is turned off", findings: [] };
  if (!override) {
    // Why it did not run, in the words a person reading the report will be given. A declined install
    // is a decision somebody made and reads as one, a failed install is not a decision, and a
    // report that flattens them says less than either.
    if (!onThisMachine(named.tool)) {
      return {
        phase,
        tool: named.tool,
        ran: false,
        reason: missingReason(named.tool, held),
        why: missingWhy(named.tool, held),
        ...(held.declined.includes(named.tool) && !held.could_not_install[named.tool]
          ? { declined_on: spoken(held.declined_on[named.tool]) } : {}),
        findings: [],
      };
    }
    if (!adapter) {
      return { phase, tool: named.tool, ran: false, reason: "no-adapter", why: `this build knows no adapter for ${named.tool}`, findings: [] };
    }
  }

  let scratch = null;
  try {
    let out;
    if (override) {
      // The seam a test drives: the command prints findings in the shape above and this reads them
      // as they are. Split on spaces and run as argv, so nothing reaches a shell here either.
      const [command, ...args] = override.split(/\s+/);
      out = execFileSync(command, [...args, target],
        { encoding: "utf8", maxBuffer: 64 * 1024 * 1024, timeout: 600_000, stdio: ["ignore", "pipe", "ignore"] });
      return { phase, tool: override, ran: true, findings: JSON.parse(out || "[]") };
    }

    if (adapter.intoFile) {
      scratch = mkdtempSync(join(tmpdir(), "evalation-scan-"));
      const into = join(scratch, "found.json");
      execFileSync(named.tool, adapter.argv(target, into, isRepository),
        { stdio: ["ignore", "ignore", "ignore"], timeout: 600_000 });
      out = existsSync(into) ? readFileSync(into, "utf8") : "[]";
    } else {
      out = execFileSync(named.tool, adapter.argv(target, null, isRepository),
        { encoding: "utf8", maxBuffer: 64 * 1024 * 1024, timeout: 600_000, stdio: ["ignore", "pipe", "ignore"] });
    }

    // An adapter answers with findings, with an inventory, or with both. A list on its own is the
    // ordinary case and is read as findings.
    const answered = adapter.read(out, target);
    const found = (Array.isArray(answered) ? answered : answered.findings ?? [])
      .map((one) => ({ ...one, phase, tool: named.tool }));
    const inventory = Array.isArray(answered) ? null : answered.inventory ?? null;
    return { phase, tool: named.tool, ran: true, findings: found, inventory };
  } catch (thrown) {
    // Said rather than swallowed, and with no findings, since a tool that fell over knows nothing
    // about this repository and a phase reported clean on a crash is the worst answer available.
    return {
      phase,
      tool: named.tool,
      ran: false,
      reason: "failed",
      why: `the tool did not finish: ${String(thrown.message ?? thrown).split("\n")[0]}`,
      findings: [],
    };
  } finally {
    if (scratch) rmSync(scratch, { recursive: true, force: true });
  }
}

/**
 * The phases a run asked for, from --phases a,b, or every phase where none is named. A phase no
 * selected pack reads is not run at all: a SOC 2 run building a bill of materials spends the time and
 * prints nothing of it.
 */
function asked(rest) {
  const at = rest.indexOf("--phases");
  if (at < 0) return { only: null, rest };
  const only = String(rest[at + 1] ?? "").split(",").map((one) => one.trim()).filter(Boolean);
  for (const one of only) {
    if (!DEFAULTS[one]) fail(`no phase ${JSON.stringify(one)}. The phases are ${Object.keys(DEFAULTS).join(", ")}.`);
  }
  return { only, rest: rest.filter((_, index) => index !== at && index !== at + 1) };
}

function scan(target, only = null) {
  const root = resolve(target);
  try {
    if (!statSync(root).isDirectory()) fail(`${target} is not a directory`);
  } catch {
    fail(`no-such-target: ${target} is not a directory this machine can read`);
  }

  const held = phases();
  const isRepository = existsSync(join(root, ".git"));
  const solution = isRepository ? null : solutionOf(root);
  const watched = () => (solution
    ? solution.repositories.filter((one) => one.vcs === "git").map((one) => `${one.folder}\n${witness(join(root, one.folder)) ?? ""}`).join("\n")
    : witness(root));
  const before = watched();

  // The tools read a directory, and handed the checkout they read everything in it: a customer run
  // counted one advisory 34 times, once for the repository and once for each editor worktree
  // checked out inside it. So they read a copy holding the repository's files and nothing else. The
  // secret scan of a git checkout reads its history, which is the repository's own.
  const copy = copied(root);
  let ran;
  try {
    ran = Object.entries(held.phases)
      .filter(([phase]) => !only || only.includes(phase))
      .map(([phase, named]) => (phase === "history"
        ? (solution ? historyAcross(root, solution, named) : history(root, isRepository, named))
        : phase === "secret" && solution
        ? secretAcross(root, solution, named, held, copy.path)
        : runPhase(phase, named, phase === "secret" && isRepository ? root : copy.path,
          phase === "secret" && isRepository, held)));
  } finally {
    copy.done();
  }

  const after = watched();
  if (before !== null && after !== null && before !== after) {
    fail("Something changed the repository while it was being scanned, so the scan was not kept and no pack credits were used. " +
      "Stop whatever is changing it, then run /ev-run again.");
  }

  const all = ran.flatMap((one) => one.findings);
  const floor = ranked(held.floor);
  const kept = [];
  let below = 0;
  for (const one of all) {
    if (ranked(one.severity) >= floor) {
      kept.push(one);
      continue;
    }
    below += 1;
    // Below the floor and a dependency nobody here chose. Kept where it is the repository's own, so
    // a quiet finding in a direct dependency is still the repository's to answer.
    if (!(held.drop_transitive_below_floor && one.transitive)) kept.push(one);
  }
  kept.sort((a, b) => ranked(b.severity) - ranked(a.severity) || a.key.localeCompare(b.key));

  const document = {
    schema: "evalation.scan.v1",
    at: new Date().toISOString(),
    target: { path: root, name: basename(root), git: isRepository },
    floor: held.floor,
    witnessed: before !== null,
    phases: ran.map(({ findings, inventory, ...said }) => ({
      ...said,
      found: findings.length,
      ...(inventory ? { inventory } : {}),
    })),
    below_floor: below,
    findings: kept,
  };

  mkdirSync(SCANS, { recursive: true, mode: 0o700 });
  const path = join(SCANS, `${document.at.replace(/[:.]/g, "-")}-${basename(root)}.json`);
  writeFileSync(path, `${JSON.stringify(document, null, 2)}\n`);
  return { path, document };
}

const BREAKS = new RegExp(`\\s*[;${String.fromCharCode(0x2013, 0x2014)}]\\s*`, "g");

function offered(held, only) {
  const { entries, say } = require("../lib/say.js");
  const line = (name, values) => say(entries(), name, values);
  const wanted = Object.entries(held.phases).filter(([phase, named]) => (!only || only.includes(phase)) && named.enabled !== false);
  const missing = wanted.filter(([, named]) => !onThisMachine(named.tool)).map(([phase, named]) => ({ phase, tool: named.tool }));
  if (missing.length === 0) {
    const names = wanted.map(([, named]) => nameOf(named.tool));
    if (names.length === 0) return { said: null, asks: null };
    return { asks: null, said: names.length === 1 ? line("ev-run.tool-installed", { tool: names[0] })
      : line("ev-run.tools-installed", { tools: `${names.slice(0, -1).join(", ")} and ${names.at(-1)}` }) };
  }
  if (!onThisMachine(BREW)) {
    return { asks: null, said: [line("ev-run.no-brew"), ...missing.map((one) => line("ev-run.tool-page", {
      tool: nameOf(one.tool), page: TOOLS[one.tool]?.page ?? installer(one.tool).said }))].join("\n") };
  }
  if (missing.length === 1) return { said: null, asks: JSON.parse(say(entries(), "ev-run.install-one", { tool: nameOf(missing[0].tool) })) };
  const plain = (text) => String(text).replace(BREAKS, ", ").replace(/\.$/, "");
  const described = (tool) => {
    const failed = held.could_not_install[tool];
    if (failed) return line("ev-run.tool-failed", { date: spoken(failed.on) ?? spoken(today()), why: plain(failed.why) });
    if (held.declined.includes(tool) && held.declined_on[tool]) return line("ev-run.tool-declined", { date: spoken(held.declined_on[tool]) });
    return line("ev-run.tool-installs");
  };
  return { said: null, asks: JSON.parse(say(entries(), "ev-run.tools", {}, missing.map((one) => ({
    label: `${nameOf(one.tool)}, ${TOOLS[one.tool]?.does ?? `checks ${CHECKS[one.phase]}`}`, description: described(one.tool) })))) };
}

function show(only = null) {
  const held = phases();
  process.stdout.write(`${JSON.stringify({
    ...offered(held, only),
    floor: held.floor,
    drop_transitive_below_floor: held.drop_transitive_below_floor,
    declined: held.declined,
    can_install_with: onThisMachine(BREW) ? BREW : null,
    phases: Object.fromEntries(Object.entries(held.phases).filter(([phase]) => !only || only.includes(phase)).map(([phase, named]) => [phase, {
      ...named,
      on_this_machine: onThisMachine(named.tool),
      adapter: Boolean(ADAPTERS[named.tool]) || phase === "history",
      declined: held.declined.includes(named.tool),
      declined_on: held.declined.includes(named.tool) ? spoken(held.declined_on[named.tool]) : null,
      could_not_install: held.could_not_install[named.tool]
        ? { ...held.could_not_install[named.tool], on: spoken(held.could_not_install[named.tool].on) } : null,
      install_with: onThisMachine(named.tool) ? null : installer(named.tool).said,
      offer: `${nameOf(named.tool)}, ${TOOLS[named.tool]?.does ?? `checks ${CHECKS[phase]}`}`,
      install_page: TOOLS[named.tool]?.page ?? null,
    }])),
    tools_this_knows: Object.keys(ADAPTERS),
    at: SETTINGS,
  }, null, 2)}\n`);
}

/**
 * Fetches a tool this file knows, and nothing else. Only a name in the adapter table can reach the
 * package manager, so a grant over this verb is a grant over four fetches rather than over the
 * machine.
 */
function install(tools) {
  if (!onThisMachine(BREW)) {
    fail(`this build installs scanners with ${BREW}, which is not on this machine. Install the ` +
      `tools another way, or run the review without them and it will say what it did not check.`);
  }
  const done = [];
  for (const tool of tools) {
    if (!ADAPTERS[tool]) fail(`this build knows no tool called ${JSON.stringify(tool)}.`);
    const how = installer(tool);
    try {
      execFileSync(how.command, how.args, { stdio: ["ignore", "ignore", "pipe"], timeout: 900_000 });
      done.push(onThisMachine(tool)
        ? { tool, installed: true }
        : { tool, installed: false, why: `${BREW} finished but ${tool} is still not on the path` });
    } catch (thrown) {
      const said = String(thrown.stderr ?? "").split("\n").map((line) => line.trim()).filter(Boolean);
      done.push({ tool, installed: false, why: said.at(-1) ?? String(thrown.message ?? thrown).split("\n")[0] });
    }
  }
  const held = settings();
  const scan = held.scan ?? {};
  const failed = { ...(scan.could_not_install ?? {}) };
  const declinedOn = { ...(scan.declined_on ?? {}) };
  for (const one of done) {
    delete declinedOn[one.tool];
    if (one.installed) delete failed[one.tool];
    else failed[one.tool] = { why: one.why, on: today() };
  }
  const took = new Set(done.map((one) => one.tool));
  keep({ ...held, scan: { ...scan, declined: (scan.declined ?? []).filter((one) => !took.has(one)),
    declined_on: declinedOn, could_not_install: failed } });
  process.stdout.write(`${JSON.stringify({ installed: done }, null, 2)}\n`);
}

/** Written down with its date, because a person who said no has made a decision and the report names it as one. */
function decline(tools) {
  for (const tool of tools) {
    if (!ADAPTERS[tool]) fail(`this build knows no tool called ${JSON.stringify(tool)}.`);
  }
  const held = settings();
  const scan = held.scan ?? {};
  const failed = { ...(scan.could_not_install ?? {}) };
  const declinedOn = { ...(scan.declined_on ?? {}) };
  for (const tool of tools) {
    delete failed[tool];
    declinedOn[tool] = today();
  }
  keep({ ...held, scan: { ...scan, declined: [...new Set([...(scan.declined ?? []), ...tools])].sort(),
    declined_on: declinedOn, could_not_install: failed } });
  show();
}

const USAGE = `usage: evalation-scan <verb>

  show [--phases a,b]      what would run, what of it is on this machine, and how to get the rest
  install <tool ...>       fetch a scanner this build knows, with the person's yes
  decline <tool ...>       record that a scanner was not wanted, so the report can say so
  run <target> [--phases a,b]
                           scan a repository with those phases, or all, and write what they found
  set <phase> <tool|off>   name the tool for a phase, or turn the phase off
`;

function main() {
  const [verb, ...rest] = process.argv.slice(2);
  switch (verb ?? "show") {
    case "show":
      show(asked(rest).only);
      return;
    case "install":
      if (rest.length === 0) fail("usage: evalation-scan install <tool ...>");
      install(rest);
      return;
    case "decline":
      if (rest.length === 0) fail("usage: evalation-scan decline <tool ...>");
      decline(rest);
      return;
    case "run": {
      const { only, rest: left } = asked(rest);
      if (!left[0]) fail("usage: evalation-scan run <target> [--phases a,b]");
      const { path, document } = scan(left[0], only);
      process.stdout.write(`${JSON.stringify({
        written: path,
        said: readOut(document.phases),
        checked: document.phases.filter((one) => one.ran).map((one) => CHECKS[one.phase] ?? one.phase),
        not_checked: document.phases.filter((one) => !one.ran).map((one) => ({
          checks: CHECKS[one.phase] ?? one.phase,
          why: one.why,
          ...(one.declined_on ? { declined_on: one.declined_on } : {}),
          ...(TOOLS[one.tool] ? { tool: nameOf(one.tool) } : {}),
        })),
        findings: document.findings.length,
        below_floor: document.below_floor,
      }, null, 2)}\n`);
      return;
    }
    case "set": {
      const [phase, tool] = rest;
      if (!phase || !tool) fail("usage: evalation-scan set <phase> <tool|off>");
      if (!DEFAULTS[phase]) fail(`no phase ${JSON.stringify(phase)}. The phases are ${Object.keys(DEFAULTS).join(", ")}.`);
      // Only a tool this file knows how to start and how to read. A name from anywhere else is a
      // command somebody would be running without having chosen it.
      if (tool !== "off" && !ADAPTERS[tool]) {
        fail(`no adapter for ${JSON.stringify(tool)}. This knows ${Object.keys(ADAPTERS).join(", ")}.`);
      }
      // And only a tool that answers this phase's question. A secret scanner pointed at the
      // dependency phase runs, finds nothing, and reports the dependencies clean, which is the one
      // wrong answer a scan can give that nobody sees.
      if (tool !== "off" && ADAPTERS[tool].phase !== phase) {
        const fits = Object.entries(ADAPTERS)
          .filter(([, one]) => one.phase === phase).map(([name]) => name);
        fail(`${tool} answers the ${ADAPTERS[tool].phase} phase, not ${phase}. ` +
          (fits.length ? `For ${phase} this knows ${fits.join(", ")}.` : `This knows no tool for ${phase}.`));
      }
      const held = settings();
      const next = { ...held, scan: { ...(held.scan ?? {}), phases: { ...(held.scan?.phases ?? {}) } } };
      next.scan.phases[phase] = tool === "off"
        ? { ...DEFAULTS[phase], enabled: false }
        : { enabled: true, tool };
      keep(next);
      show();
      return;
    }
    default:
      process.stderr.write(USAGE);
      process.exit(2);
  }
}

module.exports = { authorship, measured, scan };

if (require.main === module) main();
