#!/usr/bin/env node
// evalation-report - the evidence pack: what a repository evidences against a standard.
//
// This is the artefact an auditor is handed. It carries one row per selected clause: the clause, the
// question that was asked of it, what the repository answers, the evidence that answer rests on, and
// the status. A reader can check any row against the code without us and without the person who ran
// the assessment.
//
// **The layout is the one that was settled** and it is reproduced rather than reinvented: A4
// landscape, five columns, the house chrome, a coverage line under the title. Column widths are
// proportions of the body so the table fills the page at any paper size.
//
// **It renders and never decides.** Every status, reason and citation comes from the findings file,
// which was already refused if a citation did not hold. Nothing here recomputes a judgement, softens
// a gap or drops an entry: a renderer that could change what the report says would be a second place
// the assessment happens.
//
// **Delivered as a PDF**, like the board pack and the findings detail, because an evidence pack that
// can be edited after it is handed over is not evidence. The page it was printed from is kept beside
// it, so a person can see exactly what was printed.
//
// **Org-level is never a gap.** A control the deploying organisation owns and no repository can
// evidence has its own status and its own colour. A pack full of false gaps is the fastest way to
// lose the auditor it was produced for.
"use strict";

const { existsSync, readFileSync } = require("node:fs");
const { basename, dirname, join, resolve } = require("node:path");

const { print } = require("../lib/print.js");

const ASSETS = resolve(__dirname, "..", "reporting", "assets");

// The vocabulary, in the order a reader should meet it: what is wrong first, what is right after, and
// what is nobody's or somebody else's last.
const STATUSES = [
  ["total-gap", "Gap", "danger"],
  ["partial-gap", "Partial", "warn"],
  ["covered", "Covered", "ok"],
  ["org-level", "Org-level", "orglevel"],
  ["not-applicable", "Not applicable", "muted"],
];

const CHROME = {
  page: "#070C18",
  panel: "#0E1730",
  zebra: "rgba(14,23,48,0.55)",
  hairline: "rgba(130,160,230,0.13)",
  rule: "#1B2748",
  blue: "#6B8FFF",
  text: "#E6ECF7",
  muted: "#9DAAC6",
  faint: "#6F82AB",
  ok: "#2FD07A",
  warn: "#FFB020",
  danger: "#FB3B4E",
  orglevel: "#8FA2C6",
};

// Proportions of the body width, taken from the settled layout. Evidence and the answer get the room
// because they are what a reader actually reads; the clause and the status need only their own width.
const COLUMNS = [0.16, 0.22, 0.26, 0.23, 0.13];

const FONTS = [
  ["Hanken Grotesk", "HankenGrotesk-Regular.ttf", 400],
  ["Hanken Grotesk", "HankenGrotesk-Bold.ttf", 700],
  ["JetBrains Mono", "JetBrainsMono-Regular.ttf", 400],
  ["JetBrains Mono", "JetBrainsMono-Bold.ttf", 700],
];

const MARGIN = 0.55;
const PAGE = { width: 11.69, height: 8.27 };

function fail(reason) {
  process.stderr.write(`${reason}\n`);
  process.exit(1);
}

function safe(text) {
  return String(text ?? "")
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

// The mark every deliverable carries, from the one place the assets live. Read as optional it fails
// silently: the pack renders, looks nearly right, and goes out unbranded, which nobody notices until
// a customer has already sent it on.
function mark() {
  const here = join(ASSETS, "ev-mark.svg");
  if (!existsSync(here)) {
    throw new Error(`the brand mark is missing from ${here}, so this pack would go out unbranded`);
  }
  return `data:image/svg+xml;base64,${readFileSync(here).toString("base64")}`;
}

function faces() {
  return FONTS.map(([family, file, weight]) => {
    const data = readFileSync(join(ASSETS, "fonts", file)).toString("base64");
    return `@font-face{font-family:'${family}';font-weight:${weight};font-style:normal;` +
      `src:url(data:font/ttf;base64,${data}) format('truetype')}`;
  }).join("");
}

function tone(status) {
  return STATUSES.find(([one]) => one === status)?.[2] ?? "muted";
}

function label(status) {
  return STATUSES.find(([one]) => one === status)?.[1] ?? status;
}

// What a claim rests on: what the evidence says first, then where it is, then what kind it is.
//
// A location on its own is not evidence to a reader, it is a coordinate. An auditor reading this
// column wants to know what was found before deciding whether to go and look at it, and only then
// where to look. The grade is said aloud because planting text is free and planting behaviour is not:
// a reader weighing a covered row needs to know which of the two it rests on.
function citation(one) {
  if (!one?.at) return "";
  const where = `${one.at.path}:${one.at.from}${one.at.to && one.at.to !== one.at.from ? `-${one.at.to}` : ""}`;
  return `${one.at.quote ? `<span class="said">${safe(one.at.quote)}</span>` : ""}` +
    `<span class="where">${safe(where)}</span>` +
    `<span class="grade">${safe(one.at.grade ?? "")}</span>`;
}

function row(answer, asked) {
  const entry = asked.get(`${answer.pack}/${answer.entry}`);
  const colour = tone(answer.status);

  // Every status but covered owes a corrective step, and covered owes its evidence. Both are shown
  // where they exist, and neither is invented where it does not.
  const remedy = answer.required
    ? `<p class="remedy">${safe(answer.required)}</p>`
    : "";

  return `<tr>
<td class="control"><span class="code">${safe(answer.entry)}</span>${safe(entry?.title ?? "")}</td>
<td class="asked">${safe(entry?.intent ?? "")}</td>
<td class="answers">${safe(answer.because)}${remedy}</td>
<td class="evidence">${citation(answer) || '<span class="none">no citation recorded</span>'}</td>
<td class="status"><span class="pill" style="color:var(--${colour})">
  <span class="dot" style="background:var(--${colour})"></span>${safe(label(answer.status))}</span></td>
</tr>`;
}

function page(document, answers, asked, counted) {
  const repository = document.target?.repository ?? "";
  const packs = document.packs ?? [];
  const first = packs[0] ?? {};

  const coverage = STATUSES
    .filter(([one]) => counted[one])
    .map(([one, name, colour]) => `<span style="color:var(--${colour})">${name} ${counted[one]}</span>`)
    .join('<span class="dot-sep">·</span>');

  const byPack = new Map();
  for (const one of answers) {
    if (!byPack.has(one.pack)) byPack.set(one.pack, []);
    byPack.get(one.pack).push(one);
  }

  const blocks = [...byPack.entries()].map(([pack, held]) => {
    const named = packs.find((one) => one.pack === pack);
    return `<section class="block">
<h2>${safe(named?.title ?? pack)}<span class="edition"> at ${safe(named?.version ?? "")}</span></h2>
<p class="count">${held.length} ${held.length === 1 ? "entry" : "entries"} assessed against this repository.</p>
<table><thead><tr>
${["Control", "Audit question", "How this repository answers", "Evidence", "Status"]
      .map((one) => `<th>${one}</th>`).join("")}
</tr></thead><tbody>${held.map((one) => row(one, asked)).join("")}</tbody></table>
</section>`;
  }).join("");

  const eyebrow = `EVALATION · ${repository.toUpperCase()} · EVIDENCE PACK`;
  const foot = `Evidence pack for ${repository}. Assessed ${String(document.at ?? "").slice(0, 10)} ` +
    `at governance revision ${document.revision ?? ""}.`;

  return `<!doctype html><meta charset="utf-8"><title>Evidence pack · ${safe(repository)}</title>
<style>
${faces()}
@page{size:${PAGE.width}in ${PAGE.height}in;margin:0}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:${CHROME.page};color:${CHROME.text};
  font-family:'Hanken Grotesk',system-ui,sans-serif;
  -webkit-print-color-adjust:exact;print-color-adjust:exact}
:root{--ok:${CHROME.ok};--warn:${CHROME.warn};--danger:${CHROME.danger};
  --orglevel:${CHROME.orglevel};--muted:${CHROME.faint}}

.sheet{position:relative;width:${PAGE.width}in;height:${PAGE.height}in;overflow:hidden;
  background:${CHROME.page};page-break-after:always;break-after:page;padding:${MARGIN}in}
.sheet:last-child{page-break-after:auto;break-after:auto}

.masthead{position:absolute;left:${MARGIN}in;right:${MARGIN}in;top:0.5in;height:0.34in}
.eyebrow{font-family:'JetBrains Mono',monospace;font-size:8.5pt;letter-spacing:0.18em;
  color:${CHROME.faint};margin:0}
.mark{position:absolute;right:0;top:-0.06in;height:0.28in}

.lead{position:absolute;left:${MARGIN}in;right:${MARGIN}in;top:0.95in}
.lead h1{font-size:27pt;font-weight:700;margin:0;letter-spacing:-0.01em}
.lead .subtitle{font-size:10pt;color:${CHROME.muted};margin:0.04in 0 0}
.lead .coverage{font-family:'JetBrains Mono',monospace;font-size:10.5pt;margin:0.14in 0 0}
.lead .coverage .what{color:${CHROME.text}}
.dot-sep{color:${CHROME.rule};margin:0 0.09in}

.flow{position:absolute;left:${MARGIN}in;right:${MARGIN}in;top:2.22in;bottom:0.62in;overflow:hidden}
.flow.plain{top:1.05in}

.foot{position:absolute;left:${MARGIN}in;right:${MARGIN}in;bottom:0.36in;
  display:flex;justify-content:space-between;
  font-family:'JetBrains Mono',monospace;font-size:7.5pt;letter-spacing:0.05em;color:${CHROME.faint};
  border-top:1px solid ${CHROME.hairline};padding-top:6px}

h2{font-size:13pt;font-weight:700;margin:0 0 0.03in}
h2 .edition{font-weight:400;color:${CHROME.muted};font-size:11pt}
.count{font-size:9pt;color:${CHROME.faint};margin:0 0 0.06in}
.block{margin:0 0 0.22in}

table{width:100%;border-collapse:collapse;table-layout:fixed}
th{font-family:'JetBrains Mono',monospace;font-size:8pt;font-weight:400;text-align:left;
  letter-spacing:0.10em;text-transform:uppercase;color:${CHROME.faint};
  padding:6px 10px 6px 0;border-bottom:1px solid ${CHROME.rule}}
td{font-size:8.5pt;line-height:11.5pt;color:${CHROME.text};padding:9px 10px 9px 0;
  vertical-align:top;border-bottom:1px solid ${CHROME.hairline};overflow-wrap:anywhere}
tbody tr:nth-child(even){background:${CHROME.zebra}}
tbody tr:nth-child(even) td:first-child{box-shadow:-10px 0 0 ${CHROME.zebra}}

td.control{font-weight:600}
td.control .code{display:block;font-family:'JetBrains Mono',monospace;font-size:8pt;
  font-weight:400;color:${CHROME.blue};margin-bottom:2px}
td.asked{color:${CHROME.muted}}
td.evidence{color:${CHROME.muted}}
td.evidence .said{display:block;font-style:italic;color:${CHROME.muted};margin-bottom:3px}
td.evidence .where{display:block;font-family:'JetBrains Mono',monospace;font-style:normal;
  font-size:7.5pt;color:${CHROME.faint}}
td.evidence .grade{display:block;font-family:'JetBrains Mono',monospace;font-style:normal;
  font-size:7pt;letter-spacing:0.08em;text-transform:uppercase;color:${CHROME.rule}}
td.evidence .none{font-style:italic;color:${CHROME.rule}}
.remedy{margin:0.04in 0 0;color:${CHROME.muted};font-size:8pt}
.pill{font-family:'JetBrains Mono',monospace;font-size:8pt;letter-spacing:0.08em;
  text-transform:uppercase;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
.dot{width:6px;height:6px;border-radius:50%;flex:none}
</style>
<div id="source">${blocks}</div>
<div id="out"></div>
<script>
// The page lays itself out before it prints, for the reason the findings detail does: a row's height
// depends on how its text wraps, which only the browser knows, and a page number cannot be written by
// the stylesheet. A table continued on the next sheet takes its heading and its column headers with
// it, because a column of text under no headings cannot be read.
(function () {
  var COLS = '<colgroup>' + ${JSON.stringify(COLUMNS)}
    .map(function (w) { return '<col style="width:' + (w * 100) + '%">'; }).join('') + '</colgroup>';
  var source = document.getElementById('source');
  var out = document.getElementById('out');
  var eyebrow = ${JSON.stringify(eyebrow)};
  var title = ${JSON.stringify(first.title ?? first.pack ?? "Evidence pack")};
  var subtitle = ${JSON.stringify(`What this repository evidences, with the lines every claim rests on.`)};
  var coverage = ${JSON.stringify(coverage)};
  var coverageLabel = ${JSON.stringify("Coverage")};
  var foot = ${JSON.stringify(foot)};
  var mark = ${JSON.stringify(mark())};
  var sheet = null, flow = null, first = true;

  // Column widths go on before anything is measured. Measured without them the columns are equal,
  // every row wraps taller than it will, and each sheet ends a row or two early.
  var early = source.querySelectorAll('table');
  for (var e = 0; e < early.length; e++) early[e].insertAdjacentHTML('afterbegin', COLS);

  function open() {
    sheet = document.createElement('div');
    sheet.className = 'sheet';
    sheet.innerHTML =
      '<div class="masthead"><p class="eyebrow"></p><img class="mark"></div>' +
      (first
        ? '<div class="lead"><h1></h1><p class="subtitle"></p><p class="coverage">' +
          '<span class="what"></span> </p></div>'
        : '') +
      '<div class="flow' + (first ? '' : ' plain') + '"></div>' +
      '<div class="foot"><span class="foot-left"></span><span class="foot-right"></span></div>';
    sheet.querySelector('.eyebrow').textContent = eyebrow;
    sheet.querySelector('.mark').src = mark;
    sheet.querySelector('.foot-left').textContent = foot;
    if (first) {
      sheet.querySelector('h1').textContent = title;
      sheet.querySelector('.subtitle').textContent = subtitle;
      sheet.querySelector('.coverage .what').textContent = coverageLabel + ':';
      sheet.querySelector('.coverage').insertAdjacentHTML('beforeend', coverage);
    }
    out.appendChild(sheet);
    flow = sheet.querySelector('.flow');
    first = false;
    return flow;
  }

  function overflows() {
    var last = flow.lastElementChild;
    if (!last) return false;
    var rows = last.querySelectorAll('tbody tr');
    var edge = rows.length
      ? rows[rows.length - 1].getBoundingClientRect().bottom
      : last.getBoundingClientRect().bottom;
    return edge > flow.getBoundingClientRect().bottom + 0.5;
  }

  open();
  var blocks = Array.prototype.slice.call(source.children);
  for (var i = 0; i < blocks.length; i++) {
    var block = blocks[i];
    flow.appendChild(block);
    if (!overflows()) continue;

    // On a sheet that already holds something, the block moves to a fresh one. On an empty sheet it
    // stays where it is: taking it off and only putting it back when there was something else there
    // drops any block bigger than a page, which is every table of real length.
    if (flow.children.length > 1) {
      flow.removeChild(block);
      open();
      flow.appendChild(block);
    }
    if (!overflows()) continue;

    var table = block.querySelector('table');
    if (!table) continue;

    // The section's own heading, taken once. Read from the block each time round, a continuation
    // takes the heading that already says so and says it again: eight pages in, the heading reads
    // "(cont.) (cont.) (cont.)" and the section's name is off the edge of the page.
    var heading = block.querySelector('h2').innerHTML;

    var body = table.querySelector('tbody');
    var rows = Array.prototype.slice.call(body.children);
    for (var r = 0; r < rows.length; r++) body.removeChild(rows[r]);

    for (var r2 = 0; r2 < rows.length; r2++) {
      body.appendChild(rows[r2]);
      if (!overflows()) continue;
      body.removeChild(rows[r2]);

      open();
      var carried = document.createElement('section');
      carried.className = 'block';
      carried.innerHTML = '<h2></h2><table>' + COLS + table.querySelector('thead').outerHTML +
        '<tbody></tbody></table>';
      carried.querySelector('h2').innerHTML = heading + '  <span class="edition">(cont.)</span>';
      flow.appendChild(carried);
      block = carried;
      body = carried.querySelector('tbody');
      body.appendChild(rows[r2]);
    }
  }

  source.remove();
  var sheets = out.querySelectorAll('.sheet');
  for (var s = 0; s < sheets.length; s++) {
    sheets[s].querySelector('.foot-right').textContent = 'Page ' + (s + 1) + ' of ' + sheets.length;
  }
})();
</script>`;
}

function main() {
  const [source, into] = process.argv.slice(2);
  if (!source) {
    process.stderr.write("usage: evalation-report <findings.json> [out.pdf]\n");
    process.exit(2);
  }

  let document;
  try {
    document = JSON.parse(readFileSync(source, "utf8"));
  } catch (thrown) {
    fail(`unreadable-findings: ${thrown.message}`);
  }
  if (document.schema !== "evalation.findings.v1") {
    fail(`not-a-findings-file: ${source} says it is ${document.schema ?? "nothing"}`);
  }

  // What each entry asked, so the report carries the question beside the answer. A reader judging
  // whether a status is right needs to know what was being asked.
  const asked = new Map();
  for (const pack of document.packs ?? []) {
    for (const one of pack.entries_asked ?? []) asked.set(`${pack.pack}/${one.identifier}`, one);
  }

  // In the standard's own order, which is the order it was asked in and the order an auditor works
  // through it. Sorted by status instead, the clause numbers jump about the page and a reader
  // checking a criterion has to hunt for it: the coverage line at the top already says how many of
  // each there are, so the table's job is to be findable rather than to rank.
  const asking = new Map();
  for (const pack of document.packs ?? []) {
    (pack.entries_asked ?? []).forEach((one, at) => asking.set(`${pack.pack}/${one.identifier}`, at));
  }

  const answers = [...(document.answers ?? [])].sort((a, b) =>
    String(a.pack).localeCompare(String(b.pack))
    || (asking.get(`${a.pack}/${a.entry}`) ?? Number.MAX_SAFE_INTEGER)
      - (asking.get(`${b.pack}/${b.entry}`) ?? Number.MAX_SAFE_INTEGER)
    || String(a.entry).localeCompare(String(b.entry)));

  if (!answers.length) fail(`no-answers: ${source} carries no coverage to report`);

  const counted = Object.fromEntries(STATUSES.map(([one]) => [one, 0]));
  for (const one of answers) if (one.status in counted) counted[one.status] += 1;

  const out = into
    ? resolve(into)
    : join(dirname(resolve(source)), `${basename(source).replace(/\.json$/, "")}.pdf`);
  const done = print(page(document, answers, asked, counted), `${out.replace(/\.pdf$/, "")}.html`, out);

  process.stdout.write(`${JSON.stringify({
    written: done.printed ? out : done.page,
    printed: done.printed,
    entries: answers.length,
    by_status: counted,
  }, null, 2)}\n`);
}

main();
