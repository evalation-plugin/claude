#!/usr/bin/env node
// evalation-report - the evidence pack: what a repository evidences against a standard.
//
// This is the artefact an auditor is handed. It carries one section per selected clause: what was
// asked, what the repository answers, the lines that answer rests on, the status, and what closes it
// where it is not closed. A reader can check any section against the code without us and without the
// person who ran the assessment.
//
// **A section, not a row.** Read across five narrow columns the two things an auditor actually reads,
// the answer and the evidence, are each about two inches wide and every sentence wraps four times.
// A section gives the clause the width of the page and puts the quoted line under the claim it
// supports, which is the order somebody checking it works in.
//
// **It renders and never decides.** Every status, reason and citation comes from the findings file,
// which was already refused if a citation did not hold. Nothing here recomputes a judgement, softens
// a gap or drops an entry: a renderer that could change what the report says would be a second place
// the assessment happens.
//
// **Delivered as a PDF**, like the findings detail, because an evidence pack that can be edited after
// it is handed over is not evidence. The page it was printed from is kept beside it, so a person can
// see exactly what was printed.
//
// **Org-level is never a gap.** A control the deploying organisation owns and no repository can
// evidence has its own status and its own colour. A pack full of false gaps is the fastest way to
// lose the auditor it was produced for.
"use strict";

const { mkdirSync, readFileSync } = require("node:fs");
const { join, resolve } = require("node:path");

const { print } = require("../lib/print.js");
const { named: phaseNamed } = require("../lib/scans.js");
const { keepFindings, reportsFolder, reviewName } = require("../lib/reports.js");
const { CHROME, css, escaped, paginator } = require("../lib/sheet.js");

// The vocabulary, in the order a reader should meet it: what is wrong first, what is right after,
// and what is nobody's or somebody else's last. Coverage is this pack's own, as severity is the
// findings detail's, and neither writes into the other.
const STATUSES = [
  ["total-gap", "Gap", "G", "#FB3B4E"],
  ["partial-gap", "Partial", "P", "#FFB020"],
  ["covered", "Covered", "C", "#35C46A"],
  ["org-level", "Org-level", "O", "#8FA2C6"],
  ["not-applicable", "Not applicable", "N", "#6F82AB"],
];

function fail(reason) {
  process.stderr.write(`${reason}\n`);
  process.exit(1);
}

function named(status) {
  return STATUSES.find(([one]) => one === status)?.[1] ?? status;
}

function colourOf(status) {
  return STATUSES.find(([one]) => one === status)?.[3] ?? CHROME.faint;
}

// How far an answer was checked, in the colours the findings detail gives the same words, so a
// reader holding both learns them once.
const STANDING = { verified: colourOf("covered"), asserted: CHROME.blue, scanned: CHROME.muted };

function standing(answer) {
  const word = answer.confirmed === "verified" ? "verified" : "asserted";
  return `<span style="color:${STANDING[word]}">${word}</span>`;
}

function counted(answers) {
  const held = Object.fromEntries(STATUSES.map(([one]) => [one, 0]));
  for (const one of answers) if (one.status in held) held[one.status] += 1;
  return held;
}

/**
 * What a claim rests on: where it is, how strong it is, and the line itself.
 *
 * An answer carries a list, because a clause is often evidenced in more than one place, and showing
 * one of three is showing a reader less than was found. The quote is under the location, since
 * somebody checking a claim goes to the file first and reads second.
 */
function evidence(answer) {
  const held = answer.evidence ?? [];
  const searched = String(answer.searched ?? "").trim();
  if (held.length === 0 && !searched) {
    return '<div class="cite"><div class="where"><span>no citation recorded</span></div></div>';
  }
  const lines = held.map((one) => {
    const range = one.to && one.to !== one.from ? `${one.from}-${one.to}` : one.from;
    return `<div class="cite"><div class="where">` +
      `<span>${escaped(one.path)}:${escaped(range)}</span>` +
      `<span class="grade">${escaped(one.grade ?? "")}</span></div>` +
      (one.quote ? `<pre>${escaped(one.quote)}</pre>` : "") +
      `</div>`;
  });
  // An absence has no line to show, so the answer says what was looked for and where, which a reader
  // can look for again.
  const looked = searched
    ? [`<div class="cite"><div class="where"><span>What was searched</span>` +
       `<span class="grade">nothing found</span></div><p class="looked">${escaped(searched)}</p></div>`]
    : [];
  return [...lines, ...looked].join("");
}

// What each result is called on the page, and its colour: found in the colour of a control that
// holds, missing in the colour of a total gap, and an item out of reach in grey.
const RESULT = {
  found: ["found", colourOf("covered")],
  missing: ["missing", colourOf("total-gap")],
  "does-not-apply": ["does not apply", CHROME.faint],
  "not-checked": ["not checked", colourOf("partial-gap")],
};

// Severities worst first, the order a scanner's findings are listed in under an item.
const SEVERITY = ["critical", "high", "medium", "low", "info"];

// Scanner findings listed under one item before the rest are counted. The findings file holds all.
const LISTED = 8;

/**
 * What the scan said about an item it settled. Found says the phase ran and found nothing at the
 * item's severity or above. Missing lists what it found there, worst first. Not checked says why the
 * phase did not run.
 */
function scanned(want, row, scan) {
  const phase = phaseNamed(want.phase);
  const level = want.at_least ? ` at ${want.at_least} or above` : "";
  if (row.result === "not-checked") {
    const ran = (scan?.phases ?? []).find((one) => one.phase === want.phase);
    return `<p class="looked">${escaped(ran && !ran.ran ? `The ${phase} did not run: ${ran.why}.` : `The ${phase} was not run over this repository in this run.`)}</p>`;
  }
  if (row.result === "found") {
    return `<p class="looked">${escaped(`The ${phase} ran over this repository and found nothing${level}.`)}</p>`;
  }
  const floor = want.at_least ? SEVERITY.indexOf(want.at_least) : SEVERITY.length - 1;
  const over = (scan?.settling ?? [])
    .filter((one) => one.phase === want.phase && SEVERITY.indexOf(one.severity) >= 0 && SEVERITY.indexOf(one.severity) <= floor)
    .sort((a, b) => SEVERITY.indexOf(a.severity) - SEVERITY.indexOf(b.severity));
  const shown = over.slice(0, LISTED).map((one) =>
    `<div class="at"><span>${escaped(one.title ?? one.key)}${one.fixed ? escaped(`, fixed in ${one.fixed}`) : ""}</span>` +
    `<span class="grade">${escaped(one.severity)}</span></div>`).join("");
  const more = over.length > LISTED ? `<p class="looked">${escaped(`And ${over.length - LISTED} more, each listed in Evalation Findings.json.`)}</p>` : "";
  return `<p class="looked">${escaped(`The ${phase} found ${over.length}${level}.`)}</p>${shown}${more}`;
}

/**
 * An entry that lists what to look for, item by item: what was sought, whether it was found, and
 * under it the lines it was found in, the account of the search, or why it does not apply. The
 * status above is the count of these, so a reader can check the count.
 */
function items(answer, list, scan) {
  return list.map((want, at) => {
    const row = answer.looked_for?.[at] ?? {};
    const [word, colour] = RESULT[row.result] ?? ["not answered", CHROME.faint];
    const tag = want.proof === "scan" ? `<span class="grade" style="color:${STANDING.scanned}">scanned</span> ` : "";
    const under = want.proof === "scan" ? scanned(want, row, scan)
      : row.result === "found"
      ? (row.evidence ?? []).map((one) => {
        const range = one.to && one.to !== one.from ? `${one.from}-${one.to}` : one.from;
        return `<div class="at"><span>${escaped(one.path)}:${escaped(range)}</span>` +
          `<span class="grade">${escaped(one.grade ?? "")}</span></div>` +
          (one.quote ? `<pre>${escaped(one.quote)}</pre>` : "");
      }).join("")
      : `<p class="looked">${escaped(row.result === "missing" ? row.searched : row.why)}</p>`;
    return `<div class="cite item"><div class="where"><span>${at + 1}. ${escaped(want.find)}</span>` +
      `<span>${tag}<span class="grade" style="color:${colour}">${word}</span></span></div>${under}</div>`;
  }).join("");
}

// What closes it, or why nothing here can. A clause the deploying organisation owns has a
// justification and no remedy, and printing an empty fix bar under it would read as work somebody
// forgot to write down.
function closing(answer) {
  if (answer.remedy) {
    return `<div class="did"><b>What to do</b>${escaped(answer.remedy)}</div>`;
  }
  if (answer.justification) {
    return `<div class="did"><b>Why this is not the code's to answer</b>` +
      `${escaped(answer.justification)}</div>`;
  }
  return "";
}

function entry(answer, asked, pack, scan) {
  const clause = asked.get(`${answer.pack}/${answer.entry}`);
  const colour = colourOf(answer.status);

  // Where the answer came from. A clause settled by the pack was never read against this tree, and
  // an auditor weighing it has to be able to see that without going to the methodology.
  const tag = answer.from === "authored"
    ? "answered from the pack"
    : [escaped(answer.model ?? ""), standing(answer)].filter(Boolean).join(" &middot; ");

  const body = [
    clause?.intent ? `<p class="asked">${escaped(clause.intent)}</p>` : "",
    answer.because ? `<p class="because">${escaped(answer.because)}</p>` : "",
    answer.from === "authored" ? ""
      : clause?.looks_for?.length && Array.isArray(answer.looked_for) ? items(answer, clause.looks_for, scan)
      : evidence(answer),
    closing(answer),
  ].join("");

  // Whether the standard assesses this one in every audit or only where a level was elected. One
  // word, because what the word means is said once on the opening page.
  const marker = clause?.obligation
    ? `<span class="grade ${escaped(clause.obligation)}">${escaped(clause.obligation)}</span>`
    : "";

  return `<article class="entry" data-lens="${escaped(pack)}">
<div class="head">
<span class="id">${escaped(answer.entry)}</span>
<span class="ttl">${escaped(clause?.title ?? "")}</span>
${marker}
<span class="tag">${tag}</span>
<span class="pill" style="background:${colour}">${escaped(named(answer.status))}</span>
</div>
<div class="body">${body}</div>
</article>`;
}

// A pack's heading carries its own coverage split, each letter in that status's colour and a zero in
// grey, the same colours the tags and the first page's bar use.
function heading(title, answers) {
  const held = counted(answers);
  const split = STATUSES.map(([status, , letter, colour]) =>
    `<span style="color:${held[status] ? colour : CHROME.faint}">${letter} ${held[status]}</span>`)
    .join('<span class="bar-sep">|</span>');
  return `${escaped(title)} (${answers.length}): <span class="split">${split}</span>`;
}

/**
 * A section of a standard, as that standard divides itself: SOC 2's five categories, and whichever
 * parts another framework names. The heading says how many of the framework's own things it holds
 * and whether it is assessed in every audit or only where the customer elected it, because a report
 * listing an elected category beside a compulsory one says a repository has gaps against something
 * nobody was assessing.
 */
function section(part, answers, asked, noun, scan) {
  const [first, ...rest] = answers.map((one) => entry(one, asked, part.title, scan));

  const marker = part.obligation
    ? `<span class="obligation ${part.obligation}">${escaped(part.obligation)}</span>`
    : "";
  const count = answers.length === 1 ? noun.one : noun.many;
  const blurb = [`${answers.length} ${count} assessed against this repository.`, part.note]
    .filter(Boolean).join(" ");

  // The heading travels with its first entry. Left to break on its own it lands at the foot of a
  // page with its entries on the next one.
  return `<div class="block lens"><h2>${heading(part.title, answers)}${marker}</h2>` +
    `<p class="blurb">${escaped(blurb)}</p>${first}</div>` + rest.join("");
}

/**
 * A pack's name as a person would recognise it, which is the name the standard publishes. The
 * identifier is a lower-case handle for filing and is never what a report shows: an auditor handed
 * a page headed soc2 is being told the assessor did not know what the standard is called.
 */
function nameOf(pack, identifier) {
  return String(pack?.title ?? "").trim() || String(identifier ?? "");
}

/** What a standard calls the things it is made of. A pack that says nothing is read as entries. */
function nounOf(pack) {
  const held = pack?.entry_noun;
  return held?.one && held?.many ? held : { one: "entry", many: "entries" };
}

/**
 * A word with the article that goes in front of it. The nouns a standard calls its parts are
 * ordinary words with an ordinary first letter, so the vowel decides it: an article, an entry, a
 * requirement. A word starting on a vowel letter and a consonant sound, a one-off for instance,
 * would need the sound and no standard here has one.
 */
function called(word) {
  return `${/^[aeiou]/i.test(word) ? "an" : "a"} ${word}`;
}

/**
 * The noun the opening page uses, which is the standard's own where every pack in the report agrees
 * on one. Two standards calling their parts different things leave the key nothing true to call all
 * of them, so it falls back to the neutral word.
 */
function nounAcross(packs) {
  const nouns = (packs ?? []).map((one) => nounOf(one));
  const first = nouns[0] ?? nounOf(null);
  return nouns.every((one) => one.one === first.one) ? first : { one: "entry", many: "entries" };
}

/**
 * The sections a pack declares, in its own order, each with the answers that fall under it. A pack
 * declaring none is one section holding everything, so the page is laid out the same way either way
 * and nothing downstream has two shapes to handle.
 */
function sectionsOf(pack, answers, asked) {
  const declared = pack?.sections ?? [];
  if (declared.length === 0) {
    return [[{ identifier: "", title: pack?.title ?? pack?.pack ?? "" }, answers]];
  }

  const bySection = new Map(declared.map((one) => [one.identifier, []]));
  const loose = [];
  for (const one of answers) {
    // The section is a fact about the entry the standard holds, not about the answer to it, so it
    // is read from what the pack was asked and never from what came back.
    const at = asked.get(`${one.pack}/${one.entry}`)?.section ?? "";
    if (bySection.has(at)) bySection.get(at).push(one);
    else loose.push(one);
  }

  const held = declared
    .filter((one) => bySection.get(one.identifier).length > 0)
    .map((one) => [one, bySection.get(one.identifier)]);

  // An answer naming no declared section is still reported. Dropped, it would be an entry the
  // standard asked about and the report never mentioned.
  if (loose.length > 0) held.push([{ identifier: "", title: "Not in any declared section" }, loose]);
  return held;
}

function dated(at) {
  return String(at ?? "").slice(0, 10);
}

function facts(document, answers, packs) {
  // The standard and the edition it was assessed against. Without the edition a reader cannot tell
  // which document the clause numbers resolve to, and the numbering moves between editions.
  // Only the packs this document answers: a run can also read a concern set, whose findings go in the
  // findings detail and never here.
  const held = new Set(answers.map((one) => one.pack));
  const standards = (packs ?? []).filter((one) => held.has(one.pack) && (one.title ?? "").trim().length > 0);
  const said = [
    ["Assessed", dated(document.at)],
    ["Against", standards.map((one) => nameOf(one, one.pack)).join(", ")],
    ["Edition", standards.map((one) => one.version).filter(Boolean).join(", ")],
    ["Entries", answers.length],
    ["Governance revision", document.revision],
    ["Run", document.run],
  ].filter(([, value]) => value !== undefined && value !== null && String(value) !== "");

  return `<ul class="facts">${said
    .map(([label, value]) => `<li>${escaped(label)}<b>${escaped(value)}</b></li>`).join("")}</ul>`;
}

// The coverage split of the whole pack, as counts and as a bar of the same colours. The bar says the
// proportion, which a row of five numbers does not.
function tally(answers) {
  const held = counted(answers);
  const total = answers.length;

  const cells = STATUSES.map(([status, label, , colour]) =>
    `<li><div class="n" style="color:${colour}">${held[status]}</div>` +
    `<div class="l">${label}</div></li>`).join("");

  const bar = total === 0 ? "" : `<div class="bar">${STATUSES
    .map(([status, , , colour]) =>
      `<span style="width:${(held[status] / total) * 100}%;background:${colour}"></span>`)
    .join("")}</div>`;

  return `<ul class="tally">${cells}</ul>${bar}`;
}

/**
 * What the grades on the entries mean, each said once. The reason a requirement is optional is the
 * same reason for every requirement of that grade, so printing it on each card would be one
 * sentence a hundred times and a reader would stop seeing it.
 */
function grades(asked) {
  const held = new Map();
  for (const one of asked.values()) {
    if (!one.obligation || !one.note) continue;
    held.set(`${one.obligation}/${one.note}`, [one.obligation, one.note]);
  }
  // What is always assessed leads, since a reader takes that as the baseline and reads the rest
  // against it. Inside a word the order is the order the standard put them in.
  return [...held.values()].sort((one, two) =>
    Number(two[0] === "mandatory") - Number(one[0] === "mandatory"));
}

// The opening page: what was assessed, what it came to, and how to read one of the standard's parts.
function opening(document, answers, packs, asked) {
  const read = answers.filter((one) => one.from !== "authored").length;
  const noun = nounAcross(packs);
  const marks = grades(asked);
  const parts = [
    ["Identifier", "The standard's own number for it, and the short name beside it."],
    ["Asked", "The question put to the repository, in italics, so a reader can judge whether the status answers it."],
    ["Answer", "What the repository evidences, and why it is this status and not the one either side of it."],
    ["Where it rests", "The file and lines, on the grey bar, with the line itself under them and how strong it is at the right. Where the answer is that something is absent, what was searched for and where, so anybody can look again."],
    ["Looked for", "Where the standard's part lists what it looks for, each item numbered with found, missing or does not apply at the right, and the status is the count of them. An item marked scanned was settled by a scanner run over this repository during the reading, and lists what the scanner found."],
    ["Status", "Gap, Partial, Covered, Org-level or Not applicable, on the coloured tag at the right."],
    ["Checked", "Beside the model that read it: verified where a second check confirmed the answer against the repository, asserted where nothing confirmed it."],
    ["What to do", `What closes it, on the orange bar. Where the organisation owns ${called(noun.one)}, it carries why the code cannot answer it.`],
  ];
  if (marks.length > 0) {
    parts.push(["In scope",
      `Whether this standard assesses the ${noun.one} in every audit or only where a level was elected, on the small tag after the name. What each word means is below.`]);
  }

  return `<div class="block">
${facts(document, answers, packs)}
${tally(answers)}
</div>
<div class="block">
<h2>The work done</h2>
<p class="intro">${read} of these ${answers.length} ${escaped(noun.many)} were answered by reading this
repository, and every one of those names the file and lines it rests on. The rest were settled by the
pack because no repository could evidence them, and each says so where it appears. Nothing was
executed and nothing was changed. Open the repository at the commit named, go to the lines a claim
cites, and read them.</p>
<p class="intro">This reads the repository as it stands at one commit. That is evidence of how a
control is designed and whether the code implements it. It is not evidence that a control operated
over a period, which takes records across months that no repository holds at a commit. Where a
standard separates the two, this supports the first.</p>
</div>
<div class="block last">
<h2>Reading ${escaped(called(noun.one))}</h2>
<p class="lede">Every ${escaped(noun.one)} that follows is laid out the same way. This is a key, not
an entry.</p>
<dl class="key wide">${parts
  .map(([name, meaning]) => `<dt>${escaped(name)}</dt><dd>${escaped(meaning)
    .replace(/\b(verified|asserted)\b/g, (word) => `<span style="color:${STANDING[word]}">${word}</span>`)}</dd>`).join("")}</dl>
${marks.length === 0 ? "" : `<dl class="key wide grades">${marks
  .map(([word, meaning]) => `<dt>${escaped(word)}</dt><dd>${escaped(meaning)}</dd>`).join("")}</dl>`}
</div>`;
}

function page(document, answers, asked) {
  const repository = document.target?.repository ?? "";
  const packs = document.packs ?? [];

  const byPack = new Map();
  for (const one of answers) {
    if (!byPack.has(one.pack)) byPack.set(one.pack, []);
    byPack.get(one.pack).push(one);
  }

  const blocks = opening(document, answers, packs, asked) + [...byPack.entries()].map(([pack, held]) => {
    const one = packs.find((each) => each.pack === pack);
    const noun = nounOf(one);
    // The pack's own name leads a section heading only where the report covers more than one. With
    // one standard the opening page has already named it, and repeating it on every heading is the
    // same words down the page saying nothing new.
    const several = byPack.size > 1;
    return sectionsOf(one, held, asked).map(([part, rows]) => section({
      ...part,
      title: several && part.title ? `${nameOf(one, pack)}, ${part.title}` : (part.title || nameOf(one, pack)),
    }, rows, asked, noun, document.scan)).join("");
  }).join("");

  const title = "Evalation Evidence Pack";
  const subtitle = `What this repository evidences · Repo: ${repository}`;
  const foot = `${title}. Assessed ${dated(document.at)} at governance revision ` +
    `${document.revision ?? ""}.`;

  return `<!doctype html><meta charset="utf-8"><title>${escaped(title)}</title>
<style>
${css()}

/* Whether a section is in every audit against this standard or only where the customer elected it.
   Beside the heading and not under it, since it qualifies the heading and a reader who scrolls past
   it has taken the whole section as compulsory. */
h2 .obligation{font-family:'JetBrains Mono',monospace;font-size:7pt;letter-spacing:0.08em;
  text-transform:uppercase;font-weight:400;padding:2px 7px;margin-left:0.10in;
  vertical-align:middle;color:${CHROME.page}}
h2 .obligation.mandatory{background:${CHROME.muted}}
h2 .obligation.optional{background:${CHROME.rule};color:${CHROME.muted}}

/* The same distinction on an entry, where a standard grades each of its parts. Quieter than the
   status tag beside it, since it qualifies the name and the status is what the reader came for. */
.entry .grade{font-family:'JetBrains Mono',monospace;font-size:6.5pt;letter-spacing:0.08em;
  text-transform:uppercase;padding:1px 6px;flex:none;color:${CHROME.faint};
  border:1px solid ${CHROME.rule}}
.entry .grade.mandatory{color:${CHROME.muted}}
</style>
<div id="source">${blocks}</div>
${paginator({ title, subtitle, foot })}`;
}

function main() {
  const [source, into] = process.argv.slice(2);
  if (!source) {
    process.stderr.write("usage: evalation-report <findings.json> [into-dir]\n");
    process.exit(2);
  }

  let document;
  try {
    document = JSON.parse(readFileSync(source, "utf8"));
  } catch (thrown) {
    fail(`unreadable-findings: ${thrown.message}`);
  }
  if (document.schema !== "evalation.findings.v1") {
    fail(`not-a-findings-file: ${source} says it is ${document.schema ?? "nothing"}`);
  }

  // What each entry asked, so the report carries the question beside the answer. A reader judging
  // whether a status is right needs to know what was being asked.
  const asked = new Map();
  for (const pack of document.packs ?? []) {
    for (const one of pack.entries_asked ?? []) asked.set(`${pack.pack}/${one.identifier}`, one);
  }

  // In the standard's own order, which is the order it was asked in and the order an auditor works
  // through it. Sorted by status instead, the clause numbers jump about the page and a reader
  // checking a criterion has to hunt for it: the split at the top already says how many of each
  // there are, so the pack's job is to be findable and not to rank.
  const asking = new Map();
  for (const pack of document.packs ?? []) {
    (pack.entries_asked ?? []).forEach((one, at) => asking.set(`${pack.pack}/${one.identifier}`, at));
  }

  const answers = [...(document.answers ?? [])].sort((a, b) =>
    String(a.pack).localeCompare(String(b.pack))
    || (asking.get(`${a.pack}/${a.entry}`) ?? Number.MAX_SAFE_INTEGER)
      - (asking.get(`${b.pack}/${b.entry}`) ?? Number.MAX_SAFE_INTEGER)
    || String(a.entry).localeCompare(String(b.entry)));

  if (!answers.length) fail(`no-answers: ${source} carries no coverage to report`);

  // One evidence pack per standard, named for it, so a folder holding several says which is which and
  // an auditor for one standard is handed that standard alone.
  const folder = into ? resolve(into) : reportsFolder(document);
  mkdirSync(folder, { recursive: true });
  keepFindings(resolve(source), folder);
  const written = [...new Set(answers.map((one) => one.pack))].map((pack) => {
    const own = answers.filter((one) => one.pack === pack);
    const alone = { ...document, packs: (document.packs ?? []).filter((one) => one.pack === pack) };
    const out = join(folder, `${reviewName(document, pack)} Evidence Pack.pdf`);
    const done = print(page(alone, own, asked), `${out.replace(/\.pdf$/, "")}.html`, out, { run: document.run });
    return {
      pack,
      written: done.printed ? out : done.page,
      printed: done.printed,
      signed: done.signed === true,
      ...(done.unsigned ? { unsigned: `marked "Signature missing, document cannot be verified": ${done.unsigned}` } : {}),
      entries: own.length,
      cited: own.filter((one) => (one.evidence ?? []).length > 0).length,
      by_status: counted(own),
    };
  });

  process.stdout.write(`${JSON.stringify({ folder, packs: written }, null, 2)}\n`);
}

main();
