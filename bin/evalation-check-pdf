#!/usr/bin/env node
// evalation-check-pdf <report.pdf> - says whether a report is one we issued and unchanged since.
//
// A PDF reader shows a signature's verdict only where it checks signatures, and the Mac's own viewer
// does not. This answers the same question anywhere: it takes the digest of the signed byte ranges,
// asks our server whether that digest was signed and when, and says whether anything was added to the
// file after signing, which is how an editor saves a change.
"use strict";
require("../lib/errors.js");

const { runScript } = require("../lib/script.js");
const { signedRanges } = require("../lib/sign.js");
const { line } = require("../lib/run-say.js");

const file = process.argv[2];
if (!file) {
  process.stderr.write("usage: evalation-check-pdf <report.pdf>\n");
  process.exit(2);
}

let read;
try {
  read = signedRanges(file);
} catch (thrown) {
  process.stderr.write(`${line("report.check-unreadable", { why: thrown.message })}\n`);
  process.exit(1);
}
if (!read) {
  process.stdout.write(`${line("report.check-unsigned")}\n`);
  process.exit(1);
}

let said;
try {
  said = JSON.parse(runScript("evalation-ask", ["/verify", JSON.stringify({ digest: read.digest })], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: 60_000,
  }));
} catch (thrown) {
  process.stderr.write(`${line("report.check-unasked", { why: String(thrown.stderr || thrown.message).trim() })}\n`);
  process.exit(1);
}

if (!said.issued) {
  process.stdout.write(`${line("report.check-foreign")}\n`);
  process.exit(1);
}
if (read.appended > 0) {
  process.stdout.write(`${line("report.check-appended", { date: said.signed_at, bytes: String(read.appended) })}\n`);
  process.exit(1);
}
process.stdout.write(`${line("report.check-genuine", { date: said.signed_at })}\n`);
