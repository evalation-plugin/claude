#!/usr/bin/env node
// evalation-questions - a customer's own questions, checked and kept for the next run.
//
//   evalation-questions check <file>            prints each problem, or that the set holds
//   evalation-questions save <file> [--replace] keeps the set under its name on this machine
//   evalation-questions list                    the sets on this machine and the account, with pack and size
//   evalation-questions path <name>             where a set is, fetched from the account where needed
//   evalation-questions keep-on-account <name>  keeps a set on the account as well
//   evalation-questions drop-from-account <name> stops keeping a set on the account
"use strict";

const { readFileSync } = require("node:fs");
const { pluginHome } = require("../lib/home.js");
const { join } = require("node:path");
const { dropFromAccount, fetched, keepOnAccount, listed, problems, save } = require("../lib/questions.js");

const HOME = pluginHome();

function fail(reason) {
  process.stderr.write(`${reason}\n`);
  process.exit(1);
}

function read(file) {
  try {
    return JSON.parse(readFileSync(file, "utf8"));
  } catch (thrown) {
    return fail(`unreadable-questions: ${file} (${thrown.message})`);
  }
}

const [verb, arg, flag] = process.argv.slice(2);
if (verb === "check") {
  const wrong = problems(read(arg));
  if (wrong.length > 0) fail(`${wrong.length} to fix:\n  ${wrong.join("\n  ")}`);
  process.stdout.write("holds\n");
} else if (verb === "save") {
  try {
    const set = read(arg);
    save(HOME, set, { replace: flag === "--replace" });
    process.stdout.write(`kept as ${set.name}\n`);
  } catch (thrown) {
    fail(thrown.message);
  }
} else if (verb === "list") {
  process.stdout.write(`${JSON.stringify(listed(HOME))}\n`);
} else if (verb === "path") {
  try {
    process.stdout.write(`${fetched(HOME, arg)}\n`);
  } catch (thrown) {
    fail(`no-such-set: ${arg} (${thrown.message})`);
  }
} else if (verb === "keep-on-account") {
  try {
    keepOnAccount(HOME, arg);
    process.stdout.write(`${arg} is kept on your account\n`);
  } catch (thrown) {
    fail(`not-kept: ${arg} (${thrown.message})`);
  }
} else if (verb === "drop-from-account") {
  try {
    dropFromAccount(arg);
    process.stdout.write(`${arg} is no longer kept on your account\n`);
  } catch (thrown) {
    fail(`not-dropped: ${arg} (${thrown.message})`);
  }
} else {
  fail("usage: evalation-questions check <file> | save <file> [--replace] | list | path <name> | keep-on-account <name> | drop-from-account <name>");
}
