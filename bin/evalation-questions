#!/usr/bin/env node
// evalation-questions - a customer's own questions, checked and kept for the next run.
//
//   evalation-questions check <file>            prints each problem, or that the set holds
//   evalation-questions save <file> [--replace] keeps the set under its name on this machine
//   evalation-questions list [--plain]          the sets on this machine and the account, as data or as lines for the person
//   evalation-questions path <name> [--run]     a draft copy of a set, or with --run the run's own copy, fetched from the account where needed
//   evalation-questions draft <name>            where to write a new set's draft
//   evalation-questions keep-on-account <name>  keeps a set on the account as well
//   evalation-questions drop-from-account <name> stops keeping a set on the account
"use strict";

const { existsSync, mkdirSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } = require("node:fs");
const { randomBytes } = require("node:crypto");
const { pluginHome } = require("../lib/home.js");
const { join } = require("node:path");
const { CRITERIA, approval, askServer, changed, claimsQuestion, dropFromAccount, extensible, fetched, fromAccount, grid, grouped, keepOnAccount, listed, listSaid, namesQuestion,
  packNamed, packQuestion, progress, saveChecked, saved, setsQuestion, shown, verdict, withoutMark } = require("../lib/questions.js");
const { entries: lines, say } = require("../lib/say.js");
const { answered } = require("../lib/answer.js");

const HOME = pluginHome();
const NAME = /^[A-Za-z0-9][A-Za-z0-9 _-]{0,59}$/;
const DAY = 24 * 60 * 60 * 1000;

function draftOf(home, name) {
  if (!NAME.test(String(name))) throw new Error(`${name}: not a name a set is kept under`);
  mkdirSync(join(home, "drafts"), { recursive: true, mode: 0o700 });
  return join(home, "drafts", `${name}.json`);
}

function fresh(home, name) {
  if (saved(home).includes(name)) throw new Error(`${name} is already a saved set, so a new set needs another name`);
  const draft = draftOf(home, name);
  rmSync(draft, { force: true });
  rmSync(`${draft}.said.json`, { force: true });
  return draft;
}

function tell(home, text) {
  const folder = join(home, "drafts");
  mkdirSync(folder, { recursive: true, mode: 0o700 });
  for (const old of readdirSync(folder).filter((one) => /^answer-.*\.txt$/.test(one))) {
    try {
      if (Date.now() - statSync(join(folder, old)).mtimeMs > DAY) rmSync(join(folder, old), { force: true });
    } catch (thrown) {
      if (thrown.code !== "ENOENT") throw thrown;
    }
  }
  const answer = join(folder, `answer-${Date.now()}-${process.pid}-${randomBytes(4).toString("hex")}.txt`);
  writeFileSync(answer, `${text}\n`, { mode: 0o600 });
  process.stdout.write(`${answer}\n`);
}

function withTitle(set, known) {
  const title = set?.pack && set.pack !== "custom" ? known[set.pack] : undefined;
  return title ? { ...set, pack_title: title } : set;
}

function served(ask) {
  return ask("/packs", {}).packs ?? [];
}

function packsSaid(home, ask = askServer) {
  let packs;
  try {
    packs = served(ask);
  } catch {
    return "The pack list could not be fetched."; // say:allow: agent,the session reads this answer file, and choose-pack asks the person
  }
  const selection = join(home, "packs.json");
  const chosen = existsSync(selection) ? JSON.parse(readFileSync(selection, "utf8")).packs ?? [] : [];
  const titleOf = (one) => one.body?.title ?? one.pack;
  const picked = packs.filter((one) => chosen.includes(one.pack)).map(titleOf);
  const open = packs.filter((one) => extensible(one.body)).map((one) => `${titleOf(one)} (${one.pack})`);
  return [`Chosen packs: ${picked.join(", ") || "none"}`, `Packs that take extra questions: ${open.join(", ") || "none"}`].join("\n");
}

function titles(ask = askServer) {
  try {
    return Object.fromEntries(served(ask).filter((one) => one.body?.title).map((one) => [one.pack, one.body.title]));
  } catch {
    return {};
  }
}

function runCopyOf(home, name) {
  if (!NAME.test(String(name))) throw new Error(`${name}: not a name a set is kept under`);
  mkdirSync(join(home, "runs", "questions"), { recursive: true, mode: 0o700 });
  return join(home, "runs", "questions", `${name}.json`);
}

function opened(home, name, ask = askServer, { run = false } = {}) {
  const copyOf = run ? runCopyOf : draftOf;
  try {
    const kept = JSON.parse(readFileSync(fetched(home, name, ask), "utf8"));
    const draft = copyOf(home, name);
    writeFileSync(draft, JSON.stringify(withoutMark(kept), null, 2) + "\n", { mode: 0o600 });
    rmSync(`${draft}.said.json`, { force: true });
    changed(draft, kept);
    return draft;
  } catch (thrown) {
    if (!NAME.test(String(name))) throw thrown;
    const held = (ask("/sets", {}).sets ?? []).find((one) => one.name === name);
    if (!held) throw thrown;
    let sound = true;
    try {
      fromAccount(held);
    } catch {
      sound = false;
    }
    if (sound) throw thrown;
    const draft = copyOf(home, name);
    writeFileSync(draft, String(held.body ?? ""), { mode: 0o600 });
    return draft;
  }
}

function fail(reason) {
  process.stderr.write(`${reason}\n`);
  process.exit(1);
}

function read(file) {
  try {
    return JSON.parse(readFileSync(file, "utf8"));
  } catch (thrown) {
    return fail(`unreadable-questions: ${file} (${thrown.message})`);
  }
}

function main() {
  const [verb, arg, ...flags] = process.argv.slice(2);
  if (verb === "check") {
    const set = read(arg);
    for (const one of progress(HOME, arg, set)) process.stdout.write(`${one}\n`);
    const { fix, waiting, unconfirmed } = grouped(HOME, set);
    const said = [["To fix:", fix], ["Waiting for the independent checker:", waiting], ["Not confirmed by the independent checker:", unconfirmed]]
      .filter(([, rows]) => rows.length > 0).map(([head, rows]) => `${head}\n  ${rows.join("\n  ")}\n`).join("");
    tell(HOME, said.trimEnd() || "holds");
  } else if (verb === "folder") {
    process.stdout.write(`${join(HOME, "drafts")}\n`);
    mkdirSync(join(HOME, "drafts"), { recursive: true, mode: 0o700 });
    rmSync(join(HOME, "drafts", "claims.json"), { force: true });
  } else if (verb === "packs") {
    tell(HOME, packsSaid(HOME));
  } else if (verb === "draft") {
    try {
      tell(HOME, fresh(HOME, arg));
    } catch (thrown) {
      tell(HOME, saved(HOME).includes(arg) ? `name taken: ${thrown.message}` : thrown.message);
    }
  } else if (verb === "save") {
    const set = read(arg);
    const replace = flags.includes("--replace");
    try {
      saveChecked(HOME, withTitle(set, titles()), { replace, unchecked: flags.includes("--unchecked") });
      tell(HOME, "saved");
    } catch (thrown) {
      tell(HOME, !replace && saved(HOME).includes(set.name) ? `name taken: ${thrown.message}` : thrown.message);
    }
  } else if (verb === "list") {
    process.stdout.write(arg === "--plain" ? `${listSaid(listed(HOME), titles()).join("\n")}\n` : `${JSON.stringify(listed(HOME))}\n`);
  } else if (verb === "path") {
    const run = flags.includes("--run");
    try {
      const copy = opened(HOME, arg, askServer, { run });
      if (run) process.stdout.write(`${copy}\n`);
      else tell(HOME, copy);
    } catch (thrown) {
      if (!run) tell(HOME, `no-such-set: ${arg} (${thrown.message})`);
      fail(`no-such-set: ${arg} (${thrown.message})`);
    }
  } else if (verb === "keep-on-account") {
    answered([arg]);
    try {
      const { already } = keepOnAccount(HOME, arg, askServer, { looked: true });
      if (!already) process.stdout.write(`${say(lines(), "shared.set-kept", { set: arg })}\n`);
    } catch (thrown) {
      fail(`not-kept: ${arg} (${thrown.message})`);
    }
  } else if (verb === "drop-from-account") {
    try {
      dropFromAccount(arg);
      process.stdout.write(`${say(lines(), "ev-questions.off-account", { set: arg })}\n`);
    } catch (thrown) {
      fail(`not-dropped: ${arg} (${thrown.message})`);
    }
  } else if (verb === "choose-set") {
    process.stdout.write(`${setsQuestion(listed(HOME), titles(), Number(arg ?? 1))}\n`);
  } else if (verb === "choose-pack") {
    let packs = null;
    try {
      packs = served(askServer);
    } catch {
      packs = null;
    }
    process.stdout.write(`${packQuestion(packs, Number(arg ?? 1))}\n`);
  } else if (verb === "pack-named") {
    answered([arg]);
    let packs;
    try {
      packs = served(askServer);
    } catch {
      fail("unreachable: the pack list could not be fetched");
    }
    process.stdout.write(`${JSON.stringify(packNamed(packs, arg))}\n`);
  } else if (verb === "choose-claims" || verb === "choose-name" || verb === "approve" || verb === "show") {
    try {
      const out = verb === "choose-claims" ? claimsQuestion(read(arg))
        : verb === "choose-name" ? namesQuestion([arg, ...flags], listed(HOME).sets.map((one) => one.name))
          : verb === "approve" ? approval(HOME, read(arg)) : [changed(arg, read(arg)).join("\n"), shown(read(arg))].filter(Boolean).join("\n\n");
      process.stdout.write(`${out}\n`);
    } catch (thrown) {
      fail(thrown.message);
    }
  } else if (verb === "criteria") {
    process.stdout.write(`${CRITERIA.map((one) => `${one.id}, for each ${one.about}, a fault where the answer is ${one.fault}: ${one.asks}`).join("\n")}\n`);
  } else if (verb === "grid") {
    process.stdout.write(`${grid(HOME, read(arg), CRITERIA, flags[0]).text}\n`);
  } else if (verb === "verdict") {
    const { refused, unchecked } = verdict(HOME, read(arg), readFileSync(0, "utf8"), CRITERIA, flags[0]);
    const said = [["Answer these again:", refused], ["Still to answer:", unchecked]]
      .filter(([, rows]) => rows.length > 0).map(([head, rows]) => `${head}\n  ${rows.join("\n  ")}\n`).join("");
    process.stdout.write(said || "Recorded.\n");
  } else {
    fail("usage: evalation-questions folder | check <file> | criteria | packs | choose-set [page] | choose-pack [page] | pack-named <typed> | choose-claims <file> | choose-name <name> <name> | show <file> | approve <file> |grid <file> [Qn] | verdict <file> [Qn] (answers on stdin) | save <file> [--replace] [--unchecked] | list [--plain] | path <name> [--run] | draft <name> | keep-on-account <name> | drop-from-account <name>");
  }
}

module.exports = { draftOf, fresh, opened, packsSaid, withTitle };

if (require.main === module) main();
