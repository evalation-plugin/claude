#!/usr/bin/env node
// evalation-readonly - whether this run may read the tree in front of it, decided before it reads.
//
// A findings run reads code it does not trust: a client's repository, its comments, its
// documentation. What must not be possible is for something planted in what it reads to become a
// change to what it reads.
//
// **That is answered by what the reading holds, not by what the machine has.** The reading is granted
// one command, `evalation-read`, and nothing else: no file writing, no general shell, no network. A
// reading that cannot invoke anything cannot write, cannot reach a credential store and cannot be
// talked into either, so the question of what this machine is signed in as does not arise.
//
// This replaced asking the host what a token could do. That check refused on the machine holding a
// login rather than on the run holding one, which is permanently true of any developer machine with
// the host's own tool installed, and it asked a network to answer a question the grant settles
// locally. Worse, it proved nothing about the reading: a token merely unused is a token an injection
// can still reach for, and only taking the shell away makes it unreachable.
//
// **So what is checked here is that the grant is really there.** The engine writes each dispatch's
// permission rules and reads them back before the child exists, because a grant nobody verified is a
// grant the backend may have quietly declined: a mis-spelled one once left three rounds asking for a
// shell and being refused while believing they had one. The same reasoning applies to a grant carried
// in a shipped file, so the file is read and the grant confirmed rather than assumed.
"use strict";

const { execFileSync } = require("node:child_process");
const { existsSync, readFileSync } = require("node:fs");
const { basename, join, resolve } = require("node:path");

// The one command the reading is granted. Named here and in the command's own frontmatter, and the
// two are compared, so a change to either without the other is caught rather than shipped.
const GRANTED = "evalation-read";

// What no reading may hold. A reading with any of these can open a file outside the fence, change
// the tree it is judging, or reach whatever the machine is signed in as.
const REFUSED = ["Write", "Edit", "MultiEdit", "NotebookEdit", "Read", "Grep", "Glob", "WebFetch"];

function quietly(command, args, where) {
  try {
    return execFileSync(command, args, {
      cwd: where,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
  } catch {
    return null;
  }
}

/**
 * What is being read. A checkout with a remote at a host names itself; anything else is a plain
 * directory, which is an ordinary target rather than a lesser one now that nothing here depends on
 * a host being reachable.
 */
function target(where) {
  const remote = quietly("git", ["remote", "get-url", "origin"], where);
  const head = quietly("git", ["rev-parse", "HEAD"], where);
  const inside = quietly("git", ["rev-parse", "--is-inside-work-tree"], where) === "true";

  const named = remote
    ? remote.replace(/^.*[:/]{1}([^/:]+\/[^/]+?)(?:\.git)?$/, "$1")
    : basename(resolve(where));

  return { kind: remote ? "repository" : "directory", repository: named, head, remote, inside };
}

/**
 * The grant, read from the file the host will load rather than taken on trust.
 *
 * A grant that names the tool and narrows it is two things to the backend: it switches the tool on by
 * bare name and takes the narrowing as a permission. So this looks for the command inside the grant
 * and for the absence of everything a reading must not hold, rather than matching one exact string
 * that a harmless reformatting would break.
 */
function granted(root) {
  const at = join(root, "commands", "ev-run.md");
  if (!existsSync(at)) {
    return { held: false, why: `there is no command file at ${at} to carry the grant` };
  }

  const said = readFileSync(at, "utf8").split("\n").find((one) => /^allowed-tools:/.test(one.trim()));
  if (!said) {
    return { held: false, why: "the run command declares no allowed-tools, so the reading holds whatever the host allows" };
  }
  if (!said.includes(GRANTED)) {
    return { held: false, why: `the run command's grant does not name ${GRANTED}, so the reading has no way to read` };
  }

  const wrong = REFUSED.filter((one) => new RegExp(`\\b${one}\\b`).test(said));
  if (wrong.length > 0) {
    return {
      held: false,
      why: `the run command's grant also holds ${wrong.join(", ")}, so the reading can reach content outside the fence`,
    };
  }
  return { held: true, grant: said.trim() };
}

/** The whole decision, as data, so the caller reports it rather than reconstructing it. */
function decide(where, root) {
  const what = target(where);
  const bound = granted(root ?? resolve(__dirname, ".."));

  if (!bound.held) {
    return {
      admitted: false,
      target: what,
      observed: bound.why,
      required:
        `grant the run ${GRANTED} and nothing else, since a reading bounded to one command cannot ` +
        "write, cannot reach a credential and cannot be talked into either",
    };
  }

  return {
    admitted: true,
    target: what,
    because:
      `the reading is granted ${GRANTED} and nothing else, so it holds nothing that could write and ` +
      "reaches the repository only through the perimeter",
    grant: bound.grant,
  };
}

module.exports = { decide };

if (require.main === module) {
  const where = process.argv[2] || process.cwd();
  if (!existsSync(where)) {
    process.stderr.write(`no-such-target: ${where}\n`);
    process.exit(2);
  }
  const answer = decide(where);
  process.stdout.write(`${JSON.stringify(answer, null, 2)}\n`);
  process.exit(answer.admitted ? 0 : 1);
}
