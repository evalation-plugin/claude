{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/evalation-news start" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/evalation-news prompt" },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/evalation-unanswered prompt" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/evalation-unanswered asked" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/evalation-drafts" }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/evalation-gate" }
        ]
      }
    ]
  }
}
